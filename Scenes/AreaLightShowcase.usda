#usda 1.0
(
    defaultPrim = "World"
    doc = """Akari area light showcase, a rect light and a disk light over a floor, a wall and a sphere."""
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.52)
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
        def Material "Matte"
        {
            token outputs:surface.connect = </World/Looks/Matte/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.7)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }
    def Cube "Floor" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Floor>
        double size = 1
        double3 xformOp:translate = (0, 0, -0.5)
        float3 xformOp:scale = (12, 12, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Wall" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Matte>
        double size = 1
        double3 xformOp:translate = (0, 2.0, 1.5)
        float3 xformOp:scale = (8, 0.2, 3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Sphere "Ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Matte>
        double radius = 0.35
        double3 xformOp:translate = (0, 0.6, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "Pillar" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Matte>
        double height = 1.2
        double radius = 0.12
        uniform token axis = "Z"
        double3 xformOp:translate = (-1.0, 1.0, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cone "Cone" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Matte>
        double height = 0.6
        double radius = 0.2
        uniform token axis = "Z"
        double3 xformOp:translate = (0.9, 0.9, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Capsule "Capsule" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Matte>
        double height = 0.5
        double radius = 0.12
        uniform token axis = "X"
        double3 xformOp:translate = (0.4, 0.1, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def RectLight "Softbox"
    {
        color3f inputs:color = (1, 0.92, 0.82)
        float inputs:intensity = 30
        float inputs:width = 1.6
        float inputs:height = 0.4
        double3 xformOp:translate = (-0.9, 0.2, 1.6)
        float3 xformOp:rotateXYZ = (0, -35, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def DiskLight "Spot"
    {
        color3f inputs:color = (0.6, 0.75, 1)
        float inputs:intensity = 60
        float inputs:radius = 0.15
        double3 xformOp:translate = (1.1, 0.3, 1.2)
        float3 xformOp:rotateXYZ = (0, 40, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def DomeLight "Night"
    {
        color3f inputs:color = (0.3, 0.35, 0.5)
        float inputs:intensity = 0.03
    }
    def Camera "Main"
    {
        float focalLength = 28
        float horizontalAperture = 36
        float verticalAperture = 20.25
        double3 xformOp:translate = (0, -3.2, 1.1)
        float3 xformOp:rotateXYZ = (82, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
