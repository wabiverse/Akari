    {
        matrix4d xformOp:transform = ( (0.7071067811865476, 0, -0.7071067811865475, 0), (0, 1, 0, 0), (0.7071067811865475, 0, 0.7071067811865476, 0), (-0.5188094108710463, 0.08724377721238241, -0.5237379966403376, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def "PictureFrame" (
