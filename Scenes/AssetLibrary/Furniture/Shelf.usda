#usda 1.0
(
    defaultPrim = "Shelf"
    doc = "A tall open shelf with five boards."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Shelf" (
    assetInfo = {
        dictionary akari = {
            string catalog = "Furniture"
            string placement = "floor"
        }
        asset identifier = @./Shelf.usda@
        string name = "Shelf"
        string version = "1"
    }
    kind = "component"
    variants = {
        string shadingVariant = "Pine"
    }
    prepend variantSets = "shadingVariant"
)
{
    def Scope "Looks"
    {
        def Material "Pine"
        {
            token outputs:surface.connect = </Shelf/Looks/Pine/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Shelf/Looks/Pine/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/pine.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Shelf/Looks/Pine/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Walnut"
        {
            token outputs:surface.connect = </Shelf/Looks/Walnut/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Shelf/Looks/Walnut/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/walnut.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Shelf/Looks/Walnut/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

