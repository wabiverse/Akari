#usda 1.0
(
    defaultPrim = "Sidetable"
    doc = "A small three legged side table with brass legs."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Sidetable" (
    assetInfo = {
        dictionary akari = {
            string catalog = "Furniture"
            string placement = "floor"
        }
        asset identifier = @./Sidetable.usda@
        string name = "Sidetable"
        string version = "1"
    }
    kind = "component"
    variants = {
        string shadingVariant = "Walnut"
    }
    prepend variantSets = "shadingVariant"
)
{
    def Scope "Looks"
    {
        def Material "Walnut"
        {
            token outputs:surface.connect = </Sidetable/Looks/Walnut/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Sidetable/Looks/Walnut/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/walnut.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Sidetable/Looks/Walnut/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Oak"
        {
            token outputs:surface.connect = </Sidetable/Looks/Oak/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Sidetable/Looks/Oak/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/oak.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Sidetable/Looks/Oak/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Brass"
        {
            token outputs:surface.connect = </Sidetable/Looks/Brass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.7, 0.36)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

