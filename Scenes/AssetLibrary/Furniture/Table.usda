#usda 1.0
(
    defaultPrim = "Table"
    doc = "A round pedestal table with an oak, walnut or painted top in its shadingVariant."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Table" (
    assetInfo = {
        dictionary akari = {
            string catalog = "Furniture"
            string placement = "floor"
        }
        asset identifier = @./Table.usda@
        string name = "Table"
        string version = "1"
    }
    kind = "component"
    variants = {
        string shadingVariant = "Oak"
    }
    prepend variantSets = "shadingVariant"
)
{
    def Scope "Looks"
    {
        def Material "Oak"
        {
            token outputs:surface.connect = </Table/Looks/Oak/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Table/Looks/Oak/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/oak.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Table/Looks/Oak/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Walnut"
        {
            token outputs:surface.connect = </Table/Looks/Walnut/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Table/Looks/Walnut/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/walnut.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Table/Looks/Walnut/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "PaintedTeal"
        {
            token outputs:surface.connect = </Table/Looks/PaintedTeal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.3, 0.3)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "BlackIron"
        {
            token outputs:surface.connect = </Table/Looks/BlackIron/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.06)
                float inputs:metallic = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

