#usda 1.0
(
    defaultPrim = "World"
    doc = """Akari caustic showcase, a clear glass ball, a tinted glass drop and a glass cylinder over a floor and a wall, lit by a sun and a lamp, the camera sweeping across them."""
    endTimeCode = 240
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.72)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "Wall"
        {
            token outputs:surface.connect = </World/Looks/Wall/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.2, 0.12)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "Glass"
        {
            token outputs:surface.connect = </World/Looks/Glass/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:opacity = 0.05
                float inputs:roughness = 0.02
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
        def Material "Tinted"
        {
            token outputs:surface.connect = </World/Looks/Tinted/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.8, 1.0)
                float inputs:opacity = 0.1
                float inputs:roughness = 0.02
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Floor>
        double size = 1
        double3 xformOp:translate = (0, -0.5, 0)
        float3 xformOp:scale = (20, 1, 20)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Wall" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Wall>
        double size = 1
        double3 xformOp:translate = (0, 1.5, -3)
        float3 xformOp:scale = (10, 3, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Post" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Wall>
        double size = 1
        double3 xformOp:translate = (-0.2, 0.6, -1.6)
        float3 xformOp:scale = (0.15, 1.2, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Sphere "Ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Glass>
        double radius = 0.5
        double3 xformOp:translate = (-1.0, 0.5, -0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "Drop" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Tinted>
        double radius = 0.35
        double3 xformOp:translate = (1.1, 0.35, -0.4)
        float3 xformOp:scale = (1, 1, 1.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cylinder "Glassware" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Glass>
        double radius = 0.25
        double height = 0.7
        token axis = "Y"
        double3 xformOp:translate = (0.1, 0.35, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def SphereLight "Lamp"
    {
        float inputs:intensity = 40
        float inputs:radius = 0.06
        color3f inputs:color = (1, 0.85, 0.6)
        double3 xformOp:translate = (2.2, 1.6, -1.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def DistantLight "Sun"
    {
        float inputs:intensity = 40000
        bool inputs:normalize = 0
        float3 xformOp:rotateXYZ = (-130, 20, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def DomeLight "Sky"
    {
        color3f inputs:color = (0.45, 0.55, 0.75)
        float inputs:intensity = 0.6
    }
