#usda 1.0
(
    defaultPrim = "World"
    doc = """Akari transparency, refraction, depth of field, bloom and lens flare showcase."""
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Checker"
        {
            token outputs:surface.connect = </World/Looks/Checker/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.6, 0.62)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "Red"
        {
            token outputs:surface.connect = </World/Looks/Red/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.08, 0.06)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "Glass"
        {
            token outputs:surface.connect = </World/Looks/Glass/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:opacity = 0.05
                float inputs:roughness = 0.02
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
        def Material "Stained"
        {
            token outputs:surface.connect = </World/Looks/Stained/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.35, 0.9)
                float inputs:opacity = 0.25
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }
        def Material "Latex"
        {
            token outputs:surface.connect = </World/Looks/Latex/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.2, 0.35)
                float inputs:opacity = 0.85
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
        def Material "Chrome"
        {
            token outputs:surface.connect = </World/Looks/Chrome/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.97)
                float inputs:metallic = 1
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }
        def Material "Hot"
        {
            token outputs:surface.connect = </World/Looks/Hot/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (60, 40, 30)
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Checker>
        double size = 1
        double3 xformOp:translate = (0, -0.5, -2)
        float3 xformOp:scale = (20, 1, 20)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Wall" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Red>
        double size = 1
        double3 xformOp:translate = (0, 1.5, -4)
        float3 xformOp:scale = (8, 3, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Stripe" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Chrome>
        double size = 1
        double3 xformOp:translate = (0, 1.0, -3.85)
        float3 xformOp:scale = (8, 0.15, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Sphere "Glass" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Glass>
        double radius = 0.6
        double3 xformOp:translate = (-1.6, 0.6, -1.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "StainedGlass" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Stained>
        double size = 1
        double3 xformOp:translate = (0, 0.9, -1.2)
        float3 xformOp:scale = (1.0, 1.8, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Sphere "Balloon" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Latex>
        double radius = 0.45
        double3 xformOp:translate = (1.6, 1.0, -1.5)
        float3 xformOp:scale = (1, 1.2, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Sphere "Chrome" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Chrome>
        double radius = 0.35
        double3 xformOp:translate = (0.9, 0.35, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "Emitter" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </World/Looks/Hot>
        double radius = 0.06
        double3 xformOp:translate = (-0.6, 2.4, -3.7)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def DistantLight "Sun"
    {
        float inputs:intensity = 3
        bool inputs:normalize = 1
        float3 xformOp:rotateXYZ = (-35, 25, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def DomeLight "Sky"
    {
        color3f inputs:color = (0.45, 0.55, 0.75)
    }
    def Camera "Lens"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float fStop = 1.8
        float focusDistance = 4.5
        float akari:bloom = 0.05
        float akari:streak = 0.03
        float akari:flare = 0.02
        double3 xformOp:translate = (0, 1.2, 3)
        float3 xformOp:rotateXYZ = (-5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Camera "Portrait"
    {
        float focalLength = 85
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float fStop = 1.4
        float focusDistance = 4.8
        float akari:bloom = 0.05
        float akari:streak = 0.03
        float akari:flare = 0.02
        double3 xformOp:translate = (0, 1.2, 3)
        float3 xformOp:rotateXYZ = (-6, 18, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Camera "Anamorphic"
    {
        float focalLength = 32
        float horizontalAperture = 36
        float verticalAperture = 15.07
        float akari:bloom = 0.04
        float akari:streak = 0.25
        float akari:flare = 0.06
        double3 xformOp:translate = (0, 1.2, 3)
        float3 xformOp:rotateXYZ = (4, -8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Camera "Pinhole"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float akari:bloom = 0
        double3 xformOp:translate = (0, 1.2, 3)
        float3 xformOp:rotateXYZ = (-5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
