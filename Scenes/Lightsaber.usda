        }

        def Material "Black"
        {
            token outputs:ri:surface.connect = </saber/Looks/Black/PxrSurface.outputs:out>
            token outputs:surface.connect = </saber/Looks/Black/PreviewSurface.outputs:surface>

            def Shader "PxrSurface"
            {
