#usda 1.0
(
    defaultPrim = "World"
    doc = """Akari motion blur showcase, a spinning blade and a passing cube under a 180 degree shutter."""
    endTimeCode = 24
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.18, 0.2)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "Blade"
        {
            token outputs:surface.connect = </World/Looks/Blade/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.3, 0.5)
                color3f inputs:emissiveColor = (8, 2, 4)
                token outputs:surface
            }
        }
        def Material "Box"
        {
            token outputs:surface.connect = </World/Looks/Box/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.5, 0.9)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Floor>
        double size = 1
        double3 xformOp:translate = (0, -0.5, 0)
        float3 xformOp:scale = (20, 1, 20)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Spinner"
    {
        double3 xformOp:translate = (-1.2, 1.2, 0)
        float xformOp:rotateZ.timeSamples = {
            1: 0,
            24: 720,
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Cube "Blade" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/Blade>
            double size = 1
            float3 xformOp:scale = (2, 0.08, 0.08)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Cube "Passer" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Box>
        double size = 0.6
        double3 xformOp:translate.timeSamples = {
            1: (-4, 0.3, 1),
            24: (4, 0.3, 1),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 3
        bool inputs:normalize = 1
        float3 xformOp:rotateXYZ = (-50, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "Shutter180"
    {
        float focalLength = 30
        float horizontalAperture = 36
        float verticalAperture = 20.25
        double shutter:open = -0.25
        double shutter:close = 0.25
        double3 xformOp:translate = (0, 1.4, 6)
        float3 xformOp:rotateXYZ = (-6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "NoShutter"
    {
        float focalLength = 30
        float horizontalAperture = 36
        float verticalAperture = 20.25
        double3 xformOp:translate = (0, 1.4, 6)
        float3 xformOp:rotateXYZ = (-6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
