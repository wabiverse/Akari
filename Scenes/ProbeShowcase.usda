#usda 1.0
(
    defaultPrim = "World"
    doc = """Akari light probe showcase: a rounded cube loops through a room lit by pink and a blue sphere lights."""
    endTimeCode = 240
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.6, 0.58)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
        def Material "Wall"
        {
            token outputs:surface.connect = </World/Looks/Wall/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.77, 0.75)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }
        def Material "Plinth"
        {
            token outputs:surface.connect = </World/Looks/Plinth/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "Chrome"
        {
            token outputs:surface.connect = </World/Looks/Chrome/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.97)
                float inputs:metallic = 1
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }
        def Material "Cube"
        {
            token outputs:surface.connect = </World/Looks/Cube/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }
    }

