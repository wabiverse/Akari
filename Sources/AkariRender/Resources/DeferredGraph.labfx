buffer: transparentAccum
  has depth: yes
  textures:
    [ tColor, f16x4, scale: 1.0
      tReflect, f16x4, scale: 1.0
      tTransmit, f16x4, scale: 1.0
      tOffset, f16x4, scale: 1.0
      tDepth, f16x4, scale: 1.0
      tVelocity, f16x4, scale: 1.0 ]

buffer: transparentResolved
  has depth: no
  textures:
    [ tResolved, f16x4, scale: 1.0
      tSurface, f16x4, scale: 1.0 ]

buffer: atmosTransmittance
  has depth: no
  textures:
    size: [256 64]
    [ atmosTransmittance, f16x4 ]

buffer: atmosMultiScatter
  has depth: no
  textures:
    size: [32 32]
    [ atmosMultiScatter, f16x4
      atmosIrradiance, f16x4 ]

buffer: atmosSkyView
  has depth: no
  textures:
    size: [192 108]
    [ atmosSkyView, f16x4 ]

buffer: planetCloudMap
  has depth: no
  textures:
    size: [4096 2048]
    [ planetCloudMap, f16x1 ]

buffer: atmosAerial
  has depth: no
  textures:
    size: [256 128]
    [ atmosAerial, f16x4 ]

pass: clear gbuffer
  draw: no
  clear depth: yes
  clear outputs: yes
  outputs: gbuffer [diffuse, position, normal, material, velocity, ptexA, ptexB]

pass: atmosphere transmittance
  draw: quad
  depth test: never
  write depth: no
  use shader: atmosphere-transmittance
  outputs: atmosTransmittance [ atmosTransmittance ]

pass: atmosphere multiscatter
  draw: quad
  depth test: never
  write depth: no
  use shader: atmosphere-multiscatter
  inputs: [atmosTransmittance.atmosTransmittance]
  outputs: atmosMultiScatter [ atmosMultiScatter, atmosIrradiance ]

pass: atmosphere sky view
  draw: quad
  depth test: never
  write depth: no
  use shader: atmosphere-sky-view
  inputs: [atmosTransmittance.atmosTransmittance, atmosMultiScatter.atmosMultiScatter]
  outputs: atmosSkyView [ atmosSkyView ]

pass: atmosphere aerial
  draw: quad
  depth test: never
  write depth: no
  use shader: atmosphere-aerial
  inputs: [atmosTransmittance.atmosTransmittance, atmosMultiScatter.atmosMultiScatter]
  outputs: atmosAerial [ atmosAerial ]

pass: dome
  draw: compute
  use shader: dome-sky
  dispatch: [ 16, 16, 6 ]
  threadgroup: [ 16, 16, 1 ]
  inputs: [dome.dome]
  outputs: envCube [ envCube ]

pass: planet cloud map
  draw: quad
  depth test: never
  write depth: no
  use shader: planet-cloud-map
  outputs: planetCloudMap [ planetCloudMap ]

pass: atmosphere env
  draw: compute
  use shader: atmosphere-env
  dispatch: [ 16, 16, 6 ]
  threadgroup: [ 16, 16, 1 ]
  inputs: [dome.dome, atmosTransmittance.atmosTransmittance, atmosMultiScatter.atmosMultiScatter,
           atmosMultiScatter.atmosIrradiance, atmosSkyView.atmosSkyView, planetCloudMap.planetCloudMap]
  outputs: envCube [ envCube ]

pass: sky
  draw: compute
  use shader: hosek-wilkie
  dispatch: [ 64, 64, 6 ]
  threadgroup: [ 16, 16, 1 ]
  outputs: envCube [ envCube ]

pass: geometry
  draw: opaque geometry
  clear depth: no
  depth test: greater
  write depth: yes
  use shader: mesh-static
  outputs: gbuffer [diffuse, position, normal, material, velocity, ptexA, ptexB]

pass: geometry instanced
  callback: draw-static-instanced-geometry
  clear depth: no
  depth test: greater
  write depth: yes
  use shader: mesh-static
  outputs: gbuffer [diffuse, position, normal, material, velocity, ptexA, ptexB]

pass: geometry dynamic
  callback: draw-dynamic-geometry
  clear depth: no
  depth test: greater
  write depth: yes
  use shader: mesh
  outputs: gbuffer [diffuse, position, normal, material, velocity, ptexA, ptexB]

pass: ssgi prep
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi-prep
  inputs: [gbuffer.position, gbuffer.normal, gbuffer.material, history.history]
  outputs: ssgiPrep [ssgiDepth, ssgiNormal, ssgiRadiance]

pass: ssgi pyramid
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi-pyramid
  inputs: [ssgiPrep.ssgiDepth, ssgiPrep.ssgiNormal, ssgiPrep.ssgiRadiance]
  outputs: ssgiPyramid [ssgiPyramidDepth, ssgiPyramidNormal, ssgiPyramidRadiance]

pass: ssgi
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi
  inputs: [ssgiPrep.ssgiDepth, ssgiPrep.ssgiNormal, ssgiPrep.ssgiRadiance,
           ssgiPyramid.ssgiPyramidDepth, ssgiPyramid.ssgiPyramidNormal, ssgiPyramid.ssgiPyramidRadiance]
  outputs: ssgi [ ssgiRaw, ssgiSpecRaw ]

pass: ssgi temporal
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi-temporal
  inputs: [ssgi.ssgiRaw, ssgi.ssgiSpecRaw, ssgiHistory.ssgiHistory, ssgiHistory.ssgiSpecHistory,
           ssgiPrep.ssgiDepth, ssgiPrep.ssgiNormal]
  outputs: ssgiAccum [ ssgiAccum, ssgiSpecAccum ]

pass: ssgi history
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi-copy
  inputs: [ssgiAccum.ssgiAccum, ssgiAccum.ssgiSpecAccum]
  outputs: ssgiHistory [ ssgiHistory, ssgiSpecHistory ]

pass: volume scatter
  draw: quad
  depth test: never
  write depth: no
  use shader: volume-scatter
  inputs: [envCube.envCube, irradiance.irradiance]
  outputs: volumeScatter [ volumeScatter ]

pass: volume integrate
  callback: volume-integrate

pass: ssr
  draw: quad
  depth test: never
  write depth: no
  use shader: ssr
  inputs: [gbuffer.position, gbuffer.normal, gbuffer.material, history.history, ssgiPrep.ssgiDepth]
  outputs: ssr [ssrRadiance, ssrGuide]

pass: ssr temporal
  draw: quad
  depth test: never
  write depth: no
  use shader: ssr-temporal
  inputs: [ssr.ssrRadiance, ssr.ssrGuide, ssrHistory.ssrHistory, gbuffer.position, gbuffer.material]
  outputs: ssrAccum [ ssrAccum ]

pass: ssr history
  draw: quad
  depth test: never
  write depth: no
  use shader: ssr-copy
  inputs: [ssrAccum.ssrAccum]
  outputs: ssrHistory [ ssrHistory ]

pass: point shadows
  draw: quad
  depth test: never
  write depth: no
  use shader: point-shadow
  inputs: [gbuffer.position, gbuffer.normal]
  outputs: pointShadowRaw [pointShadowRaw0, pointShadowRaw1, pointShadowRaw2, pointShadowRaw3, pointShadowGuide]

pass: point shadow blur h
  draw: quad
  depth test: never
  write depth: no
  use shader: point-shadow-blur-h
  inputs: [pointShadowRaw.pointShadowRaw0, pointShadowRaw.pointShadowRaw1, pointShadowRaw.pointShadowRaw2,
           pointShadowRaw.pointShadowRaw3, pointShadowRaw.pointShadowGuide]
  outputs: pointShadowBlur [pointShadowBlur0, pointShadowBlur1, pointShadowBlur2, pointShadowBlur3]

pass: point shadow blur v
  draw: quad
  depth test: never
  write depth: no
  use shader: point-shadow-blur-v
  inputs: [pointShadowBlur.pointShadowBlur0, pointShadowBlur.pointShadowBlur1, pointShadowBlur.pointShadowBlur2,
           pointShadowBlur.pointShadowBlur3, pointShadowRaw.pointShadowGuide]
  outputs: pointShadow [pointShadow0, pointShadow1, pointShadow2, pointShadow3]

pass: resolve
  draw: quad
  depth test: never
  write depth: no
  use shader: deferred-shade
  inputs: [gbuffer.diffuse, gbuffer.position, gbuffer.normal, gbuffer.material,
           envCube.envCube, prefiltered.prefiltered,
           irradiance.irradiance, dfg.dfg, ssgiAccum.ssgiAccum, ssgiAccum.ssgiSpecAccum,
           ssgiPrep.ssgiDepth, ssgiPrep.ssgiNormal, volumeIntegrated.volumeIntegrated,
           pointShadow.pointShadow0, pointShadow.pointShadow1, pointShadow.pointShadow2,
           pointShadow.pointShadow3, pointShadowRaw.pointShadowGuide,
           ssrAccum.ssrAccum, ssr.ssrGuide,
           atmosTransmittance.atmosTransmittance, atmosAerial.atmosAerial, planetCloudMap.planetCloudMap]
  outputs: color [ final ]

pass: atmosphere background
  draw: quad
  depth test: never
  write depth: no
  blend: alpha
  use shader: atmosphere-background
  inputs: [gbuffer.normal, atmosTransmittance.atmosTransmittance, atmosMultiScatter.atmosMultiScatter,
           atmosMultiScatter.atmosIrradiance, atmosSkyView.atmosSkyView, volumeIntegrated.volumeIntegrated,
           planetCloudMap.planetCloudMap]
  outputs: color [ final ]

pass: volume shadow
  draw: quad
  depth test: never
  write depth: no
  use shader: volume-shadow
  outputs: volumeShadow [ volumeShadow ]

pass: volume march
  draw: quad
  depth test: never
  write depth: no
  blend: alpha
  use shader: volume-march
  inputs: [gbuffer.position, gbuffer.normal, volumeShadow.volumeShadow, irradiance.irradiance, atmosAerial.atmosAerial]
  outputs: color [ final ]

pass: fog sim march
  draw: quad
  clear depth: no
  clear outputs: yes
  depth test: never
  write depth: no
  use shader: fog-sim-march
  inputs: [gbuffer.position, gbuffer.normal, volumeScatter.volumeScatter]
  outputs: fogSimHalf [ fogSimHalf ]

pass: fog sim composite
  draw: quad
  depth test: never
  write depth: no
  blend: alpha
  use shader: fog-sim-composite
  inputs: [gbuffer.position, gbuffer.normal, fogSimHalf.fogSimHalf]
  outputs: color [ final ]

pass: transparent clear
  draw: no
  clear depth: yes
  clear outputs: yes
  outputs: transparentAccum [tColor, tReflect, tTransmit, tOffset, tDepth, tVelocity]

pass: transparent
  callback: draw-dynamic-geometry
  depth test: always
  write depth: no
  blend: additive
  use shader: mesh-transparent
  inputs: [gbuffer.position, gbuffer.normal, prefiltered.prefiltered, irradiance.irradiance]
  outputs: transparentAccum [tColor, tReflect, tTransmit, tOffset, tDepth, tVelocity]

pass: transparent composite
  draw: quad
  depth test: never
  write depth: no
  use shader: transparent-composite
  inputs: [color.final, transparentAccum.tColor, transparentAccum.tReflect, transparentAccum.tTransmit, transparentAccum.tOffset,
           transparentAccum.tDepth, gbuffer.position, gbuffer.normal, prefiltered.prefiltered]
  outputs: transparentResolved [ tResolved, tSurface ]

pass: transparent apply
  draw: quad
  depth test: never
  write depth: no
  use shader: taa-copy-transparent
  inputs: [transparentResolved.tResolved]
  outputs: color [ final ]

pass: upscale sanitize
  draw: quad
  depth test: never
  write depth: no
  use shader: upscale-sanitize
  inputs: [color.final, gbuffer.position, gbuffer.normal, gbuffer.velocity]
  outputs: upscaleInput [ upscaleColor, upscaleVelocity ]

pass: motion tiles pre 8
  draw: quad
  depth test: never
  write depth: no
  use shader: motion-tile-8
  inputs: [gbuffer.velocity, gbuffer.normal, transparentAccum.tVelocity]
  outputs: motionTiles8 [ motionTile8 ]

pass: motion tiles pre
  draw: quad
  depth test: never
  write depth: no
  use shader: motion-tile-max
  inputs: [motionTiles8.motionTile8]
  outputs: motionTiles [ motionTileMax ]

pass: motion neighbors pre
  draw: quad
  depth test: never
  write depth: no
  use shader: motion-neighbor-max
  inputs: [motionTiles.motionTileMax]
  outputs: motionNeighbors [ motionNeighborMax ]

pass: motion blur pre
  draw: quad
  depth test: never
  write depth: no
  use shader: motion-blur
  inputs: [color.final, gbuffer.velocity, gbuffer.normal, gbuffer.position, motionNeighbors.motionNeighborMax,
           transparentAccum.tVelocity]
  outputs: motionBlur [ motionBlurred ]

pass: motion blur pre apply
  draw: quad
  depth test: never
  write depth: no
  use shader: taa-copy-blurred
  inputs: [motionBlur.motionBlurred]
  outputs: color [ final ]

pass: taa
  draw: quad
  depth test: never
  write depth: no
  use shader: taa
  inputs: [color.final, history.history, gbuffer.position, gbuffer.normal, gbuffer.velocity]
  outputs: taa [ final ]

pass: upscale
  callback: metalfx-upscale
  depth test: never
  write depth: no
  outputs: taa [ final ]

pass: upscale supersample
  callback: metalfx-upscale
  depth test: never
  write depth: no
  outputs: supersample [ supersample ]

pass: downsample
  draw: quad
  depth test: never
  write depth: no
  use shader: supersample-downsample
  inputs: [supersample.supersample]
  outputs: taa [ final ]

pass: taa history
  draw: quad
  depth test: never
  write depth: no
  use shader: taa-copy
  inputs: [taa.final]
  outputs: history [ history ]

pass: depth of field depth
  draw: quad
  depth test: never
  write depth: no
  use shader: dof-depth
  inputs: [taa.final, gbuffer.position, gbuffer.normal, transparentResolved.tSurface]
  outputs: dofDepth [ dofDepth ]

pass: depth of field tiles 8
  draw: quad
  depth test: never
  write depth: no
  use shader: dof-tile-coc
  inputs: [dofDepth.dofDepth]
  outputs: dofTiles8 [ dofTile8 ]

pass: depth of field tiles
  draw: quad
  depth test: never
  write depth: no
  use shader: dof-tile-max
  inputs: [dofTiles8.dofTile8]
  outputs: dofTiles [ dofTileMax ]

pass: depth of field neighbors
  draw: quad
  depth test: never
  write depth: no
  use shader: dof-neighbor-max
  inputs: [dofTiles.dofTileMax]
  outputs: dofNeighbors [ dofNeighborMax ]

pass: depth of field downsample
  draw: quad
  depth test: never
  write depth: no
  use shader: dof-downsample
  inputs: [taa.final, dofDepth.dofDepth]
  outputs: dofHalfSource [ dofHalfSource ]

pass: depth of field half
  draw: quad
  depth test: never
  write depth: no
  use shader: dof-gather-half
  inputs: [dofHalfSource.dofHalfSource, dofNeighbors.dofNeighborMax]
  outputs: dofHalf [ dofHalfColor ]

pass: depth of field
  draw: quad
  depth test: never
  write depth: no
  use shader: dof-gather
  inputs: [taa.final, dofDepth.dofDepth, dofNeighbors.dofNeighborMax, dofHalf.dofHalfColor]
  outputs: dof [ dofColor ]

pass: depth of field apply
  draw: quad
  depth test: never
  write depth: no
  use shader: taa-copy-dof
  inputs: [dof.dofColor]
  outputs: taa [ final ]

pass: motion tiles 8
  draw: quad
  depth test: never
  write depth: no
  use shader: motion-tile-8
  inputs: [gbuffer.velocity, gbuffer.normal, transparentAccum.tVelocity]
  outputs: motionTiles8 [ motionTile8 ]

pass: motion tiles
  draw: quad
  depth test: never
  write depth: no
  use shader: motion-tile-max
  inputs: [motionTiles8.motionTile8]
  outputs: motionTiles [ motionTileMax ]

pass: motion neighbors
  draw: quad
  depth test: never
  write depth: no
  use shader: motion-neighbor-max
  inputs: [motionTiles.motionTileMax]
  outputs: motionNeighbors [ motionNeighborMax ]

pass: motion blur
  draw: quad
  depth test: never
  write depth: no
  use shader: motion-blur
  inputs: [taa.final, gbuffer.velocity, gbuffer.normal, gbuffer.position, motionNeighbors.motionNeighborMax,
