  fsh:
    source:
    ```glsl
    //@include Post.glsl
    void main()
    {
      o_dofHalfColor_texture = vec4(0.0);
    }
    ```

    source msl:
    ```msl
    //@include Post.msl
    //@main
    {
      float2 pixel = floor(gl_FragCoord.xy);
      float3 tile = u_dofNeighborMax_texture.read(uint2((pixel * 2.0 + 1.0) / 48.0)).rgb;
      o_dofHalfColor_texture = float4(0.0);
      if (max(tile.r, tile.b) >= 4.0) {
        o_dofHalfColor_texture = float4(postBokehHalf(u_dofHalfSource_texture, pixel, u_dof, tile.b, u_dofSampling.x), 1.0);
      }
    }
    ```

shader: dof-gather
  uniforms: [ u_final_texture: sampler2d,
              u_dofDepth_texture: sampler2d,
              u_dofNeighborMax_texture: sampler2d,
              u_dofHalfColor_texture: sampler2d,
              u_dof: vec4 ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    //@include Post.glsl
    void main()
    {
      o_dofColor_texture = texelFetch(u_final_texture, ivec2(gl_FragCoord.xy), 0);
    }
    ```

    source msl:
    ```msl
    //@include Post.msl
    //@main
    {
      float2 pixel = floor(gl_FragCoord.xy);
      float near = u_dofNeighborMax_texture.read(uint2(pixel / 48.0)).b;
      float z = u_dofDepth_texture.read(uint2(pixel)).r;
      // blurred pixels take the half resolution gather, in focus ones their own, crossfading between.
      float w = smoothstep(4.0, 8.0, postCoc(z, u_dof));
      float3 c = float3(0.0);
      if (w < 1.0) {
        c = postBokeh(u_final_texture, u_final_texture_smp, u_dofDepth_texture, pixel + 0.5, u_dof, near, 1.0, 1.5);
      }
      if (w > 0.0) {
        c = mix(c, postUpsampleDepthAware(u_dofHalfColor_texture, u_dofDepth_texture, pixel, z), w);
      }
      o_dofColor_texture = float4(c, 1.0);
    }
    ```

