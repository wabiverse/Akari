shader: bloom-down-0
  uniforms: [ u_bloomFilter: vec4,
              u_final_texture: sampler2d ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    //@include Post.glsl
    void main()
    {
      o_bloomDown0_texture = texture(u_final_texture, var.texCoord);
    }
    ```

    source msl:
    ```msl
    //@include Post.msl
    //@main
    {
      float3 c = min(postDownsample(u_final_texture, u_final_texture_smp, var.texCoord, true), float3(u_bloomFilter.z));
      float bright = max(c.r, max(c.g, c.b));
      float knee = u_bloomFilter.x * u_bloomFilter.y + 1e-5;
      float soft = clamp(bright - u_bloomFilter.x + knee, 0.0, 2.0 * knee);
      c *= max(soft * soft / (4.0 * knee), bright - u_bloomFilter.x) / max(bright, 1e-5);
      o_bloomDown0_texture = float4(c, 1.0);
    }
    ```

