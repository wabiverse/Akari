              u_ptexParams: ivec4,
              u_prevViewProj: mat4, u_currViewProj: mat4, u_eyeToWorld: mat4, frameIndex: int ]
  varying:  [ posEye: vec3, normalEye: vec3, uv: vec2, primId: float, prevClip: vec4, vcolor: vec3,
              ptexBase: int ]

