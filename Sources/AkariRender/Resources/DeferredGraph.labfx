  has depth: no
  textures:
    [ dofTile8, f16x4, scale: 1.0 ]

buffer: dofTiles
  has depth: no
  textures:
    [ dofTileMax, f16x4, scale: 1.0 ]

buffer: dofNeighbors
  has depth: no
  textures:
    [ dofNeighborMax, f16x4, scale: 1.0 ]

