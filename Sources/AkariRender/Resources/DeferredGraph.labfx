    int2 size = int2(u_motionTileMax_texture.get_width(), u_motionTileMax_texture.get_height());
    int2 c = int2(gl_FragCoord.xy);
    float2 best = float2(0.0);
    for (int y = -1; y <= 1; ++y) {
      for (int x = -1; x <= 1; ++x) {
        float2 v = u_motionTileMax_texture.read(uint2(clamp(c + int2(x, y), int2(0), size - 1))).xy;
        if (dot(v, v) > dot(best, best)) best = v;
      }
    }
    o_motionNeighborMax_texture = float4(best, length(best), 0.0);
    ```

shader: motion-blur
  uniforms: [ u_tVelocity_texture: sampler2d,
              u_final_texture: sampler2d,
              u_velocity_texture: sampler2d,
              u_normal_texture: sampler2d,
              u_position_texture: sampler2d,
              u_motionNeighborMax_texture: sampler2d,
              u_view: mat4 <- auto-view-matrix,
              u_invProj: mat4,
              u_prevViewProj: mat4,
              u_currViewProj: mat4,
              u_motionBlur: vec4,
              u_motionSize: vec4,
              frameIndex: int ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
