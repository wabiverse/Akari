--- labfx version 1.0

name: Akari LabGL
version: 1.0

buffer: gbuffer
  has depth: yes
  textures:
    [ diffuse, f16x4, scale: 1.0
      position, f32x4, scale: 1.0
      normal, f16x4, scale: 1.0
      material, f16x4, scale: 1.0
      velocity, f16x2, scale: 1.0
      ptexA, i32x1, scale: 1.0
      ptexB, i32x1, scale: 1.0 ]

buffer: envCube
  textures:
    has mips: yes
    has depth: no
    size: [256 256]
    cube: yes
    [ envCube, f16x4, scale: 1.0 ]

buffer: dome
  textures:
    has mips: no
    has depth: no
    size: [1024 512]
    [ dome, f16x4, scale: 1.0 ]

buffer: color
  has depth: no
  textures:
    [ final, f16x4, scale: 1.0 ]

buffer: ssgiPrep
  has depth: no
  textures:
    [ ssgiDepth, f32x1, scale: 0.5
      ssgiNormal, f16x4, scale: 0.5
      ssgiRadiance, f16x4, scale: 0.5 ]

buffer: ssgiPyramid
  has depth: no
  textures:
    [ ssgiPyramidDepth, f32x1, scale: 0.5
      ssgiPyramidNormal, f16x4, scale: 0.5
      ssgiPyramidRadiance, f16x4, scale: 0.5 ]

buffer: ssgi
  has depth: no
  textures:
    [ ssgiRaw, f16x4, scale: 0.5
      ssgiSpecRaw, f16x4, scale: 0.5 ]

buffer: ssgiAccum
  has depth: no
  textures:
    [ ssgiAccum, f16x4, scale: 0.5
      ssgiSpecAccum, f16x4, scale: 0.5 ]

buffer: ssgiHistory
  has depth: no
  latency: ring 2
  textures:
    [ ssgiHistory, f16x4, scale: 0.5
      ssgiSpecHistory, f16x4, scale: 0.5 ]

buffer: pointShadowRaw
  has depth: no
  textures:
    [ pointShadowRaw0, f16x4, scale: 0.5
      pointShadowRaw1, f16x4, scale: 0.5
      pointShadowRaw2, f16x4, scale: 0.5
      pointShadowRaw3, f16x4, scale: 0.5
      pointShadowGuide, f16x4, scale: 0.5 ]

buffer: pointShadowBlur
  has depth: no
  textures:
    [ pointShadowBlur0, f16x4, scale: 0.5
      pointShadowBlur1, f16x4, scale: 0.5
      pointShadowBlur2, f16x4, scale: 0.5
      pointShadowBlur3, f16x4, scale: 0.5 ]

buffer: pointShadow
  has depth: no
  textures:
    [ pointShadow0, f16x4, scale: 0.5
      pointShadow1, f16x4, scale: 0.5
      pointShadow2, f16x4, scale: 0.5
      pointShadow3, f16x4, scale: 0.5 ]

buffer: volumeScatter
  has depth: no
  textures:
    [ volumeScatter, f16x4, scale: 0.5 ]

buffer: volumeIntegrated
  has depth: no
  textures:
    [ volumeIntegrated, f16x4, scale: 0.5 ]

buffer: ssr
  has depth: no
  textures:
    [ ssrRadiance, f16x4, scale: 0.5
      ssrGuide, f16x4, scale: 0.5 ]

buffer: ssrAccum
  has depth: no
  textures:
    [ ssrAccum, f16x4, scale: 0.5 ]

buffer: ssrHistory
  has depth: no
  latency: ring 2
  textures:
    [ ssrHistory, f16x4, scale: 0.5 ]

buffer: taa
  has depth: no
  textures:
