  fsh:
    source:
    ```glsl
    const float PI = 3.14159265358979;
    const float LIGHT_INTENSITY = 3.0;
    const float MOON_INTENSITY = 0.12;

    vec3 toSkySpace(vec3 v)
    {
      return mix(v, vec3(v.x, v.z, -v.y), u_zUp);
    }

    float phaseHG(float cosTheta, float g)
    {
      float d = 1.0 + g * g - 2.0 * g * cosTheta;
      return (1.0 - g * g) / (4.0 * PI * d * sqrt(d));
    }

    float frustumExitDistance(vec3 posEye, vec3 dirEye)
    {
      vec4 c = u_proj * vec4(posEye, 1.0);
      vec4 d = u_proj * vec4(dirEye, 0.0);
      vec3 a0 = c.www - c.xyz, b0 = d.www - d.xyz;
      vec3 a1 = c.www + c.xyz, b1 = d.www + d.xyz;
      float t = 1e20;
      for (int i = 0; i < 3; ++i) {
        if (b0[i] < 0.0) t = min(t, max(a0[i], 0.0) / -b0[i]);
        if (b1[i] < 0.0) t = min(t, max(a1[i], 0.0) / -b1[i]);
      }
      return t;
    }

    float volumeTransmittance(float distance)
    {
      return u_volume.w > 0.5 ? exp(-u_volume.x * distance) : 1.0;
    }

    vec3 volumeWorldLight(vec3 rayDir)
    {
      vec3 ahead = texture(u_irradiance_texture, toSkySpace(rayDir)).rgb;
      vec3 behind = texture(u_irradiance_texture, toSkySpace(-rayDir)).rgb;
      return max(0.5 * (ahead + behind) + 0.75 * u_volume.y * (ahead - behind), vec3(0.0)) * u_iblEnabled;
    }

    float volumeSunShadow(vec3 posEye)
    {
      if (u_shadowEnabled < 0.5) return 1.0;
      vec3 lightRel = (u_eyeToLightRotation * vec4(posEye, 0.0)).xyz;
      vec3 delta = lightRel - u_directionalRefOffset.xyz;
      int lodMin = int(u_shadowLodRange.x);
      float lod = u_shadowLodRange.z > 0.5
        ? log2(length(delta) * (32.0 / (32.0 - 1.0001)) * 2.0)
        : length(delta.xy) * (32.0 / (32.0 - 2.5001)) / exp2(float(lodMin - 1)) + float(lodMin - 1);
      int levelCount = int(u_shadowLevelCount);
      int first = clamp(int(ceil(lod + u_shadowLodRange.w)), lodMin, int(u_shadowLodRange.y)) - lodMin;
      for (int i = max(min(first + int(u_volumeSunLevelBias), levelCount - 1), 0); i < levelCount; ++i) {
        vec4 slotOffset = texelFetch(u_shadow_data, ivec2(4, 24 + i), 0);
        float radius = exp2(u_shadowLodRange.x + float(i)) * 0.5;
        vec2 tileFloat = ((lightRel.xy + slotOffset.yz) / radius * 0.5 + 0.5) * 32.0;
        if (any(lessThan(tileFloat, vec2(0.0))) || any(greaterThanEqual(tileFloat, vec2(32.0)))) continue;
        ivec2 tile = ivec2(tileFloat);
        vec4 page = texelFetch(u_shadow_pagetable, ivec2(tile.y * 32 + tile.x, int(slotOffset.x)), 0);
        if (page.z < 0.5) continue;
        vec3 levelDepth = texelFetch(u_shadow_data, ivec2(5, 24 + i), 0).xyz;
        float compareDepth = ((lightRel.z + levelDepth.x) * levelDepth.y + levelDepth.z) * 0.5 + 0.5 - u_shadowBias.x;
        vec2 frac = fract(tileFloat);
        uint v = texelFetch(u_shadow_atlas, ivec3(int(page.y) * 256 + int(frac.x * 256.0),
                                                  int(frac.y * 256.0), int(page.x)), 0).r;
        return v == 0xFFFFFFFFu || compareDepth <= uintBitsToFloat(v) ? 1.0 : 0.0;
      }
      return 1.0;
    }

    float volumePointShadow(int lightIdx, vec3 lL, int startLod)
    {
      if (u_punctualShadowEnabled < 0.5) return 1.0;
      vec3 aL = abs(lL);
      int face = aL.x > aL.y && aL.x > aL.z ? (lL.x > 0.0 ? 1 : 2)
               : aL.y > aL.x && aL.y > aL.z ? (lL.y > 0.0 ? 3 : 4) : (lL.z > 0.0 ? 5 : 0);
      vec3 fL = lL;
      if (face == 1) fL = vec3(-lL.y, lL.z, -lL.x);
      else if (face == 2) fL = vec3(lL.y, lL.z, lL.x);
      else if (face == 3) fL = vec3(lL.x, lL.z, -lL.y);
      else if (face == 4) fL = vec3(-lL.x, lL.z, lL.y);
      else if (face == 5) fL = vec3(lL.x, -lL.y, -lL.z);
      float z = max(abs(fL.z), 1e-6);
      int tilemapIndex = lightIdx * 6 + face;
      vec2 nearFar = texelFetch(u_shadow_data, ivec2(5, tilemapIndex), 0).xy;
      vec2 uv = clamp(fL.xy / z * 0.5 + 0.5, 0.0, 0.999999);
      for (int i = 0; i <= 5; ++i) {
        int lod = i <= startLod ? startLod - i : i;
        int size = 32 >> lod;
        int base = (4096 - (4096 >> (2 * lod))) / 3;
        vec2 tileFloat = uv * float(size);
        ivec2 tile = ivec2(tileFloat);
        vec4 page = texelFetch(u_shadow_pagetable, ivec2(base + tile.y * size + tile.x, tilemapIndex), 0);
        if (page.z < 0.5) continue;
        float zb = max(z - 4.0 * z / float(size * 256), nearFar.x);
        float tapDepth = nearFar.y * (zb - nearFar.x) / ((nearFar.y - nearFar.x) * zb);
        vec2 frac = tileFloat - vec2(tile);
        uint v = texelFetch(u_shadow_atlas, ivec3(int(page.y) * 256 + int(frac.x * 256.0),
                                                  int(frac.y * 256.0), int(page.x)), 0).r;
        return v == 0xFFFFFFFFu || tapDepth <= uintBitsToFloat(v) ? 1.0 : 0.0;
      }
      return 1.0;
    }

    vec3 froxelEye(vec2 uv, float t)
    {
      vec4 e = u_invProj * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
      vec3 dirEye = e.xyz / e.w;
      return dirEye * (mix(u_volumeRange.x, u_volumeRange.y, t * t) / max(-dirEye.z, 1e-6));
    }

    vec4 volumeHistory(vec3 worldPos, ivec2 grid)
    {
      vec4 c = u_volumePrevViewProj * vec4(worldPos, 1.0);
      if (u_volumeHistory < 0.5 || c.w <= u_volumeRange.x) return vec4(0.0);
      vec3 f = vec3((c.xy / c.w * 0.5 + 0.5) * vec2(grid),
                    sqrt((c.w - u_volumeRange.x) / (u_volumeRange.y - u_volumeRange.x)) * 64.0) - 0.5;
      if (any(lessThan(f, vec3(-0.5))) || any(greaterThan(f, vec3(vec2(grid), 64.0) - 0.5))) return vec4(0.0);
      ivec3 i0 = ivec3(floor(f));
      vec3 w = f - vec3(i0);
      vec4 sum = vec4(0.0);
      for (int k = 0; k < 8; ++k) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, k >> 2);
        ivec3 p = clamp(i0 + o, ivec3(0), ivec3(grid - 1, 63));
        vec4 v = texelFetch(u_froxelHistory, ivec2(p.z % 8, p.z / 8) * grid + p.xy, 0);
        vec3 ow = mix(1.0 - w, w, vec3(o));
        sum += vec4(v.rgb, 1.0) * (ow.x * ow.y * ow.z * step(v.a, 1.0));
      }
      return sum;
    }

    void main()
    {
      ivec2 a = ivec2(gl_FragCoord.xy);
      ivec2 grid = ivec2(u_volumeRange.zw);
      ivec2 sliceXY = a / max(grid, ivec2(1));
      int s = sliceXY.y * 8 + sliceXY.x;
      if (u_volume.z < 0.5 || sliceXY.x >= 8 || s >= 64) {
        o_volumeScatter_texture = vec4(0.0, 0.0, 0.0, 1.0);
        return;
      }
      ivec2 froxel = a - sliceXY * grid;
      float t0 = float(s) / 64.0, t1 = float(s + 1) / 64.0;
      if (mix(u_volumeRange.x, u_volumeRange.y, t0 * t0) > texelFetch(u_froxelDepth, froxel, 0).x) {
        o_volumeScatter_texture = vec4(0.0, 0.0, 0.0, 2.0);
        return;
      }
      float noise = fract(52.9829189 * fract(dot(vec2(a), vec2(0.06711056, 0.00583715))));
      vec3 jitter = fract(float(frameIndex % 64) * vec3(0.7548777, 0.5698403, 0.6180340) + noise);
      vec3 posEye = froxelEye((vec2(froxel) + jitter.xy) / vec2(grid), (float(s) + jitter.z) / 64.0);
      float depth = -posEye.z;
      mat3 invRot = transpose(mat3(u_view));
      vec3 worldPos = invRot * (posEye - u_view[3].xyz);
      vec3 rayDir = normalize(invRot * posEye);
      float froxelFootprint = 2.0 / max(u_proj[1][1] * float(grid.y), 1e-6) * depth;

      vec3 L = normalize(u_sunDirection.xyz);
      float nightFade = smoothstep(-0.3, 0.05, sunHeight);
      vec3 skyL = texture(u_envCube_texture, toSkySpace(L)).rgb;
      vec3 dayColor = mix(skyL, vec3(1.0), clamp(sunHeight, 0.0, 1.0));
      vec3 nightColor = mix(skyL, vec3(0.95, 0.95, 1.00), clamp(-sunHeight, 0.0, 1.0));
      vec3 sun = mix(nightColor * MOON_INTENSITY, dayColor * LIGHT_INTENSITY, nightFade);
      vec3 light = sun * phaseHG(dot(L, rayDir), u_volume.y) * volumeSunShadow(posEye)
                 * volumeTransmittance(frustumExitDistance(posEye, mat3(u_view) * L))
                 + volumeWorldLight(rayDir);

      int count = int(min(u_pointLightCount, 4.0));
      for (int i = 0; i < count; ++i) {
        vec4 posIntensity = i == 0 ? u_pointLightPosIntensity0 : i == 1 ? u_pointLightPosIntensity1
                          : i == 2 ? u_pointLightPosIntensity2 : u_pointLightPosIntensity3;
        vec4 colorRadius = i == 0 ? u_pointLightColorRadius0 : i == 1 ? u_pointLightColorRadius1
                         : i == 2 ? u_pointLightColorRadius2 : u_pointLightColorRadius3;
        vec3 toLight = posIntensity.xyz - worldPos;
        float dSqr = dot(toLight, toLight);
        float d = sqrt(dSqr);
        float rSqr = colorRadius.w * colorRadius.w;
        float spread = max(rSqr, 0.25 * froxelFootprint * froxelFootprint);
        float falloff = 2.0 / max(dSqr + spread + d * sqrt(dSqr + spread), 1e-12);
        vec3 aL = abs(toLight);
        float faceDistance = max(max(aL.x, aL.y), aL.z);
        float ratio = clamp(2.0 * 1.4142135 / 8192.0 / max(froxelFootprint / max(faceDistance, 1e-6), 1e-8), 1e-8, 1.0);
        int startLod = int(clamp(-log2(ratio), 0.0, 5.0));
        light += colorRadius.xyz * posIntensity.w * PI * rSqr * falloff
               * phaseHG(dot(toLight / max(d, 1e-6), rayDir), u_volume.y)
               * volumePointShadow(i, -toLight, startLod)
               * volumeTransmittance(d);
      }
      vec3 centerEye = froxelEye((vec2(froxel) + 0.5) / vec2(grid), (float(s) + 0.5) / 64.0);
      vec4 history = volumeHistory(invRot * (centerEye - u_view[3].xyz), grid);
      light = mix(history.rgb / max(history.a, 1e-4), light, mix(1.0, 0.1, history.a));

      float stretch = length(posEye) / depth * (u_volumeRange.y - u_volumeRange.x);
      float slab = exp(-u_volume.x * (t1 * t1 - t0 * t0) * stretch);
      o_volumeScatter_texture = vec4(light, slab);
    }
    ```

    source msl:
    ```msl
    constexpr constant float PI = 3.14159265358979;
    constexpr constant float LIGHT_INTENSITY = 3.0;
    constexpr constant float MOON_INTENSITY = 0.12;

    float phaseHG(float cosTheta, float g)
    {
      float d = 1.0 + g * g - 2.0 * g * cosTheta;
      return (1.0 - g * g) / (4.0 * PI * d * sqrt(d));
    }

    float frustumExitDistance(float3 posEye, float3 dirEye, constant Uniforms& u)
    {
      float4 c = u.u_proj * float4(posEye, 1.0);
      float4 d = u.u_proj * float4(dirEye, 0.0);
      float3 a0 = c.www - c.xyz, b0 = d.www - d.xyz;
      float3 a1 = c.www + c.xyz, b1 = d.www + d.xyz;
      float t = 1e20;
      for (int i = 0; i < 3; ++i) {
        if (b0[i] < 0.0) t = min(t, max(a0[i], 0.0) / -b0[i]);
        if (b1[i] < 0.0) t = min(t, max(a1[i], 0.0) / -b1[i]);
      }
      return t;
    }

    float volumeTransmittance(float distance, constant Uniforms& u)
    {
      return u.u_volume.w > 0.5 ? exp(-u.u_volume.x * distance) : 1.0;
    }

    float volumeSunShadow(float3 posEye, texture2d_array<uint> atlasTex, texture2d<float> dataTex,
                          texture2d<float> pageTableTex, constant Uniforms& u)
    {
      if (u.u_shadowEnabled < 0.5) return 1.0;
      float3 lightRel = (u.u_eyeToLightRotation * float4(posEye, 0.0)).xyz;
      float3 delta = lightRel - u.u_directionalRefOffset.xyz;
      int lodMin = int(u.u_shadowLodRange.x);
      float lod = u.u_shadowLodRange.z > 0.5
        ? log2(length(delta) * (32.0 / (32.0 - 1.0001)) * 2.0)
        : length(delta.xy) * (32.0 / (32.0 - 2.5001)) / exp2(float(lodMin - 1)) + float(lodMin - 1);
      int levelCount = int(u.u_shadowLevelCount);
      int first = clamp(int(ceil(lod + u.u_shadowLodRange.w)), lodMin, int(u.u_shadowLodRange.y)) - lodMin;
      for (int i = max(min(first + int(u.u_volumeSunLevelBias), levelCount - 1), 0); i < levelCount; ++i) {
        float4 slotOffset = dataTex.read(uint2(4, 24 + i));
        float radius = exp2(u.u_shadowLodRange.x + float(i)) * 0.5;
        float2 tileFloat = ((lightRel.xy + slotOffset.yz) / radius * 0.5 + 0.5) * 32.0;
        if (any(tileFloat < float2(0.0)) || any(tileFloat >= float2(32.0))) continue;
        int2 tile = int2(tileFloat);
        float4 page = pageTableTex.read(uint2(tile.y * 32 + tile.x, int(slotOffset.x)));
        if (page.z < 0.5) continue;
        float3 levelDepth = dataTex.read(uint2(5, 24 + i)).xyz;
        float compareDepth = ((lightRel.z + levelDepth.x) * levelDepth.y + levelDepth.z) * 0.5 + 0.5 - u.u_shadowBias.x;
        float2 frac = fract(tileFloat);
        uint v = atlasTex.read(uint2(uint(page.y) * 256u + uint(frac.x * 256.0), uint(frac.y * 256.0)),
                               uint(page.x)).r;
        return v == 0xFFFFFFFFu || compareDepth <= as_type<float>(v) ? 1.0 : 0.0;
      }
      return 1.0;
    }

    float volumePointShadow(int lightIdx, float3 lL, int startLod, texture2d_array<uint> atlasTex,
                            texture2d<float> dataTex, texture2d<float> pageTableTex, constant Uniforms& u)
    {
      if (u.u_punctualShadowEnabled < 0.5) return 1.0;
      float3 aL = abs(lL);
      int face = aL.x > aL.y && aL.x > aL.z ? (lL.x > 0.0 ? 1 : 2)
               : aL.y > aL.x && aL.y > aL.z ? (lL.y > 0.0 ? 3 : 4) : (lL.z > 0.0 ? 5 : 0);
      float3 fL = lL;
      if (face == 1) fL = float3(-lL.y, lL.z, -lL.x);
      else if (face == 2) fL = float3(lL.y, lL.z, lL.x);
      else if (face == 3) fL = float3(lL.x, lL.z, -lL.y);
      else if (face == 4) fL = float3(-lL.x, lL.z, lL.y);
      else if (face == 5) fL = float3(lL.x, -lL.y, -lL.z);
      float z = max(abs(fL.z), 1e-6);
      int tilemapIndex = lightIdx * 6 + face;
      float2 nearFar = dataTex.read(uint2(5, tilemapIndex)).xy;
      float2 uv = clamp(fL.xy / z * 0.5 + 0.5, 0.0, 0.999999);
      for (int i = 0; i <= 5; ++i) {
        int lod = i <= startLod ? startLod - i : i;
        int size = 32 >> lod;
        int base = (4096 - (4096 >> (2 * lod))) / 3;
        float2 tileFloat = uv * float(size);
        int2 tile = int2(tileFloat);
        float4 page = pageTableTex.read(uint2(base + tile.y * size + tile.x, tilemapIndex));
        if (page.z < 0.5) continue;
        float zb = max(z - 4.0 * z / float(size * 256), nearFar.x);
        float tapDepth = nearFar.y * (zb - nearFar.x) / ((nearFar.y - nearFar.x) * zb);
        float2 frac = tileFloat - float2(tile);
        uint v = atlasTex.read(uint2(uint(page.y) * 256u + uint(frac.x * 256.0), uint(frac.y * 256.0)),
                               uint(page.x)).r;
        return v == 0xFFFFFFFFu || tapDepth <= as_type<float>(v) ? 1.0 : 0.0;
      }
      return 1.0;
    }

    float3 froxelEye(float2 uv, float t, constant Uniforms& u)
    {
      float4 e = u.u_invProj * float4(uv * 2.0 - 1.0, 1.0, 1.0);
      float3 dirEye = e.xyz / e.w;
      return dirEye * (mix(u.u_volumeRange.x, u.u_volumeRange.y, t * t) / max(-dirEye.z, 1e-6));
    }

    float4 volumeHistory(float3 worldPos, int2 grid, texture2d<float> scatterTex, constant Uniforms& u)
    {
      float4 c = u.u_volumePrevViewProj * float4(worldPos, 1.0);
      if (u.u_volumeHistory < 0.5 || c.w <= u.u_volumeRange.x) return float4(0.0);
      float3 f = float3((c.xy / c.w * 0.5 + 0.5) * float2(grid),
                        sqrt((c.w - u.u_volumeRange.x) / (u.u_volumeRange.y - u.u_volumeRange.x)) * 64.0) - 0.5;
      if (any(f < float3(-0.5)) || any(f > float3(float2(grid), 64.0) - 0.5)) return float4(0.0);
      int3 i0 = int3(floor(f));
      float3 w = f - float3(i0);
      float4 sum = float4(0.0);
      for (int k = 0; k < 8; ++k) {
        int3 o = int3(k & 1, (k >> 1) & 1, k >> 2);
        int3 p = clamp(i0 + o, int3(0), int3(grid - 1, 63));
        float4 v = scatterTex.read(uint2(int2(p.z % 8, p.z / 8) * grid + p.xy));
        float3 ow = mix(1.0 - w, w, float3(o));
        sum += float4(v.rgb, 1.0) * (ow.x * ow.y * ow.z * step(v.a, 1.0));
      }
      return sum;
    }

    //@main
    {
      int2 a = int2(gl_FragCoord.xy);
      int2 grid = max(int2(u_volumeRange.zw), int2(1));
      int2 sliceXY = a / grid;
      int s = sliceXY.y * 8 + sliceXY.x;
      int2 froxel = a - sliceXY * grid;
      float t0 = float(s) / 64.0, t1 = float(s + 1) / 64.0;
      if (u_volume.z < 0.5 || sliceXY.x >= 8 || s >= 64) {
        o_volumeScatter_texture = float4(0.0, 0.0, 0.0, 1.0);
      } else if (mix(u_volumeRange.x, u_volumeRange.y, t0 * t0) > u_froxelDepth.read(uint2(froxel)).x) {
        o_volumeScatter_texture = float4(0.0, 0.0, 0.0, 2.0);
      } else {
        float noise = fract(52.9829189 * fract(dot(float2(a), float2(0.06711056, 0.00583715))));
        float3 jitter = fract(float(frameIndex % 64) * float3(0.7548777, 0.5698403, 0.6180340) + noise);
        float3 posEye = froxelEye((float2(froxel) + jitter.xy) / float2(grid), (float(s) + jitter.z) / 64.0, _u);
        float depth = -posEye.z;
        float3x3 invView = float3x3(
          float3(u_view[0][0], u_view[1][0], u_view[2][0]),
          float3(u_view[0][1], u_view[1][1], u_view[2][1]),
          float3(u_view[0][2], u_view[1][2], u_view[2][2])
        );
        float3 worldPos = invView * (posEye - float3(u_view[3][0], u_view[3][1], u_view[3][2]));
        float3 rayDir = normalize(invView * posEye);
        float froxelFootprint = 2.0 / max(u_proj[1][1] * float(grid.y), 1e-6) * depth;

        float3 L = normalize(u_sunDirection.xyz);
        float nightFade = smoothstep(-0.3, 0.05, sunHeight);
        float3 skyDir = mix(L, float3(L.x, L.z, -L.y), u_zUp);
        float3 skyL = texture(u_envCube_texture, skyDir).rgb;
        float3 dayColor = mix(skyL, float3(1.0), saturate(sunHeight));
        float3 nightColor = mix(skyL, float3(0.95, 0.95, 1.00), saturate(-sunHeight));
        float3 sun = mix(nightColor * MOON_INTENSITY, dayColor * LIGHT_INTENSITY, nightFade);
        float3x3 viewRot = float3x3(u_view[0].xyz, u_view[1].xyz, u_view[2].xyz);
        float3 light = sun * phaseHG(dot(L, rayDir), u_volume.y)
                     * volumeSunShadow(posEye, u_shadow_atlas, u_shadow_data, u_shadow_pagetable, _u)
                     * volumeTransmittance(frustumExitDistance(posEye, viewRot * L, _u), _u);

        float3 worldAhead = texture(u_irradiance_texture, mix(rayDir, float3(rayDir.x, rayDir.z, -rayDir.y), u_zUp)).rgb;
        float3 worldBehind = texture(u_irradiance_texture, mix(-rayDir, float3(-rayDir.x, -rayDir.z, rayDir.y), u_zUp)).rgb;
        light += max(0.5 * (worldAhead + worldBehind) + 0.75 * u_volume.y * (worldAhead - worldBehind), float3(0.0))
               * u_iblEnabled;

        int count = int(min(u_pointLightCount, 4.0));
        for (int i = 0; i < count; ++i) {
          float4 posIntensity = i == 0 ? u_pointLightPosIntensity0 : i == 1 ? u_pointLightPosIntensity1
                              : i == 2 ? u_pointLightPosIntensity2 : u_pointLightPosIntensity3;
          float4 colorRadius = i == 0 ? u_pointLightColorRadius0 : i == 1 ? u_pointLightColorRadius1
                             : i == 2 ? u_pointLightColorRadius2 : u_pointLightColorRadius3;
          float3 toLight = posIntensity.xyz - worldPos;
          float dSqr = dot(toLight, toLight);
          float d = sqrt(dSqr);
          float rSqr = colorRadius.w * colorRadius.w;
          float spread = max(rSqr, 0.25 * froxelFootprint * froxelFootprint);
          float falloff = 2.0 / max(dSqr + spread + d * sqrt(dSqr + spread), 1e-12);
          float3 aL = abs(toLight);
          float faceDistance = max(max(aL.x, aL.y), aL.z);
          float ratio = clamp(2.0 * 1.4142135 / 8192.0 / max(froxelFootprint / max(faceDistance, 1e-6), 1e-8), 1e-8, 1.0);
          int startLod = int(clamp(-log2(ratio), 0.0, 5.0));
          light += colorRadius.xyz * posIntensity.w * PI * rSqr * falloff
                 * phaseHG(dot(toLight / max(d, 1e-6), rayDir), u_volume.y)
                 * volumePointShadow(i, -toLight, startLod, u_shadow_atlas, u_shadow_data, u_shadow_pagetable, _u)
                 * volumeTransmittance(d, _u);
        }
        float3 centerEye = froxelEye((float2(froxel) + 0.5) / float2(grid), (float(s) + 0.5) / 64.0, _u);
        float3 centerWorld = invView * (centerEye - float3(u_view[3][0], u_view[3][1], u_view[3][2]));
        float4 history = volumeHistory(centerWorld, grid, u_froxelHistory, _u);
        light = mix(history.rgb / max(history.a, 1e-4), light, mix(1.0, 0.1, history.a));

        float stretch = length(posEye) / depth * (u_volumeRange.y - u_volumeRange.x);
        float slab = exp(-u_volume.x * (t1 * t1 - t0 * t0) * stretch);
        o_volumeScatter_texture = float4(light, slab);
      }
    }
    ```

shader: ssr
  uniforms: [ u_position_texture: sampler2d,
              u_normal_texture: sampler2d,
              u_material_texture: sampler2d,
              u_history_texture: sampler2d,
              u_view: mat4 <- auto-view-matrix,
              u_proj: mat4,
              u_prevViewProj: mat4,
              u_taa: vec4,
              u_ssr: vec4,
              frameIndex: int ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    const float PI = 3.14159265358979;

    vec3 finiteColor(vec3 c)
    {
      bvec3 bad = equal(floatBitsToUint(c) & 0x7F800000u, uvec3(0x7F800000u));
      return mix(clamp(c, 0.0, 65000.0), vec3(0.0), bad);
    }

    vec3 sampleGGXVisible(vec3 N, vec3 V, float a, vec2 xi)
    {
      vec3 T = normalize(cross(abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0), N));
      vec3 B = cross(N, T);
      vec3 Vt = vec3(dot(V, T), dot(V, B), dot(V, N));
      vec3 Vh = normalize(vec3(a * Vt.x, a * Vt.y, Vt.z));
      float lensq = dot(Vh.xy, Vh.xy);
      vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
      vec3 T2 = cross(Vh, T1);
      float r = sqrt(xi.x);
      float phi = 2.0 * PI * xi.y;
      float t1 = r * cos(phi);
      float s = 0.5 * (1.0 + Vh.z);
      float t2 = (1.0 - s) * sqrt(1.0 - t1 * t1) + s * r * sin(phi);
      vec3 Nh = t1 * T1 + t2 * T2 + sqrt(max(1.0 - t1 * t1 - t2 * t2, 0.0)) * Vh;
      vec3 Ht = normalize(vec3(a * Nh.x, a * Nh.y, max(Nh.z, 0.0)));
      return T * Ht.x + B * Ht.y + N * Ht.z;
    }

    float sceneDepth(vec2 uv, ivec2 size)
    {
      vec3 p = texelFetch(u_position_texture, clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1), 0).xyz;
      return p == vec3(0.0) ? 1e30 : -p.z;
    }

    void main()
    {
      ivec2 size = textureSize(u_position_texture, 0);
      ivec2 fp = min(ivec2(gl_FragCoord.xy) * 2, size - 1);
      vec4 n = texelFetch(u_normal_texture, fp, 0);
      vec3 P = texelFetch(u_position_texture, fp, 0).xyz;
      float roughness = clamp(texelFetch(u_material_texture, fp, 0).r, 0.045, 1.0);
      o_ssrGuide_texture = vec4(n.a < 0.5 ? vec3(0.0) : normalize(n.xyz), P.z);
      o_ssrRadiance_texture = vec4(0.0);
      if (u_ssr.z < 0.5 || n.a < 0.5 || roughness >= u_ssr.x + 0.2) return;

      vec2 noisePixel = gl_FragCoord.xy + 5.588238 * float(frameIndex % 64);
      float noise = fract(52.9829189 * fract(dot(noisePixel, vec2(0.06711056, 0.00583715))));
      float noiseB = fract(52.9829189 * fract(dot(noisePixel.yx, vec2(0.06711056, 0.00583715))));

      vec3 N = normalize(n.xyz);
      vec3 V = normalize(-P);
      vec3 R = reflect(-V, sampleGGXVisible(N, V, roughness * roughness, vec2(noise, noiseB)));
      if (dot(R, N) <= 0.0) R = reflect(-V, N);

      vec3 origin = P + N * (0.002 * -P.z);
      float nearPlane = u_proj[3][2] / (u_proj[2][2] - 1.0);
      float dist = u_ssr.y;
      if (R.z > 0.0) dist = min(dist, 0.99 * (-nearPlane - origin.z) / R.z);
      if (dist <= 0.0) return;

      vec4 h0 = u_proj * vec4(origin, 1.0);
      vec4 h1 = u_proj * vec4(origin + R * dist, 1.0);
      float k0 = 1.0 / h0.w;
      float k1 = 1.0 / h1.w;
      vec2 s0 = h0.xy * k0 * 0.5 + 0.5;
      vec2 s1 = h1.xy * k1 * 0.5 + 0.5;
      vec2 d = s1 - s0;
      float tMax = 1.0;
      if (abs(d.x) > 1e-6) tMax = min(tMax, max(-s0.x / d.x, (1.0 - s0.x) / d.x));
      if (abs(d.y) > 1e-6) tMax = min(tMax, max(-s0.y / d.y, (1.0 - s0.y) / d.y));
      float minT = 1.5 / max(length(d * vec2(size)), 1e-4);
      if (tMax <= minT) return;

      float jitter = fract(noise + noiseB);
      float tPrev = 0.0;
      float depthPrev = 1.0 / k0;
      float tHit = -1.0;
      for (int i = 0; i < 32; ++i) {
        float t = tMax * (float(i) + jitter) / 32.0;
        float rayDepth = 1.0 / mix(k0, k1, t);
        float scene = sceneDepth(mix(s0, s1, t), size);
        if (t > minT && rayDepth > scene && rayDepth - scene < abs(rayDepth - depthPrev) + 0.02 * scene) {
          tHit = t;
          break;
        }
        tPrev = t;
        depthPrev = rayDepth;
      }
      if (tHit < 0.0) return;
      for (int i = 0; i < 4; ++i) {
        float t = 0.5 * (tPrev + tHit);
        if (1.0 / mix(k0, k1, t) > sceneDepth(mix(s0, s1, t), size)) tHit = t; else tPrev = t;
      }

      vec2 hitUV = mix(s0, s1, tHit);
      ivec2 hitPixel = clamp(ivec2(hitUV * vec2(size)), ivec2(0), size - 1);
      vec4 hitNormal = texelFetch(u_normal_texture, hitPixel, 0);
      if (hitNormal.a < 0.5 || dot(hitNormal.xyz, R) > 0.0) return;

      vec3 hitPos = texelFetch(u_position_texture, hitPixel, 0).xyz;
      vec4 prevClip = u_prevViewProj * vec4(transpose(mat3(u_view)) * (hitPos - u_view[3].xyz), 1.0);
      vec2 prevUV = u_taa.x > 0.5 && prevClip.w > 0.0 ? prevClip.xy / prevClip.w * 0.5 + 0.5 : hitUV;
      if (any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0)))) return;

      vec2 edge = min(hitUV, 1.0 - hitUV);
      float confidence = clamp(min(edge.x, edge.y) * 10.0, 0.0, 1.0)
                       * (1.0 - clamp((roughness - u_ssr.x) / 0.2, 0.0, 1.0));
      vec3 hit = finiteColor(texture(u_history_texture, prevUV).rgb);
      hit *= min(1.0, 10.0 / max(max(hit.r, max(hit.g, hit.b)), 1e-6));
      o_ssrRadiance_texture = vec4(hit, confidence);
    }
    ```

    source msl:
    ```msl
    constexpr constant float PI = 3.14159265358979;

    float3 finiteColor(float3 c)
    {
      bool3 bad = (as_type<uint3>(c) & 0x7F800000u) == 0x7F800000u;
      return select(clamp(c, 0.0, 65000.0), float3(0.0), bad);
    }

    float3 sampleGGXVisible(float3 N, float3 V, float a, float2 xi)
    {
      float3 T = normalize(cross(abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0), N));
      float3 B = cross(N, T);
      float3 Vt = float3(dot(V, T), dot(V, B), dot(V, N));
      float3 Vh = normalize(float3(a * Vt.x, a * Vt.y, Vt.z));
      float lensq = dot(Vh.xy, Vh.xy);
      float3 T1 = lensq > 0.0 ? float3(-Vh.y, Vh.x, 0.0) * rsqrt(lensq) : float3(1.0, 0.0, 0.0);
      float3 T2 = cross(Vh, T1);
      float r = sqrt(xi.x);
      float phi = 2.0 * PI * xi.y;
      float t1 = r * cos(phi);
      float s = 0.5 * (1.0 + Vh.z);
      float t2 = (1.0 - s) * sqrt(1.0 - t1 * t1) + s * r * sin(phi);
      float3 Nh = t1 * T1 + t2 * T2 + sqrt(max(1.0 - t1 * t1 - t2 * t2, 0.0)) * Vh;
      float3 Ht = normalize(float3(a * Nh.x, a * Nh.y, max(Nh.z, 0.0)));
      return T * Ht.x + B * Ht.y + N * Ht.z;
    }

    float sceneDepth(float2 uv, int2 size, texture2d<float> positionTex)
    {
      float3 p = positionTex.read(uint2(clamp(int2(uv * float2(size)), int2(0), size - 1))).xyz;
      return all(p == float3(0.0)) ? 1e30 : -p.z;
    }

    float4 ssrTrace(float2 fragCoord, uint2 fp, int2 size, float4 n, float3 P,
                    texture2d<float> positionTex, texture2d<float> normalTex, texture2d<float> materialTex,
                    texture2d<float> historyTex, sampler historySmp, constant Uniforms& u)
    {
      float roughness = clamp(materialTex.read(fp).r, 0.045, 1.0);
      if (u.u_ssr.z < 0.5 || n.a < 0.5 || roughness >= u.u_ssr.x + 0.2) return float4(0.0);

      float2 noisePixel = fragCoord + 5.588238 * float(u.frameIndex % 64);
      float noise = fract(52.9829189 * fract(dot(noisePixel, float2(0.06711056, 0.00583715))));
      float noiseB = fract(52.9829189 * fract(dot(noisePixel.yx, float2(0.06711056, 0.00583715))));

      float3 N = normalize(n.xyz);
      float3 V = normalize(-P);
      float3 R = reflect(-V, sampleGGXVisible(N, V, roughness * roughness, float2(noise, noiseB)));
      if (dot(R, N) <= 0.0) R = reflect(-V, N);

      float3 origin = P + N * (0.002 * -P.z);
      float nearPlane = u.u_proj[3][2] / (u.u_proj[2][2] - 1.0);
      float dist = u.u_ssr.y;
      if (R.z > 0.0) dist = min(dist, 0.99 * (-nearPlane - origin.z) / R.z);
      if (dist <= 0.0) return float4(0.0);

      float4 h0 = u.u_proj * float4(origin, 1.0);
      float4 h1 = u.u_proj * float4(origin + R * dist, 1.0);
      float k0 = 1.0 / h0.w;
      float k1 = 1.0 / h1.w;
      float2 s0 = h0.xy * k0 * 0.5 + 0.5;
      float2 s1 = h1.xy * k1 * 0.5 + 0.5;
      float2 d = s1 - s0;
      float tMax = 1.0;
      if (abs(d.x) > 1e-6) tMax = min(tMax, max(-s0.x / d.x, (1.0 - s0.x) / d.x));
      if (abs(d.y) > 1e-6) tMax = min(tMax, max(-s0.y / d.y, (1.0 - s0.y) / d.y));
      float minT = 1.5 / max(length(d * float2(size)), 1e-4);
      if (tMax <= minT) return float4(0.0);

      float jitter = fract(noise + noiseB);
      float tPrev = 0.0;
      float depthPrev = 1.0 / k0;
      float tHit = -1.0;
      for (int i = 0; i < 32; ++i) {
        float t = tMax * (float(i) + jitter) / 32.0;
        float rayDepth = 1.0 / mix(k0, k1, t);
        float scene = sceneDepth(mix(s0, s1, t), size, positionTex);
        if (t > minT && rayDepth > scene && rayDepth - scene < abs(rayDepth - depthPrev) + 0.02 * scene) {
          tHit = t;
          break;
        }
        tPrev = t;
        depthPrev = rayDepth;
      }
      if (tHit < 0.0) return float4(0.0);
      for (int i = 0; i < 4; ++i) {
        float t = 0.5 * (tPrev + tHit);
        if (1.0 / mix(k0, k1, t) > sceneDepth(mix(s0, s1, t), size, positionTex)) tHit = t; else tPrev = t;
      }

      float2 hitUV = mix(s0, s1, tHit);
      uint2 hitPixel = uint2(clamp(int2(hitUV * float2(size)), int2(0), size - 1));
      float4 hitNormal = normalTex.read(hitPixel);
      if (hitNormal.a < 0.5 || dot(hitNormal.xyz, R) > 0.0) return float4(0.0);

      float3 hitPos = positionTex.read(hitPixel).xyz;
      float3x3 invRot = transpose(float3x3(u.u_view[0].xyz, u.u_view[1].xyz, u.u_view[2].xyz));
      float4 prevClip = u.u_prevViewProj * float4(invRot * (hitPos - u.u_view[3].xyz), 1.0);
      float2 prevUV = u.u_taa.x > 0.5 && prevClip.w > 0.0 ? prevClip.xy / prevClip.w * 0.5 + 0.5 : hitUV;
      if (any(prevUV < float2(0.0)) || any(prevUV > float2(1.0))) return float4(0.0);

      float2 edge = min(hitUV, 1.0 - hitUV);
      float confidence = saturate(min(edge.x, edge.y) * 10.0)
                       * (1.0 - saturate((roughness - u.u_ssr.x) / 0.2));
      float3 hit = finiteColor(historyTex.sample(historySmp, prevUV).rgb);
      hit *= min(1.0, 10.0 / max(max(hit.r, max(hit.g, hit.b)), 1e-6));
      return float4(hit, confidence);
    }

    //@main
    {
      int2 size = int2(u_position_texture.get_width(), u_position_texture.get_height());
      uint2 fp = uint2(min(int2(gl_FragCoord.xy) * 2, size - 1));
      float4 n = u_normal_texture.read(fp);
      float3 P = u_position_texture.read(fp).xyz;
      o_ssrGuide_texture = float4(n.a < 0.5 ? float3(0.0) : normalize(n.xyz), P.z);
      o_ssrRadiance_texture = ssrTrace(gl_FragCoord.xy, fp, size, n, P,
                                       u_position_texture, u_normal_texture, u_material_texture,
                                       u_history_texture, u_history_texture_smp, _u);
    }
    ```

shader: ssr-temporal
  uniforms: [ u_ssrRadiance_texture: sampler2d,
              u_ssrGuide_texture: sampler2d,
              u_ssrHistory_texture: sampler2d,
              u_position_texture: sampler2d,
              u_material_texture: sampler2d,
              u_view: mat4 <- auto-view-matrix,
              u_prevViewProj: mat4,
              u_currViewProj: mat4,
              u_taa: vec4,
              u_ssr: vec4 ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    vec3 finiteColor(vec3 c)
    {
      bvec3 bad = equal(floatBitsToUint(c) & 0x7F800000u, uvec3(0x7F800000u));
      return mix(clamp(c, 0.0, 65000.0), vec3(0.0), bad);
    }

    void main()
    {
      ivec2 hp = ivec2(gl_FragCoord.xy);
      ivec2 halfSize = textureSize(u_ssrRadiance_texture, 0);
      ivec2 fullSize = textureSize(u_position_texture, 0);
      vec4 gc = texelFetch(u_ssrGuide_texture, hp, 0);
      if (u_ssr.z < 0.5 || gc.xyz == vec3(0.0)) {
        o_ssrAccum_texture = vec4(0.0);
        return;
      }
      ivec2 fp = min(hp * 2, fullSize - 1);
      float roughness = texelFetch(u_material_texture, fp, 0).r;
      float spread = clamp(4.0 * roughness, 0.0, 1.0);
      float depthScale = 1.0 / max(0.01 * abs(gc.w), 1e-3);
      vec4 m1 = vec4(0.0), m2 = vec4(0.0), blurred = vec4(0.0);
      float wsum = 0.0, bsum = 0.0;
      for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
          ivec2 h = clamp(hp + ivec2(x, y), ivec2(0), halfSize - 1);
          vec4 gs = texelFetch(u_ssrGuide_texture, h, 0);
          if (gs.xyz == vec3(0.0)) continue;
          float w = exp(-abs(gs.w - gc.w) * depthScale) * pow(max(dot(gc.xyz, gs.xyz), 0.0), 8.0);
          vec4 r = texelFetch(u_ssrRadiance_texture, h, 0);
          vec4 c = vec4(finiteColor(r.rgb) * r.a, r.a);
          m1 += c * w;
          m2 += c * c * w;
          wsum += w;
          float b = x == 0 && y == 0 ? 1.0 : w * spread;
          blurred += c * b;
          bsum += b;
        }
      }
      vec4 mean = m1 / max(wsum, 1e-4);
      vec4 sigma = sqrt(max(m2 / max(wsum, 1e-4) - mean * mean, 0.0));
      vec4 current = blurred / max(bsum, 1e-4);
      if (u_taa.x < 0.5) {
        o_ssrAccum_texture = current;
        return;
      }
      vec3 pc = texelFetch(u_position_texture, fp, 0).xyz;
      vec4 world = inverse(u_view) * vec4(pc, 1.0);
      vec4 prevClip = u_prevViewProj * world;
      vec4 currClip = u_currViewProj * world;
      vec2 prevUV = (vec2(hp) + 0.5) / vec2(halfSize)
                  + (prevClip.xy / prevClip.w - currClip.xy / currClip.w) * 0.5;
      bool offscreen = prevClip.w <= 0.0 || any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0)));
      vec4 history = texture(u_ssrHistory_texture, clamp(prevUV, 0.0, 1.0));
      history = clamp(vec4(finiteColor(history.rgb), finiteColor(history.aaa).x),
                      mean - 1.5 * sigma, mean + 1.5 * sigma);
      o_ssrAccum_texture = mix(history, current,
                               (u_taa.y > 0.5 || u_ssr.w > 0.5 || offscreen) ? 1.0 : max(u_taa.z, 0.05));
    }
    ```

    source msl:
    ```msl
    float3 finiteColor(float3 c)
    {
      bool3 bad = (as_type<uint3>(c) & 0x7F800000u) == 0x7F800000u;
      return select(clamp(c, 0.0, 65000.0), float3(0.0), bad);
    }

    //@main
    {
      int2 hp = int2(gl_FragCoord.xy);
      int2 halfSize = int2(u_ssrRadiance_texture.get_width(), u_ssrRadiance_texture.get_height());
      int2 fullSize = int2(u_position_texture.get_width(), u_position_texture.get_height());
      float4 gc = u_ssrGuide_texture.read(uint2(hp));
      if (u_ssr.z < 0.5 || all(gc.xyz == float3(0.0))) {
        o_ssrAccum_texture = float4(0.0);
      } else {
        uint2 fp = uint2(min(hp * 2, fullSize - 1));
        float roughness = u_material_texture.read(fp).r;
        float spread = saturate(4.0 * roughness);
        float depthScale = 1.0 / max(0.01 * abs(gc.w), 1e-3);
        float4 m1 = float4(0.0), m2 = float4(0.0), blurred = float4(0.0);
        float wsum = 0.0, bsum = 0.0;
        for (int y = -1; y <= 1; ++y) {
          for (int x = -1; x <= 1; ++x) {
            uint2 h = uint2(clamp(hp + int2(x, y), int2(0), halfSize - 1));
            float4 gs = u_ssrGuide_texture.read(h);
            if (all(gs.xyz == float3(0.0))) continue;
            float w = exp(-abs(gs.w - gc.w) * depthScale) * pow(max(dot(gc.xyz, gs.xyz), 0.0), 8.0);
            float4 r = u_ssrRadiance_texture.read(h);
            float4 c = float4(finiteColor(r.rgb) * r.a, r.a);
            m1 += c * w;
            m2 += c * c * w;
            wsum += w;
            float b = x == 0 && y == 0 ? 1.0 : w * spread;
            blurred += c * b;
            bsum += b;
          }
        }
        float4 mean = m1 / max(wsum, 1e-4);
        float4 sigma = sqrt(max(m2 / max(wsum, 1e-4) - mean * mean, 0.0));
        float4 current = blurred / max(bsum, 1e-4);
        if (u_taa.x < 0.5) {
          o_ssrAccum_texture = current;
        } else {
          float3 pc = u_position_texture.read(fp).xyz;
          float3x3 invRot = transpose(float3x3(u_view[0].xyz, u_view[1].xyz, u_view[2].xyz));
          float3 world = invRot * (pc - u_view[3].xyz);
          float4 prevClip = u_prevViewProj * float4(world, 1.0);
          float4 currClip = u_currViewProj * float4(world, 1.0);
          float2 prevUV = (float2(hp) + 0.5) / float2(halfSize)
                        + (prevClip.xy / prevClip.w - currClip.xy / currClip.w) * 0.5;
          bool offscreen = prevClip.w <= 0.0 || any(prevUV < float2(0.0)) || any(prevUV > float2(1.0));
          float4 history = texture(u_ssrHistory_texture, clamp(prevUV, 0.0, 1.0));
          history = clamp(float4(finiteColor(history.rgb), finiteColor(history.aaa).x),
                          mean - 1.5 * sigma, mean + 1.5 * sigma);
          o_ssrAccum_texture = mix(history, current,
                                   (u_taa.y > 0.5 || u_ssr.w > 0.5 || offscreen) ? 1.0 : max(u_taa.z, 0.05));
        }
      }
    }
    ```

