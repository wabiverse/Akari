  fsh:
    source:
    ```glsl
    void main()
    {
      ivec2 size = textureSize(u_pointShadowGuide_texture, 0);
      ivec2 c = ivec2(gl_FragCoord.xy);
      vec4 gc = texelFetch(u_pointShadowGuide_texture, c, 0);
      vec4 s0 = vec4(0.0), s1 = vec4(0.0), s2 = vec4(0.0), s3 = vec4(0.0);
      float wsum = 0.0;
      for (int k = -2; k <= 2; ++k) {
        ivec2 p = clamp(c + ivec2(1, 0) * k, ivec2(0), size - 1);
        vec4 g = texelFetch(u_pointShadowGuide_texture, p, 0);
        float w = exp(-float(k * k) / 4.5)
                * exp(-abs(g.w - gc.w) / max(0.02 * abs(gc.w), 1e-3))
                * pow(max(dot(g.xyz, gc.xyz), 0.0), 8.0) + (k == 0 ? 1e-4 : 0.0);
              if (!(w > 0.0)) w = k == 0 ? 1.0 : 0.0;
        s0 += texelFetch(u_pointShadowRaw0_texture, p, 0) * w;
        s1 += texelFetch(u_pointShadowRaw1_texture, p, 0) * w;
        s2 += texelFetch(u_pointShadowRaw2_texture, p, 0) * w;
        s3 += texelFetch(u_pointShadowRaw3_texture, p, 0) * w;
        wsum += w;
      }
      o_pointShadowBlur0_texture = s0 / wsum;
      o_pointShadowBlur1_texture = s1 / wsum;
      o_pointShadowBlur2_texture = s2 / wsum;
      o_pointShadowBlur3_texture = s3 / wsum;
    }
    ```

