--- labfx version 1.0

name: Akari LabGL
version: 1.0

buffer: gbuffer
  has depth: yes
  textures:
    [ diffuse, f16x4, scale: 1.0
      position, f32x4, scale: 1.0
      normal, f16x4, scale: 1.0
      material, f16x4, scale: 1.0 ]

buffer: envCube
  textures:
    has mips: yes
    has depth: no
    size: [256 256]
    cube: yes
    [ envCube, f16x4, scale: 1.0 ]

buffer: color
  has depth: no
  textures:
    [ final, f16x4, scale: 1.0 ]

buffer: ssgiPrep
  has depth: no
  textures:
    [ ssgiDepth, f32x1, scale: 0.5
      ssgiNormal, f16x4, scale: 0.5
      ssgiRadiance, f16x4, scale: 0.5 ]

buffer: ssgiPyramid
  has depth: no
  textures:
    [ ssgiPyramidDepth, f32x1, scale: 0.5
      ssgiPyramidNormal, f16x4, scale: 0.5
      ssgiPyramidRadiance, f16x4, scale: 0.5 ]

buffer: ssgi
  has depth: no
  textures:
    [ ssgiRaw, f16x4, scale: 0.5
      ssgiSpecRaw, f16x4, scale: 0.5 ]

buffer: ssgiAccum
  has depth: no
  textures:
    [ ssgiAccum, f16x4, scale: 0.5
      ssgiSpecAccum, f16x4, scale: 0.5 ]

buffer: ssgiHistory
  has depth: no
  latency: ring 2
  textures:
    [ ssgiHistory, f16x4, scale: 0.5
      ssgiSpecHistory, f16x4, scale: 0.5 ]

buffer: pointShadow
  has depth: no
  textures:
    [ pointShadow, f16x4, scale: 0.5
      pointShadowGuide, f16x4, scale: 0.5 ]

buffer: volumeScatter
  has depth: no
  textures:
    [ volumeScatter, f16x4, scale: 0.5 ]

buffer: volumeIntegrated
  has depth: no
  textures:
    [ volumeIntegrated, f16x4, scale: 0.5 ]

buffer: ssr
  has depth: no
  textures:
    [ ssrRadiance, f16x4, scale: 0.5
      ssrGuide, f16x4, scale: 0.5 ]

buffer: ssrAccum
  has depth: no
  textures:
    [ ssrAccum, f16x4, scale: 0.5 ]

buffer: ssrHistory
  has depth: no
  latency: ring 2
  textures:
    [ ssrHistory, f16x4, scale: 0.5 ]

buffer: taa
  has depth: no
  textures:
    [ final, f16x4, scale: 1.0 ]

buffer: history
  has depth: no
  latency: ring 2
  textures:
    [ history, f16x4, scale: 1.0 ]

buffer: tonemap
  has depth: no
  textures:
    [ tonemap, f16x4, scale: 1.0 ]

pass: clear gbuffer
  draw: no
  clear depth: yes
  clear outputs: yes
  outputs: gbuffer [diffuse, position, normal, material]

pass: sky
  draw: compute
  use shader: hosek-wilkie
  dispatch: [ 64, 64, 6 ]
  threadgroup: [ 16, 16, 1 ]
  outputs: envCube [ envCube ]

pass: geometry
  draw: opaque geometry
  clear depth: no
  depth test: greater
  write depth: yes
  use shader: mesh
  outputs: gbuffer [diffuse, position, normal, material]

pass: geometry dynamic
  callback: draw-dynamic-geometry
  clear depth: no
  depth test: greater
  write depth: yes
  use shader: mesh
  outputs: gbuffer [diffuse, position, normal, material]

pass: ssgi prep
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi-prep
  inputs: [gbuffer.position, gbuffer.normal, gbuffer.material, history.history]
  outputs: ssgiPrep [ssgiDepth, ssgiNormal, ssgiRadiance]

pass: ssgi pyramid
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi-pyramid
  inputs: [ssgiPrep.ssgiDepth, ssgiPrep.ssgiNormal, ssgiPrep.ssgiRadiance]
  outputs: ssgiPyramid [ssgiPyramidDepth, ssgiPyramidNormal, ssgiPyramidRadiance]

pass: ssgi
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi
  inputs: [ssgiPrep.ssgiDepth, ssgiPrep.ssgiNormal, ssgiPrep.ssgiRadiance,
           ssgiPyramid.ssgiPyramidDepth, ssgiPyramid.ssgiPyramidNormal, ssgiPyramid.ssgiPyramidRadiance]
  outputs: ssgi [ ssgiRaw, ssgiSpecRaw ]

pass: ssgi temporal
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi-temporal
  inputs: [ssgi.ssgiRaw, ssgi.ssgiSpecRaw, ssgiHistory.ssgiHistory, ssgiHistory.ssgiSpecHistory,
           ssgiPrep.ssgiDepth, ssgiPrep.ssgiNormal]
  outputs: ssgiAccum [ ssgiAccum, ssgiSpecAccum ]

pass: ssgi history
  draw: quad
  depth test: never
  write depth: no
  use shader: ssgi-copy
  inputs: [ssgiAccum.ssgiAccum, ssgiAccum.ssgiSpecAccum]
  outputs: ssgiHistory [ ssgiHistory, ssgiSpecHistory ]

pass: volume scatter
  draw: quad
  depth test: never
  write depth: no
  use shader: volume-scatter
  inputs: [envCube.envCube, irradiance.irradiance]
  outputs: volumeScatter [ volumeScatter ]

pass: volume integrate
  callback: volume-integrate

pass: ssr
  draw: quad
  depth test: never
  write depth: no
  use shader: ssr
  inputs: [gbuffer.position, gbuffer.normal, gbuffer.material, history.history]
  outputs: ssr [ssrRadiance, ssrGuide]

pass: ssr temporal
  draw: quad
  depth test: never
  write depth: no
  use shader: ssr-temporal
  inputs: [ssr.ssrRadiance, ssr.ssrGuide, ssrHistory.ssrHistory, gbuffer.position, gbuffer.material]
  outputs: ssrAccum [ ssrAccum ]

pass: ssr history
  draw: quad
  depth test: never
  write depth: no
  use shader: ssr-copy
  inputs: [ssrAccum.ssrAccum]
  outputs: ssrHistory [ ssrHistory ]

pass: point shadows
  draw: quad
  depth test: never
  write depth: no
  use shader: point-shadow
  inputs: [gbuffer.position, gbuffer.normal]
  outputs: pointShadow [pointShadow, pointShadowGuide]

pass: resolve
  draw: quad
  depth test: never
  write depth: no
  use shader: deferred-shade
  inputs: [gbuffer.diffuse, gbuffer.position, gbuffer.normal, gbuffer.material,
           envCube.envCube, prefiltered.prefiltered,
           irradiance.irradiance, dfg.dfg, ssgiAccum.ssgiAccum, ssgiAccum.ssgiSpecAccum,
           ssgiPrep.ssgiDepth, ssgiPrep.ssgiNormal, volumeIntegrated.volumeIntegrated,
           pointShadow.pointShadow, pointShadow.pointShadowGuide,
           ssrAccum.ssrAccum, ssr.ssrGuide]
  outputs: color [ final ]

pass: taa
  draw: quad
  depth test: never
  write depth: no
  use shader: taa
  inputs: [color.final, history.history, gbuffer.position, gbuffer.normal]
  outputs: taa [ final ]

pass: taa history
  draw: quad
  depth test: never
  write depth: no
  use shader: taa-copy
  inputs: [taa.final]
  outputs: history [ history ]

pass: tonemap
  draw: quad
  depth test: never
  write depth: no
  use shader: agx
  inputs: [taa.final]
  outputs: tonemap [ tonemap ]

pass: fireflies-overlay
  callback: draw-fireflies
  blend: additive
  outputs: tonemap [ tonemap ]

pass: probe-bake-overlay
  callback: draw-probe-bake
  blend: alpha
  outputs: tonemap [ tonemap ]

pass: blit
  draw: blit
  inputs: [tonemap.tonemap]
  outputs: visible

shader: mesh
  uniforms: [ u_material_atlas: sampler2d, u_color_atlas: sampler2d,
              u_normal_atlas: sampler2d, u_emissive_atlas: sampler2d ]
  varying:  [ posEye: vec3, normalEye: vec3, uv: vec2, primId: float ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_color: vec4 <- color,
      a_normal: vec3 <- normal,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      vec4 ep = u_modelview * vec4(a_position, 1.0);
      var.posEye = ep.xyz;
      var.normalEye = normalize(u_normalMatrix * a_normal);
      var.uv = a_uv;
      var.primId = a_color.r;
      gl_Position = u_modelviewProjection * vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    float4 ep = u_modelview * float4(a_position, 1.0);
    var.posEye = ep.xyz;
    var.normalEye = normalize(u_normalMatrix * a_normal);
    var.uv = a_uv;
    var.primId = a_color.r;
    gl_Position = u_modelviewProjection * float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    void main()
    {
      vec3 dp1 = dFdx(var.posEye);
      vec3 dp2 = dFdy(var.posEye);
      vec2 duv1 = dFdx(var.uv);
      vec2 duv2 = dFdy(var.uv);
      vec4 mat = texture(u_material_atlas, var.uv);
      if (mat.a > 0.0 && mat.b < mat.a) discard;
      vec3 albedo = texture(u_color_atlas, var.uv).rgb;
      vec3 N = normalize(var.normalEye);
      vec3 tn = texture(u_normal_atlas, var.uv).rgb * 2.0 - 1.0;
      float handedness = sign(duv1.x * duv2.y - duv2.x * duv1.y);
      vec3 T = (dp1 * duv2.y - dp2 * duv1.y) * handedness;
      vec3 B = (dp2 * duv1.x - dp1 * duv2.x) * handedness;
      T -= N * dot(N, T);
      B -= N * dot(N, B);
      float frame = max(dot(T, T), dot(B, B));
      vec3 normalEye = frame > 1e-30 ? normalize((T * tn.x + B * tn.y) * inversesqrt(frame) + N * tn.z) : N;
      vec3 emission = texture(u_emissive_atlas, var.uv).rgb;
      o_diffuse_texture = vec4(albedo, emission.b);
      o_position_texture = vec4(var.posEye, var.primId);
      o_normal_texture = vec4(normalEye, 1.0);
      o_material_texture = vec4(mat.r, mat.g, emission.r, emission.g);
    }
    ```

    source msl:
    ```msl
    float3 dp1 = dfdx(var.posEye);
    float3 dp2 = dfdy(var.posEye);
    float2 duv1 = dfdx(var.uv);
    float2 duv2 = dfdy(var.uv);
    float4 mat = texture(u_material_atlas, var.uv);
    if (mat.a > 0.0 && mat.b < mat.a) discard_fragment();
    float3 albedo = texture(u_color_atlas, var.uv).rgb;
    float3 N = normalize(var.normalEye);
    float3 tn = texture(u_normal_atlas, var.uv).rgb * 2.0 - 1.0;
    float handedness = sign(duv1.x * duv2.y - duv2.x * duv1.y);
    float3 T = (dp1 * duv2.y - dp2 * duv1.y) * handedness;
    float3 B = (dp2 * duv1.x - dp1 * duv2.x) * handedness;
    T -= N * dot(N, T);
    B -= N * dot(N, B);
    float frame = max(dot(T, T), dot(B, B));
    float3 normalEye = frame > 1e-30 ? normalize((T * tn.x + B * tn.y) * rsqrt(frame) + N * tn.z) : N;
    float3 emission = texture(u_emissive_atlas, var.uv).rgb;
    o_diffuse_texture = float4(albedo, emission.b);
    o_position_texture = float4(var.posEye, var.primId);
    o_normal_texture = float4(normalEye, 1.0);
    o_material_texture = float4(mat.r, mat.g, emission.r, emission.g);
    ```

shader: deferred-shade
  uniforms: [ u_normal_texture: sampler2d,
              u_position_texture: sampler2d,
              u_diffuse_texture: sampler2d,
              u_material_texture: sampler2d,
              u_envCube_texture: samplerCube,
              u_prefiltered_texture: samplerCube,
              u_irradiance_texture: samplerCube,
              u_dfg_texture: sampler2d,
              u_shadow_atlas: usampler2DArray,
              u_shadow_data: sampler2d,
              u_shadow_pagetable: sampler2d,
              u_view: mat4 <- auto-view-matrix,
              u_iblEnabled: float,
              u_invProj: mat4,
              sunHeight: float,
              u_zUp: float,
              u_sunDirection: vec4,
              u_shadowEnabled: float,
              u_shadowLevelCount: float,
              u_shadowBias: vec4,
              u_eyeToLightRotation: mat4,
              u_directionalRefOffset: vec4,
              u_shadowLodRange: vec4,
              u_punctualShadowEnabled: float,
              u_pointLightCount: float,
              u_pointLightPosIntensity0: vec4,
              u_pointLightPosIntensity1: vec4,
              u_pointLightPosIntensity2: vec4,
              u_pointLightPosIntensity3: vec4,
              u_pointLightColorRadius0: vec4,
              u_pointLightColorRadius1: vec4,
              u_pointLightColorRadius2: vec4,
              u_pointLightColorRadius3: vec4,
              u_ssgiAccum_texture: sampler2d,
              u_ssgiSpecAccum_texture: sampler2d,
              u_ssgiDepth_texture: sampler2d,
              u_ssgiNormal_texture: sampler2d,
              u_ssgi: vec4,
              u_pointShadow_texture: sampler2d,
              u_pointShadowGuide_texture: sampler2d,
              u_volumeIntegrated_texture: sampler2d,
              u_volume: vec4,
              u_volumeRange: vec4,
              u_ssrAccum_texture: sampler2d,
              u_ssrGuide_texture: sampler2d,
              u_ssr: vec4,
              u_horizonScan: vec4,
              u_probe_volume: sampler2d,
              u_probe_sphere: sampler2d,
              u_probe_info: sampler2d,
              u_probeGridMin: vec4,
              u_probeGridMax: vec4,
              u_probeGridSize: vec4,
              frameIndex: int ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    const float PI = 3.14159265358979;
    const float LIGHT_INTENSITY = 3.0;
    const float MOON_INTENSITY = 0.12;

    vec3 F_Schlick(vec3 f0, float VoH)
    {
      float f = pow(1.0 - VoH, 5.0);
      return f + f0 * (1.0 - f);
    }

    float D_GGX(float roughness, float NoH)
    {
      float a = NoH * roughness;
      float k = min(roughness / (1.0 - NoH * NoH + a * a), 453.5);
      return k * k * (1.0 / PI);
    }

    float V_SmithGGXCorrelatedFast(float roughness, float NoV, float NoL)
    {
      return 0.5 / mix(2.0 * NoL * NoV, NoL + NoV, roughness);
    }

    vec3 toSkySpace(vec3 v)
    {
      return mix(v, vec3(v.x, v.z, -v.y), u_zUp);
    }

    int shadowLevelSlot(int i)
    {
      return int(texelFetch(u_shadow_data, ivec2(4, 24 + i), 0).x);
    }

    vec3 shadowLevelDepth(int i)
    {
      return texelFetch(u_shadow_data, ivec2(5, 24 + i), 0).xyz;
    }

    vec2 shadowLevelTileOffset(int i)
    {
      return texelFetch(u_shadow_data, ivec2(4, 24 + i), 0).yz;
    }

    int directionalLevelIndex(vec3 posEye)
    {
      bool isClipmap = u_shadowLodRange.z > 0.5;
      int lodMin = int(u_shadowLodRange.x);
      int lodMax = int(u_shadowLodRange.y);
      vec3 delta = (u_eyeToLightRotation * vec4(posEye, 0.0)).xyz - u_directionalRefOffset.xyz;
      float lod;
      if (isClipmap) {
        float narrowing = 32.0 / (32.0 - 1.0001);
        lod = log2(length(delta) * narrowing * 2.0);
      } else {
        float narrowing = 32.0 / (32.0 - 2.5001);
        float lodMinMinusOne = float(lodMin - 1);
        float lodMinHalfSize = exp2(lodMinMinusOne);
        lod = length(delta.xy) * narrowing / lodMinHalfSize + lodMinMinusOne;
      }
      lod += u_shadowLodRange.w;
      int level = clamp(int(ceil(lod)), lodMin, lodMax);
      return level - lodMin;
    }

    float directionalTap(vec2 tapTileFloat, ivec2 tile, vec4 pageInfo, int slot,
                         inout ivec2 cacheTile, inout vec4 cachePage)
    {
      ivec2 tapTile = clamp(ivec2(floor(tapTileFloat)), ivec2(0), ivec2(31));
      if (tapTile != cacheTile) {
        cachePage = tapTile == tile
            ? pageInfo
            : texelFetch(u_shadow_pagetable, ivec2(tapTile.y * 32 + tapTile.x, slot), 0);
        cacheTile = tapTile;
      }
      vec4 tapPage = cachePage;
      vec2 frac = fract(tapTileFloat);
      if (tapPage.z < 0.5) {
        tapPage = pageInfo;
        frac = clamp(tapTileFloat - vec2(tile), 0.0, 0.999999);
      }
      uint v = texelFetch(u_shadow_atlas, ivec3(int(tapPage.y) * 256 + int(frac.x * 256.0),
                                                int(frac.y * 256.0), int(tapPage.x)), 0).r;
      return v == 0xFFFFFFFFu ? 1.0 : uintBitsToFloat(v);
    }

    float directionalShadow(vec3 posEye, vec3 normalEye, float NoL, vec2 noise)
    {
      if (u_shadowEnabled < 0.5) return 1.0;

      int levelCount = int(u_shadowLevelCount);
      int i = directionalLevelIndex(posEye);
      if (i < 0) return 1.0;

      vec3 lightDelta = (u_eyeToLightRotation * vec4(posEye, 0.0)).xyz - u_directionalRefOffset.xyz;
      int lodMin = int(u_shadowLodRange.x);
      int lodMax = int(u_shadowLodRange.y);
      float scale = clamp(length(lightDelta) * 2.0, exp2(float(lodMin)), exp2(float(lodMax)));
      float sinTheta = sqrt(max(1.0 - NoL * NoL, 0.0));
      float levelSize;
      vec3 biasedPosEye;
      vec2 tileFloat;
      ivec2 tile;
      int slot;
      vec4 pageInfo = vec4(0.0);
      for (int k = 0; k < levelCount; ++k, ++i) {
        if (i >= levelCount) return 1.0;
        levelSize = exp2(u_shadowLodRange.x + float(i));
        float texelWorldSize = 1.41421356 / 8192.0 * levelSize;
        biasedPosEye = posEye + normalEye * (texelWorldSize * (sinTheta + u_shadowBias.y));
        float radius = levelSize * 0.5;
        vec3 lightRel = (u_eyeToLightRotation * vec4(biasedPosEye, 0.0)).xyz;
        vec2 lightXY = lightRel.xy + shadowLevelTileOffset(i);
        vec2 ndcXY = lightXY / radius;
        tileFloat = (ndcXY * 0.5 + 0.5) * 32.0;
        if (any(lessThan(tileFloat, vec2(0.0))) || any(greaterThanEqual(tileFloat, vec2(32.0)))) { continue; }
        tile = ivec2(tileFloat);
        slot = shadowLevelSlot(i);
        pageInfo = texelFetch(u_shadow_pagetable, ivec2(tile.y * 32 + tile.x, slot), 0);
        if (pageInfo.z > 0.5) break;
      }
      if (pageInfo.z < 0.5) return 1.0;

      vec3 lightRelZ = (u_eyeToLightRotation * vec4(biasedPosEye, 0.0)).xyz;
      vec3 levelDepth = shadowLevelDepth(i);
      float ndcZ = (lightRelZ.z + levelDepth.x) * levelDepth.y + levelDepth.z;
      float compareDepth = ndcZ * 0.5 + 0.5 - u_shadowBias.x;

      float tileTexelStep = 1.5 / 256.0 * clamp(scale * (32.0 / (32.0 - 1.0001)) / levelSize, 0.5, 1.0);

      float tileWorld = levelSize / 32.0;
      float tanHalf = tan(u_sunDirection.w);
      float depthPerWorld = abs(0.5 * levelDepth.y);
      float reach = tileWorld / max(tanHalf, 1e-3);
      float aa = tileTexelStep * tileWorld;
      vec3 normalLight = (u_eyeToLightRotation * vec4(normalEye, 0.0)).xyz;
      float nz = normalLight.z < 0.0 ? min(normalLight.z, -0.05) : max(normalLight.z, 0.05);
      vec2 planeSlope = normalLight.xy * (-0.5 * levelDepth.y / nz);
      float lit = 0.0;
      ivec2 cacheTile = tile;
      vec4 cachePage = pageInfo;
      for (int r = 0; r < 2; ++r) {
        float phi = 6.2831853 * fract(noise.x + 0.618034 * float(r));
        vec2 disk = vec2(cos(phi), sin(phi)) * sqrt(fract(noise.y + 0.754877 * float(r)));
        float jitter = fract(noise.x + noise.y + 0.5698403 * float(r));
        float plane = dot(planeSlope, disk) * aa;
        float visible = 1.0;
        bool covered = false;
        for (int k = 0; k < 6; ++k) {
          float f = k == 0 ? 0.0 : (float(k) - 1.0 + jitter) / 5.0;
          float t = reach * f * f;
          float fNext = (float(k) + jitter) / 5.0;
          float span = k == 5 ? 1e30 : (reach * fNext * fNext - t) * depthPerWorld;
          vec2 offset = disk * (aa + tanHalf * t);
          float occluder = directionalTap(tileFloat + offset / tileWorld, tile, pageInfo, slot, cacheTile, cachePage);
          float behind = compareDepth + plane - t * depthPerWorld - occluder;
          float lift = compareDepth + dot(planeSlope, offset) - occluder;
          if ((behind > 0.0 && behind < span)
              || (covered && behind <= 0.0 && lift > (2.0 * aa + 0.05 * t) * depthPerWorld)) {
            visible = 0.0;
            break;
          }
          covered = covered || behind >= span;
        }
        lit += visible;
      }
      return lit * 0.5;
    }

    vec4 pointLightPosIntensity(int i)
    {
      vec4 v = u_pointLightPosIntensity0;
      if (i == 1)      v = u_pointLightPosIntensity1;
      else if (i == 2) v = u_pointLightPosIntensity2;
      else if (i == 3) v = u_pointLightPosIntensity3;
      return v;
    }

    vec4 pointLightColorRadius(int i)
    {
      vec4 v = u_pointLightColorRadius0;
      if (i == 1)      v = u_pointLightColorRadius1;
      else if (i == 2) v = u_pointLightColorRadius2;
      else if (i == 3) v = u_pointLightColorRadius3;
      return v;
    }

    float sphereIrradiance(float cosTheta, float sinSigmaSqr)
    {
      if (cosTheta * cosTheta > sinSigmaSqr) return PI * sinSigmaSqr * max(cosTheta, 0.0);
      float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 1e-6));
      float x = sqrt(1.0 / sinSigmaSqr - 1.0);
      float y = clamp(-x * (cosTheta / sinTheta), -1.0, 1.0);
      float sinThetaSqrtY = sinTheta * sqrt(1.0 - y * y);
      return max((cosTheta * acos(y) - x * sinThetaSqrtY) * sinSigmaSqr + atan(sinThetaSqrtY / x), 0.0);
    }

    vec3 finiteColor(vec3 c)
    {
      bvec3 bad = equal(floatBitsToUint(c) & 0x7F800000u, uvec3(0x7F800000u));
      return mix(clamp(c, 0.0, 65000.0), vec3(0.0), bad);
    }

    vec4 volumeBoundary(int b, vec2 f, vec2 grid, vec2 atlasSize)
    {
      if (b == 0) return vec4(0.0, 0.0, 0.0, 1.0);
      vec2 origin = vec2(float((b - 1) % 8), float((b - 1) / 8)) * grid;
      return texture(u_volumeIntegrated_texture, (origin + f) / atlasSize);
    }

    vec4 volumeFog(vec2 fragCoord, float viewDepth)
    {
      if (u_volume.z < 0.5) return vec4(0.0, 0.0, 0.0, 1.0);
      vec2 atlasSize = vec2(textureSize(u_volumeIntegrated_texture, 0));
      vec2 grid = u_volumeRange.zw;
      vec2 f = clamp(fragCoord / 16.0, vec2(0.5), grid - 0.5);
      float u = sqrt(clamp((viewDepth - u_volumeRange.x) / (u_volumeRange.y - u_volumeRange.x), 0.0, 1.0)) * 64.0;
      int b = min(int(u), 63);
      return mix(volumeBoundary(b, f, grid, atlasSize), volumeBoundary(b + 1, f, grid, atlasSize), u - float(b));
    }

    vec4 ssgiUpsample(sampler2D accum, ivec2 pixel, vec3 posEye, vec3 normalEye)
    {
      if (u_ssgi.z < 0.5) return vec4(0.0, 0.0, 0.0, 1.0);
      ivec2 halfSize = textureSize(accum, 0);
      vec2 hc = (vec2(pixel) + 0.5) * 0.5 - 0.5;
      ivec2 base = ivec2(floor(hc));
      vec2 f = hc - vec2(base);
      vec4 sum = vec4(0.0);
      float weight = 0.0;
      for (int i = 0; i < 4; ++i) {
        ivec2 o = ivec2(i & 1, i >> 1);
        ivec2 h = clamp(base + o, ivec2(0), halfSize - 1);
        float bilinear = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float dz = abs(texelFetch(u_ssgiDepth_texture, h, 0).x - posEye.z);
        float w = bilinear * exp(-dz / max(0.02 * abs(posEye.z), 1e-3))
                * pow(max(dot(texelFetch(u_ssgiNormal_texture, h, 0).xyz, normalEye), 0.0), 8.0) + 1e-4 * bilinear;
        sum += texelFetch(accum, h, 0) * w;
        weight += w;
      }
      return sum / weight;
    }

    vec4 pointShadowUpsample(ivec2 pixel, vec3 posEye, vec3 normalEye)
    {
      if (u_punctualShadowEnabled < 0.5) return vec4(1.0);
      ivec2 halfSize = textureSize(u_pointShadow_texture, 0);
      vec2 hc = (vec2(pixel) + 0.5) * 0.5 - 0.5;
      ivec2 base = ivec2(floor(hc));
      vec2 f = hc - vec2(base);
      vec4 sum = vec4(0.0);
      float weight = 0.0;
      for (int i = 0; i < 4; ++i) {
        ivec2 o = ivec2(i & 1, i >> 1);
        ivec2 h = clamp(base + o, ivec2(0), halfSize - 1);
        vec4 guide = texelFetch(u_pointShadowGuide_texture, h, 0);
        float bilinear = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float w = bilinear * exp(-abs(guide.w - posEye.z) / max(0.02 * abs(posEye.z), 1e-3))
                * pow(max(dot(guide.xyz, normalEye), 0.0), 8.0) + 1e-4 * bilinear;
        sum += texelFetch(u_pointShadow_texture, h, 0) * w;
        weight += w;
      }
      return sum / weight;
    }

    vec4 ssrUpsample(ivec2 pixel, vec3 posEye, vec3 normalEye)
    {
      if (u_ssr.z < 0.5) return vec4(0.0);
      ivec2 halfSize = textureSize(u_ssrAccum_texture, 0);
      vec2 hc = (vec2(pixel) + 0.5) * 0.5 - 0.5;
      ivec2 base = ivec2(floor(hc));
      vec2 f = hc - vec2(base);
      vec4 sum = vec4(0.0);
      float weight = 0.0;
      for (int i = 0; i < 4; ++i) {
        ivec2 o = ivec2(i & 1, i >> 1);
        ivec2 h = clamp(base + o, ivec2(0), halfSize - 1);
        vec4 guide = texelFetch(u_ssrGuide_texture, h, 0);
        float bilinear = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float w = bilinear * exp(-abs(guide.w - posEye.z) / max(0.02 * abs(posEye.z), 1e-3))
                * pow(max(dot(guide.xyz, normalEye), 0.0), 8.0);
        sum += texelFetch(u_ssrAccum_texture, h, 0) * w;
        weight += w;
      }
      if (weight < 1e-4 || sum.a < 1e-4) return vec4(0.0);
      return vec4(sum.rgb / sum.a, sum.a / weight * clamp(weight * 10.0, 0.0, 1.0));
    }

    vec3 pointLightRadiance(vec3 worldPos, vec3 N, vec3 V, float NoV,
                            float roughness, vec3 f0, vec3 diffuseColor, vec4 shadows)
    {
      vec3 color = vec3(0.0);
      int count = int(min(u_pointLightCount, 4.0));
      for (int i = 0; i < count; ++i) {
        vec4 posIntensity = pointLightPosIntensity(i);
        vec4 colorRadius = pointLightColorRadius(i);

        vec3 toLight = posIntensity.xyz - worldPos;
        float distSq = max(dot(toLight, toLight), colorRadius.w * colorRadius.w);
        vec3 L = normalize(toLight);
        float cosTheta = dot(N, L);
        float sinSigmaSqr = min(colorRadius.w * colorRadius.w / distSq, 0.9999);
        float irradiance = sphereIrradiance(cosTheta, sinSigmaSqr);
        if (irradiance <= 0.0) continue;

        float NoL = max(cosTheta, 0.0);
        vec3 R = reflect(-V, N);
        vec3 centerToRay = dot(toLight, R) * R - toLight;
        vec3 Ls = normalize(toLight + centerToRay
                            * clamp(colorRadius.w / max(length(centerToRay), 1e-6), 0.0, 1.0));
        float NoLs = max(dot(N, Ls), 0.0);
        float widened = clamp(roughness + colorRadius.w / (2.0 * sqrt(distSq)), 0.0, 1.0);
        float normalization = (roughness / widened) * (roughness / widened);

        vec3 H = normalize(V + Ls);
        float NoH = max(dot(N, H), 0.0);
        float LoH = max(dot(Ls, H), 0.0);
        float D = D_GGX(roughness, NoH);
        float Vis = V_SmithGGXCorrelatedFast(roughness, NoV, max(NoLs, 1e-4));
        vec3 F = F_Schlick(f0, LoH);

        vec3 kD = vec3(1.0) - F;
        vec3 Fr = D * Vis * F * (PI * sinSigmaSqr * NoLs * normalization);
        vec3 Fd = (kD * diffuseColor / PI) * irradiance;

        color += (Fd + Fr) * colorRadius.xyz * posIntensity.w * shadows[i];
      }
      return color;
    }

    void main()
    {
      ivec2 gbufferPixel = ivec2(gl_FragCoord.xy);
      vec4 normalSample = texelFetch(u_normal_texture, gbufferPixel, 0);
      vec3 normalEye = normalSample.xyz;
      vec3 posEye = texelFetch(u_position_texture, gbufferPixel, 0).xyz;
      vec3 diffuse = texelFetch(u_diffuse_texture, gbufferPixel, 0).xyz;
      vec2 materialSample = texelFetch(u_material_texture, gbufferPixel, 0).rg;

      mat4 invViewFull = inverse(u_view);
      mat3 invView = mat3(invViewFull);
      vec3 worldPos = (invViewFull * vec4(posEye, 1.0)).xyz;

      if (normalSample.a < 0.5) {
        if (u_iblEnabled > 0.5) {
          vec4 e = u_invProj * vec4(var.texCoord * 2.0 - 1.0, 1.0, 1.0);
          vec3 worldDir = normalize(invView * (e.xyz / e.w));
          vec3 sky = texture(u_envCube_texture, toSkySpace(worldDir)).rgb;
          vec4 fog = volumeFog(gl_FragCoord.xy, u_volumeRange.y);
          o_final_texture = vec4(sky * fog.a + fog.rgb, 1.0);
        } else {
          o_final_texture = vec4(diffuse, 1.0);
        }
        return;
      }

      vec3 N = normalize(invView * normalEye);
      vec3 V = normalize(invView * (-posEye));
      float NoV = max(dot(N, V), 1e-4);

      float perceptualRoughness = clamp(materialSample.r, 0.045, 1.0);
      float roughness = perceptualRoughness * perceptualRoughness;
      float metallic = clamp(materialSample.g, 0.0, 1.0);
      vec3 baseColor = diffuse;
      vec3 f0 = mix(vec3(0.04), baseColor, metallic);
      vec3 diffuseColor = baseColor * (1.0 - metallic);

      vec3 L = normalize(u_sunDirection.xyz);
      float nightFade = smoothstep(-0.3, 0.05, sunHeight);

      vec2 noisePixel = gl_FragCoord.xy + 5.588238 * float(frameIndex % 64);
      float noise = fract(52.9829189 * fract(dot(noisePixel, vec2(0.06711056, 0.00583715))));
      float noiseB = fract(52.9829189 * fract(dot(noisePixel.yx, vec2(0.06711056, 0.00583715))));

      vec3 color = vec3(0.0);
      float cosTheta = dot(N, L);
      float sinSigma = sin(u_sunDirection.w);
      float sinSigmaSqr = max(sinSigma * sinSigma, 1e-7);
      float sunIrradiance = sphereIrradiance(cosTheta, sinSigmaSqr) / (PI * sinSigmaSqr);
      if (sunIrradiance > 0.0) {
        float NoL = max(cosTheta, 0.0);
        float tanSigma = tan(u_sunDirection.w);
        vec3 R = reflect(-V, N);
        vec3 centerToRay = dot(L, R) * R - L;
        vec3 Ls = normalize(L + centerToRay * clamp(tanSigma / max(length(centerToRay), 1e-6), 0.0, 1.0));
        float NoLs = max(dot(N, Ls), 0.0);
        float widened = clamp(roughness + 0.5 * tanSigma, 0.0, 1.0);
        float normalization = (roughness / widened) * (roughness / widened);

        vec3 H = normalize(V + Ls);
        float NoH = max(dot(N, H), 0.0);
        float LoH = max(dot(Ls, H), 0.0);
        float D = D_GGX(roughness, NoH);

        float Vis = V_SmithGGXCorrelatedFast(roughness, NoV, max(NoLs, 1e-4));
        vec3 F = F_Schlick(f0, LoH);

        vec3 kD = vec3(1.0) - F;
        vec3 Fr = D * Vis * F * NoLs * normalization;
        vec3 Fd = (kD * diffuseColor / PI) * sunIrradiance;

        vec3 skyL = toSkySpace(L);
        vec3 dayColor = mix(texture(u_envCube_texture, skyL).rgb, vec3(1.0), clamp(sunHeight, 0.0, 1.0));
        vec3 nightColor = mix(texture(u_envCube_texture, skyL).rgb, vec3(0.95, 0.95, 1.00), clamp(-sunHeight, 0.0, 1.0));
        vec3 dynamicSky = mix(nightColor * MOON_INTENSITY, dayColor * LIGHT_INTENSITY, nightFade);

        float shadow = directionalShadow(posEye, normalEye, NoL, vec2(noise, noiseB));

        color += (Fd + Fr) * dynamicSky * shadow;
      }

      color += pointLightRadiance(worldPos, N, V, NoV, roughness, f0, diffuseColor,
                                  pointShadowUpsample(gbufferPixel, posEye, normalEye));

      vec2 dfgTexel = 0.5 / vec2(textureSize(u_dfg_texture, 0));
      vec3 dfg = texture(u_dfg_texture, clamp(vec2(NoV, perceptualRoughness), dfgTexel, 1.0 - dfgTexel)).rgb;
      vec3 E = f0 * dfg.x + dfg.y;
      vec3 energyCompensation = 1.0 + f0 * (1.0 / max(dfg.x + dfg.y, 1e-4) - 1.0);

      vec3 r = reflect(-V, N);
      r = mix(r, N, roughness * roughness);

      float lod = 5.0 * perceptualRoughness * (2.0 - perceptualRoughness);
      lod = clamp(lod, 0.0, 5.0);

      vec3 prefilteredRadiance = textureLod(u_prefiltered_texture, toSkySpace(r), lod).rgb;

      vec4 gi = ssgiUpsample(u_ssgiAccum_texture, gbufferPixel, posEye, normalEye);
      float specularOcclusion = clamp(pow(NoV + gi.a, exp2(-16.0 * roughness - 1.0)) - 1.0 + gi.a, 0.0, 1.0);
      vec3 irradiance = texture(u_irradiance_texture, toSkySpace(N)).rgb;
      vec3 Fd = diffuseColor * irradiance * gi.a * (1.0 - E);

      vec4 reflection = ssrUpsample(gbufferPixel, posEye, normalEye);
      vec3 traced = mix(prefilteredRadiance * specularOcclusion * u_iblEnabled, reflection.rgb, reflection.a);
      vec4 horizon = ssgiUpsample(u_ssgiSpecAccum_texture, gbufferPixel, posEye, normalEye);
      float horizonMix = u_horizonScan.y * clamp((perceptualRoughness - u_horizonScan.x) / 0.2, 0.0, 1.0);
      vec3 Fr = E * energyCompensation
              * mix(traced, horizon.rgb + prefilteredRadiance * horizon.a * u_iblEnabled, horizonMix);

      color += Fd * u_iblEnabled + Fr + diffuseColor * gi.rgb * (1.0 - E);

      color += vec3(texelFetch(u_material_texture, gbufferPixel, 0).ba,
                    texelFetch(u_diffuse_texture, gbufferPixel, 0).w);

      vec4 fog = volumeFog(gl_FragCoord.xy, -posEye.z);
      color = color * fog.a + fog.rgb;

      o_final_texture = vec4(finiteColor(color), 1.0);
    }
    ```

    source msl:
    ```msl
    constexpr constant float PI = 3.14159265358979;
    constexpr constant float LIGHT_INTENSITY = 3.0;
    constexpr constant float MOON_INTENSITY = 0.12;

    float3 F_Schlick(float3 f0, float VoH)
    {
      float f = pow(1.0 - VoH, 5.0);
      return f + f0 * (1.0 - f);
    }

    float D_GGX(float roughness, float NoH)
    {
      float a = NoH * roughness;
      float k = min(roughness / (1.0 - NoH * NoH + a * a), 453.5);
      return k * k * (1.0 / PI);
    }

    float V_SmithGGXCorrelatedFast(float roughness, float NoV, float NoL)
    {
      return 0.5 / mix(2.0 * NoL * NoV, NoL + NoV, roughness);
    }

    float3 toSkySpace(float3 v, float zUp)
    {
      return mix(v, float3(v.x, v.z, -v.y), zUp);
    }

    int shadowLevelSlot(int i, texture2d<float> dataTex)
    {
      return int(dataTex.read(uint2(4, 24 + i)).x);
    }

    float3 shadowLevelDepth(int i, texture2d<float> dataTex)
    {
      return dataTex.read(uint2(5, 24 + i)).xyz;
    }

    float2 shadowLevelTileOffset(int i, texture2d<float> dataTex)
    {
      return dataTex.read(uint2(4, 24 + i)).yz;
    }

    int directionalLevelIndex(float3 posEye, constant Uniforms& u)
    {
      bool isClipmap = u.u_shadowLodRange.z > 0.5;
      int lodMin = int(u.u_shadowLodRange.x);
      int lodMax = int(u.u_shadowLodRange.y);
      float3 delta = (u.u_eyeToLightRotation * float4(posEye, 0.0)).xyz - u.u_directionalRefOffset.xyz;
      float lod;
      if (isClipmap) {
        float narrowing = 32.0 / (32.0 - 1.0001);
        lod = log2(length(delta) * narrowing * 2.0);
      } else {
        float narrowing = 32.0 / (32.0 - 2.5001);
        float lodMinMinusOne = float(lodMin - 1);
        float lodMinHalfSize = exp2(lodMinMinusOne);
        lod = length(delta.xy) * narrowing / lodMinHalfSize + lodMinMinusOne;
      }
      lod += u.u_shadowLodRange.w;
      int level = clamp(int(ceil(lod)), lodMin, lodMax);
      return level - lodMin;
    }

    float directionalTap(float2 tapTileFloat, int2 tile, float4 pageInfo, int slot,
                         thread int2& cacheTile, thread float4& cachePage,
                         texture2d_array<uint> atlasTex, texture2d<float> pageTableTex)
    {
      int2 tapTile = clamp(int2(floor(tapTileFloat)), int2(0), int2(31));
      if (any(tapTile != cacheTile)) {
        cachePage = all(tapTile == tile)
            ? pageInfo
            : pageTableTex.read(uint2(tapTile.y * 32 + tapTile.x, slot));
        cacheTile = tapTile;
      }
      float4 tapPage = cachePage;
      float2 frac = fract(tapTileFloat);
      if (tapPage.z < 0.5) {
        tapPage = pageInfo;
        frac = clamp(tapTileFloat - float2(tile), 0.0, 0.999999);
      }
      uint v = atlasTex.read(uint2(uint(tapPage.y) * 256u + uint(frac.x * 256.0), uint(frac.y * 256.0)),
                             uint(tapPage.x)).r;
      return v == 0xFFFFFFFFu ? 1.0 : as_type<float>(v);
    }

    float directionalShadow(float3 posEye, float3 normalEye, float NoL, float2 noise,
                            texture2d_array<uint> atlasTex, sampler atlasSmp,
                            texture2d<float> dataTex,
                            texture2d<float> pageTableTex,
                            constant Uniforms& u)
    {
      if (u.u_shadowEnabled < 0.5) return 1.0;

      int levelCount = int(u.u_shadowLevelCount);
      int i = directionalLevelIndex(posEye, u);
      if (i < 0) return 1.0;

      float3 lightDelta = (u.u_eyeToLightRotation * float4(posEye, 0.0)).xyz - u.u_directionalRefOffset.xyz;
      int lodMin = int(u.u_shadowLodRange.x);
      int lodMax = int(u.u_shadowLodRange.y);
      float scale = clamp(length(lightDelta) * 2.0, exp2(float(lodMin)), exp2(float(lodMax)));
      float sinTheta = sqrt(max(1.0 - NoL * NoL, 0.0));
      float levelSize;
      float3 biasedPosEye;
      float2 tileFloat;
      int2 tile;
      int slot;
      float4 pageInfo = float4(0.0);
      for (int k = 0; k < levelCount; ++k, ++i) {
        if (i >= levelCount) return 1.0;
        levelSize = exp2(u.u_shadowLodRange.x + float(i));
        float texelWorldSize = 1.41421356 / 8192.0 * levelSize;
        biasedPosEye = posEye + normalEye * (texelWorldSize * (sinTheta + u.u_shadowBias.y));
        float radius = levelSize * 0.5;
        float3 lightRel = (u.u_eyeToLightRotation * float4(biasedPosEye, 0.0)).xyz;
        float2 lightXY = lightRel.xy + shadowLevelTileOffset(i, dataTex);
        float2 ndcXY = lightXY / radius;
        tileFloat = (ndcXY * 0.5 + 0.5) * 32.0;
        if (any(tileFloat < float2(0.0)) || any(tileFloat >= float2(32.0))) { continue; }
        tile = int2(tileFloat);
        slot = shadowLevelSlot(i, dataTex);
        pageInfo = pageTableTex.read(uint2(tile.y * 32 + tile.x, slot));
        if (pageInfo.z > 0.5) break;
      }
      if (pageInfo.z < 0.5) return 1.0;

      float3 lightRelZ = (u.u_eyeToLightRotation * float4(biasedPosEye, 0.0)).xyz;
      float3 levelDepth = shadowLevelDepth(i, dataTex);
      float ndcZ = (lightRelZ.z + levelDepth.x) * levelDepth.y + levelDepth.z;
      float compareDepth = ndcZ * 0.5 + 0.5 - u.u_shadowBias.x;

      float tileTexelStep = 1.5 / 256.0 * clamp(scale * (32.0 / (32.0 - 1.0001)) / levelSize, 0.5, 1.0);

      float tileWorld = levelSize / 32.0;
      float tanHalf = tan(u.u_sunDirection.w);
      float depthPerWorld = abs(0.5 * levelDepth.y);
      float reach = tileWorld / max(tanHalf, 1e-3);
      float aa = tileTexelStep * tileWorld;
      float3 normalLight = (u.u_eyeToLightRotation * float4(normalEye, 0.0)).xyz;
      float nz = normalLight.z < 0.0 ? min(normalLight.z, -0.05) : max(normalLight.z, 0.05);
      float2 planeSlope = normalLight.xy * (-0.5 * levelDepth.y / nz);
      float lit = 0.0;
      int2 cacheTile = tile;
      float4 cachePage = pageInfo;
      for (int r = 0; r < 2; ++r) {
        float phi = 6.2831853 * fract(noise.x + 0.618034 * float(r));
        float2 disk = float2(cos(phi), sin(phi)) * sqrt(fract(noise.y + 0.754877 * float(r)));
        float jitter = fract(noise.x + noise.y + 0.5698403 * float(r));
        float plane = dot(planeSlope, disk) * aa;
        float visible = 1.0;
        bool covered = false;
        for (int k = 0; k < 6; ++k) {
          float f = k == 0 ? 0.0 : (float(k) - 1.0 + jitter) / 5.0;
          float t = reach * f * f;
          float fNext = (float(k) + jitter) / 5.0;
          float span = k == 5 ? 1e30 : (reach * fNext * fNext - t) * depthPerWorld;
          float2 offset = disk * (aa + tanHalf * t);
          float occluder = directionalTap(tileFloat + offset / tileWorld, tile, pageInfo, slot, cacheTile, cachePage,
                                          atlasTex, pageTableTex);
          float behind = compareDepth + plane - t * depthPerWorld - occluder;
          float lift = compareDepth + dot(planeSlope, offset) - occluder;
          if ((behind > 0.0 && behind < span)
              || (covered && behind <= 0.0 && lift > (2.0 * aa + 0.05 * t) * depthPerWorld)) {
            visible = 0.0;
            break;
          }
          covered = covered || behind >= span;
        }
        lit += visible;
      }
      return lit * 0.5;
    }

    float4 pointLightPosIntensity(int i, constant Uniforms& u)
    {
      float4 v = u.u_pointLightPosIntensity0;
      if (i == 1)      v = u.u_pointLightPosIntensity1;
      else if (i == 2) v = u.u_pointLightPosIntensity2;
      else if (i == 3) v = u.u_pointLightPosIntensity3;
      return v;
    }

    float4 pointLightColorRadius(int i, constant Uniforms& u)
    {
      float4 v = u.u_pointLightColorRadius0;
      if (i == 1)      v = u.u_pointLightColorRadius1;
      else if (i == 2) v = u.u_pointLightColorRadius2;
      else if (i == 3) v = u.u_pointLightColorRadius3;
      return v;
    }

    float sphereIrradiance(float cosTheta, float sinSigmaSqr)
    {
      if (cosTheta * cosTheta > sinSigmaSqr) return PI * sinSigmaSqr * max(cosTheta, 0.0);
      float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 1e-6));
      float x = sqrt(1.0 / sinSigmaSqr - 1.0);
      float y = clamp(-x * (cosTheta / sinTheta), -1.0, 1.0);
      float sinThetaSqrtY = sinTheta * sqrt(1.0 - y * y);
      return max((cosTheta * acos(y) - x * sinThetaSqrtY) * sinSigmaSqr + atan(sinThetaSqrtY / x), 0.0);
    }

    float3 finiteColor(float3 c)
    {
      bool3 bad = (as_type<uint3>(c) & 0x7F800000u) == 0x7F800000u;
      return select(clamp(c, 0.0, 65000.0), float3(0.0), bad);
    }

    float4 volumeBoundary(int b, float2 f, float2 grid, float2 atlasSize,
                          texture2d<float> integrated, sampler integratedSmp)
    {
      if (b == 0) return float4(0.0, 0.0, 0.0, 1.0);
      float2 origin = float2(float((b - 1) % 8), float((b - 1) / 8)) * grid;
      return integrated.sample(integratedSmp, (origin + f) / atlasSize);
    }

    float4 volumeFog(float2 fragCoord, float viewDepth,
                     texture2d<float> integrated, sampler integratedSmp, constant Uniforms& u)
    {
      if (u.u_volume.z < 0.5) return float4(0.0, 0.0, 0.0, 1.0);
      float2 atlasSize = float2(integrated.get_width(), integrated.get_height());
      float2 grid = u.u_volumeRange.zw;
      float2 f = clamp(fragCoord / 16.0, float2(0.5), grid - 0.5);
      float t = sqrt(saturate((viewDepth - u.u_volumeRange.x) / (u.u_volumeRange.y - u.u_volumeRange.x))) * 64.0;
      int b = min(int(t), 63);
      return mix(volumeBoundary(b, f, grid, atlasSize, integrated, integratedSmp),
                 volumeBoundary(b + 1, f, grid, atlasSize, integrated, integratedSmp), t - float(b));
    }

    float4 ssgiUpsample(uint2 pixel, float3 posEye, float3 normalEye,
                        texture2d<float> accum, texture2d<float> depth, texture2d<float> normal,
                        constant Uniforms& u)
    {
      if (u.u_ssgi.z < 0.5) return float4(0.0, 0.0, 0.0, 1.0);
      int2 halfSize = int2(accum.get_width(), accum.get_height());
      float2 hc = (float2(pixel) + 0.5) * 0.5 - 0.5;
      int2 base = int2(floor(hc));
      float2 f = hc - float2(base);
      float4 sum = float4(0.0);
      float weight = 0.0;
      for (int i = 0; i < 4; ++i) {
        int2 o = int2(i & 1, i >> 1);
        uint2 h = uint2(clamp(base + o, int2(0), halfSize - 1));
        float bilinear = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float dz = abs(depth.read(h).x - posEye.z);
        float w = bilinear * exp(-dz / max(0.02 * abs(posEye.z), 1e-3))
                * pow(max(dot(normal.read(h).xyz, normalEye), 0.0), 8.0) + 1e-4 * bilinear;
        sum += accum.read(h) * w;
        weight += w;
      }
      return sum / weight;
    }

    float4 pointShadowUpsample(uint2 pixel, float3 posEye, float3 normalEye,
                               texture2d<float> shadows, texture2d<float> guides, constant Uniforms& u)
    {
      if (u.u_punctualShadowEnabled < 0.5) return float4(1.0);
      int2 halfSize = int2(shadows.get_width(), shadows.get_height());
      float2 hc = (float2(pixel) + 0.5) * 0.5 - 0.5;
      int2 base = int2(floor(hc));
      float2 f = hc - float2(base);
      float4 sum = float4(0.0);
      float weight = 0.0;
      for (int i = 0; i < 4; ++i) {
        int2 o = int2(i & 1, i >> 1);
        uint2 h = uint2(clamp(base + o, int2(0), halfSize - 1));
        float4 guide = guides.read(h);
        float bilinear = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float w = bilinear * exp(-abs(guide.w - posEye.z) / max(0.02 * abs(posEye.z), 1e-3))
                * pow(max(dot(guide.xyz, normalEye), 0.0), 8.0) + 1e-4 * bilinear;
        sum += shadows.read(h) * w;
        weight += w;
      }
      return sum / weight;
    }

    float4 ssrUpsample(uint2 pixel, float3 posEye, float3 normalEye,
                       texture2d<float> radianceTex, texture2d<float> guideTex, constant Uniforms& u)
    {
      if (u.u_ssr.z < 0.5) return float4(0.0);
      int2 halfSize = int2(radianceTex.get_width(), radianceTex.get_height());
      float2 hc = (float2(pixel) + 0.5) * 0.5 - 0.5;
      int2 base = int2(floor(hc));
      float2 f = hc - float2(base);
      float4 sum = float4(0.0);
      float weight = 0.0;
      for (int i = 0; i < 4; ++i) {
        int2 o = int2(i & 1, i >> 1);
        uint2 h = uint2(clamp(base + o, int2(0), halfSize - 1));
        float4 guide = guideTex.read(h);
        float bilinear = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float w = bilinear * exp(-abs(guide.w - posEye.z) / max(0.02 * abs(posEye.z), 1e-3))
                * pow(max(dot(guide.xyz, normalEye), 0.0), 8.0);
        sum += radianceTex.read(h) * w;
        weight += w;
      }
      if (weight < 1e-4 || sum.a < 1e-4) return float4(0.0);
      return float4(sum.rgb / sum.a, sum.a / weight * saturate(weight * 10.0));
    }

    float3 probeVolumeIrradiance(float3 worldPos, float3 N, float3 fallback,
                                 texture2d<float> sh, constant Uniforms& u)
    {
      if (u.u_probeGridMin.w < 0.5) return fallback;
      int3 dims = int3(u.u_probeGridSize.xyz);
      float3 cell = (u.u_probeGridMax.xyz - u.u_probeGridMin.xyz) / float3(max(dims - 1, int3(1)));
      float3 g = (worldPos + N * u.u_probeGridSize.w - u.u_probeGridMin.xyz) / cell;
      float3 outside = max(max(-g, g - float3(dims - 1)), float3(0.0));
      float fade = saturate(1.0 - max(outside.x, max(outside.y, outside.z)));
      if (fade <= 0.0) return fallback;
      g = clamp(g, float3(0.0), float3(dims - 1));
      int3 base = min(int3(floor(g)), max(dims - 2, int3(0)));
      float3 f = g - float3(base);
      float3 l0 = float3(0.0), lx = float3(0.0), ly = float3(0.0), lz = float3(0.0);
      float weight = 0.0;
      for (int i = 0; i < 8; ++i) {
        int3 o = int3(i & 1, (i >> 1) & 1, i >> 2);
        int3 c = min(base + o, dims - 1);
        float3 w3 = mix(1.0 - f, f, float3(o));
        int index = c.x + dims.x * (c.y + dims.y * c.z);
        uint2 t = uint2((index % 256) * 4, index / 256);
        float4 c0 = sh.read(t);
        float3 toProbe = u.u_probeGridMin.xyz + float3(c) * cell - worldPos;
        float facing = dot(toProbe, N) * rsqrt(max(dot(toProbe, toProbe), 1e-12)) * 0.5 + 0.5;
        float w = w3.x * w3.y * w3.z * (facing * facing + 0.05) * max(c0.a, 1e-3);
        l0 += c0.rgb * w;
        lx += sh.read(t + uint2(1, 0)).rgb * w;
        ly += sh.read(t + uint2(2, 0)).rgb * w;
        lz += sh.read(t + uint2(3, 0)).rgb * w;
        weight += w;
      }
      float3 irradiance = max((0.282095 * l0 + 0.325735 * (lx * N.x + ly * N.y + lz * N.z)) / max(weight, 1e-8), float3(0.0));
      return mix(fallback, irradiance, fade);
    }

    float2 probeOctEncode(float3 d)
    {
      d /= abs(d.x) + abs(d.y) + abs(d.z);
      float2 p = d.xy;
      if (d.z < 0.0) p = (1.0 - abs(d.yx)) * select(float2(-1.0), float2(1.0), d.xy >= 0.0);
      return p * 0.5 + 0.5;
    }

    float3 probeSphereMip(texture2d<float> atlas, sampler smp, int sphere, int mip, float3 d)
    {
      float res = float(128 >> mip);
      float2 tile = float2(float((sphere % 4) * 196), float((sphere / 4) * 130));
      float2 offset = mip == 0 ? float2(0.0)
                    : float2(130.0, mip == 1 ? 0.0 : mip == 2 ? 66.0 : mip == 3 ? 100.0 : 118.0);
      float2 texel = tile + offset + probeOctEncode(d) * res + 1.0;
      return atlas.sample(smp, texel / float2(atlas.get_width(), atlas.get_height()), level(0.0)).rgb;
    }

    float3 probeSphereRadiance(float3 worldPos, float3 R, float perceptualRoughness, float3 fallback,
                               texture2d<float> atlas, sampler smp, texture2d<float> info,
                               constant Uniforms& u)
    {
      int count = int(u.u_probeGridMax.w);
      float lod = saturate(perceptualRoughness) * 4.0;
      int mip = min(int(lod), 3);
      float blend = lod - float(mip);
      float3 result = fallback;
      for (int i = 0; i < count; ++i) {
        float4 sphere = info.read(uint2(i, 0));
        float3 d = worldPos - sphere.xyz;
        float dist = length(d);
        if (dist >= sphere.w) continue;
        float w = saturate((sphere.w - dist) / (0.2 * sphere.w)) * info.read(uint2(i, 1)).x;
        if (w <= 0.0) continue;
        float b = dot(d, R);
        float hit = -b + sqrt(max(b * b - dot(d, d) + sphere.w * sphere.w, 0.0));
        float3 dir = normalize(mix(normalize(d + R * hit), R, perceptualRoughness * perceptualRoughness));
        float3 radiance = mix(probeSphereMip(atlas, smp, i, mip, dir),
                              probeSphereMip(atlas, smp, i, mip + 1, dir), blend);
        result = mix(result, radiance, w);
      }
      return result;
    }

    float3 pointLightRadiance(float3 worldPos, float3 N, float3 V, float NoV,
                              float roughness, float3 f0, float3 diffuseColor,
                              float4 shadows, constant Uniforms& u)
    {
      float3 color = float3(0.0);
      int count = int(min(u.u_pointLightCount, 4.0));
      for (int i = 0; i < count; ++i) {
        float4 posIntensity = pointLightPosIntensity(i, u);
        float4 colorRadius = pointLightColorRadius(i, u);

        float3 toLight = posIntensity.xyz - worldPos;
        float distSq = max(dot(toLight, toLight), colorRadius.w * colorRadius.w);
        float3 L = normalize(toLight);
        float cosTheta = dot(N, L);
        float sinSigmaSqr = min(colorRadius.w * colorRadius.w / distSq, 0.9999);
        float irradiance = sphereIrradiance(cosTheta, sinSigmaSqr);
        if (irradiance <= 0.0) continue;

        float NoL = max(cosTheta, 0.0);
        float3 R = reflect(-V, N);
        float3 centerToRay = dot(toLight, R) * R - toLight;
        float3 Ls = normalize(toLight + centerToRay
                              * clamp(colorRadius.w / max(length(centerToRay), 1e-6), 0.0, 1.0));
        float NoLs = max(dot(N, Ls), 0.0);
        float widened = clamp(roughness + colorRadius.w / (2.0 * sqrt(distSq)), 0.0, 1.0);
        float normalization = (roughness / widened) * (roughness / widened);

        float3 H = normalize(V + Ls);
        float NoH = max(dot(N, H), 0.0);
        float LoH = max(dot(Ls, H), 0.0);
        float D = D_GGX(roughness, NoH);
        float Vis = V_SmithGGXCorrelatedFast(roughness, NoV, max(NoLs, 1e-4));
        float3 F = F_Schlick(f0, LoH);

        float3 kD = float3(1.0) - F;
        float3 Fr = D * Vis * F * (PI * sinSigmaSqr * NoLs * normalization);
        float3 Fd = (kD * diffuseColor / PI) * irradiance;

        color += (Fd + Fr) * colorRadius.xyz * posIntensity.w * shadows[i];
      }
      return color;
    }

    //@main
    {
      uint2 gbufferPixel = uint2(gl_FragCoord.xy);
      float4 normalSample = u_normal_texture.read(gbufferPixel);
      float3 normalEye = normalSample.xyz;
      float3 posEye = u_position_texture.read(gbufferPixel).xyz;
      float3 diffuse = u_diffuse_texture.read(gbufferPixel).xyz;
      float2 materialSample = u_material_texture.read(gbufferPixel).rg;

      float3x3 invView = float3x3(
        float3(u_view[0][0], u_view[1][0], u_view[2][0]),
        float3(u_view[0][1], u_view[1][1], u_view[2][1]),
        float3(u_view[0][2], u_view[1][2], u_view[2][2])
      );

      float3 worldPos = invView * (posEye - float3(u_view[3][0], u_view[3][1], u_view[3][2]));

      if (normalSample.a < 0.5) {
        if (u_iblEnabled > 0.5) {
          float4 e = u_invProj * float4(var.texCoord * 2.0 - 1.0, 1.0, 1.0);
          float3 worldDir = normalize(invView * (e.xyz / e.w));
          float3 sky = texture(u_envCube_texture, toSkySpace(worldDir, u_zUp)).rgb;
          float4 fog = volumeFog(gl_FragCoord.xy, u_volumeRange.y,
                                 u_volumeIntegrated_texture, u_volumeIntegrated_texture_smp, _u);
          o_final_texture = float4(sky * fog.a + fog.rgb, 1.0);
        } else {
          o_final_texture = float4(diffuse, 1.0);
        }
      } else {
        float3 N = normalize(invView * normalEye);
        float3 V = normalize(invView * (-posEye));
        float NoV = max(dot(N, V), 1e-4);

        float perceptualRoughness = saturate(max(materialSample.r, 0.045));
        float roughness = perceptualRoughness * perceptualRoughness;
        float metallic = saturate(materialSample.g);
        float3 baseColor = diffuse;
        float3 f0 = mix(float3(0.04), baseColor, metallic);
        float3 diffuseColor = baseColor * (1.0 - metallic);

        float3 L = normalize(u_sunDirection.xyz);
        float nightFade = smoothstep(-0.3, 0.05, sunHeight);

        float2 noisePixel = gl_FragCoord.xy + 5.588238 * float(frameIndex % 64);
        float noise = fract(52.9829189 * fract(dot(noisePixel, float2(0.06711056, 0.00583715))));
        float noiseB = fract(52.9829189 * fract(dot(noisePixel.yx, float2(0.06711056, 0.00583715))));

        float3 color = float3(0.0);
        float cosTheta = dot(N, L);
        float sinSigma = sin(u_sunDirection.w);
        float sinSigmaSqr = max(sinSigma * sinSigma, 1e-7);
        float sunIrradiance = sphereIrradiance(cosTheta, sinSigmaSqr) / (PI * sinSigmaSqr);
        if (sunIrradiance > 0.0) {
          float NoL = max(cosTheta, 0.0);
          float tanSigma = tan(u_sunDirection.w);
          float3 R = reflect(-V, N);
          float3 centerToRay = dot(L, R) * R - L;
          float3 Ls = normalize(L + centerToRay * clamp(tanSigma / max(length(centerToRay), 1e-6), 0.0, 1.0));
          float NoLs = max(dot(N, Ls), 0.0);
          float widened = clamp(roughness + 0.5 * tanSigma, 0.0, 1.0);
          float normalization = (roughness / widened) * (roughness / widened);

          float3 H = normalize(V + Ls);
          float NoH = max(dot(N, H), 0.0);
          float LoH = max(dot(Ls, H), 0.0);
          float D = D_GGX(roughness, NoH);

          float Vis = V_SmithGGXCorrelatedFast(roughness, NoV, max(NoLs, 1e-4));
          float3 F = F_Schlick(f0, LoH);

          float3 kD = float3(1.0) - F;
          float3 Fr = D * Vis * F * NoLs * normalization;
          float3 Fd = (kD * diffuseColor / PI) * sunIrradiance;

          float3 skyL = toSkySpace(L, u_zUp);
          float3 dayColor = mix(texture(u_envCube_texture, skyL).rgb, float3(1.0), saturate(sunHeight));
          float3 nightColor = mix(texture(u_envCube_texture, skyL).rgb, float3(0.95, 0.95, 1.00), saturate(-sunHeight));
          float3 dynamicSky = mix(nightColor * MOON_INTENSITY, dayColor * LIGHT_INTENSITY, nightFade);

          float shadow = directionalShadow(posEye, normalEye, NoL, float2(noise, noiseB),
                                           u_shadow_atlas, u_shadow_atlas_smp,
                                           u_shadow_data, u_shadow_pagetable, _u);

          color += (Fd + Fr) * dynamicSky * shadow;
        }

        color += pointLightRadiance(worldPos, N, V, NoV, roughness, f0, diffuseColor,
                                    pointShadowUpsample(gbufferPixel, posEye, normalEye, u_pointShadow_texture,
                                                        u_pointShadowGuide_texture, _u), _u);

        float2 dfgTexel = 0.5 / float2(u_dfg_texture.get_width(), u_dfg_texture.get_height());
        float3 dfg = texture(u_dfg_texture, clamp(float2(NoV, perceptualRoughness), dfgTexel, 1.0 - dfgTexel)).rgb;
        float3 E = f0 * dfg.x + dfg.y;
        float3 energyCompensation = 1.0 + f0 * (1.0 / max(dfg.x + dfg.y, 1e-4) - 1.0);

        float3 r = reflect(-V, N);
        r = mix(r, N, roughness * roughness);

        float lod = 5.0 * perceptualRoughness * (2.0 - perceptualRoughness);
        lod = clamp(lod, 0.0, 5.0);

        float3 prefilteredRadiance = textureLod(u_prefiltered_texture, toSkySpace(r, u_zUp), lod).rgb * u_iblEnabled;
        prefilteredRadiance = probeSphereRadiance(worldPos, r, perceptualRoughness, prefilteredRadiance,
                                                  u_probe_sphere, u_probe_sphere_smp, u_probe_info, _u);

        float4 gi = ssgiUpsample(gbufferPixel, posEye, normalEye, u_ssgiAccum_texture,
                                 u_ssgiDepth_texture, u_ssgiNormal_texture, _u);
        float specularOcclusion = clamp(pow(NoV + gi.a, exp2(-16.0 * roughness - 1.0)) - 1.0 + gi.a, 0.0, 1.0);
        float3 irradiance = texture(u_irradiance_texture, toSkySpace(N, u_zUp)).rgb * u_iblEnabled;
        irradiance = probeVolumeIrradiance(worldPos, N, irradiance, u_probe_volume, _u);
        float3 Fd = diffuseColor * irradiance * gi.a * (1.0 - E);

        float4 reflection = ssrUpsample(gbufferPixel, posEye, normalEye,
                                        u_ssrAccum_texture, u_ssrGuide_texture, _u);
        float3 traced = mix(prefilteredRadiance * specularOcclusion, reflection.rgb, reflection.a);
        float4 horizon = ssgiUpsample(gbufferPixel, posEye, normalEye, u_ssgiSpecAccum_texture,
                                      u_ssgiDepth_texture, u_ssgiNormal_texture, _u);
        float horizonMix = u_horizonScan.y * saturate((perceptualRoughness - u_horizonScan.x) / 0.2);
        float3 Fr = E * energyCompensation
                  * mix(traced, horizon.rgb + prefilteredRadiance * horizon.a, horizonMix);

        color += Fd + Fr + diffuseColor * gi.rgb * (1.0 - E);

        color += float3(u_material_texture.read(gbufferPixel).ba, u_diffuse_texture.read(gbufferPixel).w);

        float4 fog = volumeFog(gl_FragCoord.xy, -posEye.z,
                               u_volumeIntegrated_texture, u_volumeIntegrated_texture_smp, _u);
        color = color * fog.a + fog.rgb;

        o_final_texture = float4(finiteColor(color), 1.0);
      }
    }
    ```

shader: point-shadow
  uniforms: [ u_normal_texture: sampler2d,
              u_position_texture: sampler2d,
              u_shadow_atlas: usampler2DArray,
              u_shadow_data: sampler2d,
              u_shadow_pagetable: sampler2d,
              u_view: mat4 <- auto-view-matrix,
              u_invProj: mat4,
              u_punctualShadowEnabled: float,
              u_pointLightCount: float,
              u_pointLightPosIntensity0: vec4,
              u_pointLightPosIntensity1: vec4,
              u_pointLightPosIntensity2: vec4,
              u_pointLightPosIntensity3: vec4,
              u_pointLightColorRadius0: vec4,
              u_pointLightColorRadius1: vec4,
              u_pointLightColorRadius2: vec4,
              u_pointLightColorRadius3: vec4,
              frameIndex: int ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    vec4 pointLightPosIntensity(int i)
    {
      vec4 v = u_pointLightPosIntensity0;
      if (i == 1)      v = u_pointLightPosIntensity1;
      else if (i == 2) v = u_pointLightPosIntensity2;
      else if (i == 3) v = u_pointLightPosIntensity3;
      return v;
    }

    vec4 pointLightColorRadius(int i)
    {
      vec4 v = u_pointLightColorRadius0;
      if (i == 1)      v = u_pointLightColorRadius1;
      else if (i == 2) v = u_pointLightColorRadius2;
      else if (i == 3) v = u_pointLightColorRadius3;
      return v;
    }

    int punctualFaceIndex(vec3 lL)
    {
      vec3 aP = abs(lL);
      if (aP.x > aP.y && aP.x > aP.z) return lL.x > 0.0 ? 1 : 2;
      if (aP.y > aP.x && aP.y > aP.z) return lL.y > 0.0 ? 3 : 4;
      return lL.z > 0.0 ? 5 : 0;
    }

    vec3 punctualFaceLocal(int face, vec3 lL)
    {
      if (face == 1) return vec3(-lL.y, lL.z, -lL.x);
      if (face == 2) return vec3(lL.y, lL.z, lL.x);
      if (face == 3) return vec3(lL.x, lL.z, -lL.y);
      if (face == 4) return vec3(-lL.x, lL.z, lL.y);
      if (face == 5) return vec3(lL.x, -lL.y, -lL.z);
      return lL;
    }

    int punctualTileOffset(ivec2 tile, int lod)
    {
      int base = 0, size = 32;
      for (int l = 0; l < lod; l++) { base += size * size; size >>= 1; }
      return base + tile.y * size + tile.x;
    }

    float punctualLinearDepth(float depth01, vec2 nearFar)
    {
      return nearFar.x * nearFar.y / (nearFar.y - depth01 * (nearFar.y - nearFar.x));
    }

    vec2 punctualTap(vec3 lT, int lightIdx, int lod, vec2 nearFar, float biasWorld,
                     inout int cacheKey, inout vec4 cacheSlot)
    {
      int face = punctualFaceIndex(lT);
      vec3 fT = punctualFaceLocal(face, lT);
      float z = max(abs(fT.z), 1e-6);
      float zb = max(z - biasWorld, nearFar.x);
      float tapDepth = nearFar.y * (zb - nearFar.x) / ((nearFar.y - nearFar.x) * zb);
      int tilesPerSide = 32 >> lod;
      vec2 tileFloat = clamp(fT.xy / z * 0.5 + 0.5, 0.0, 0.999999) * float(tilesPerSide);
      ivec2 tile = ivec2(tileFloat);
      int key = face * 2048 + punctualTileOffset(tile, lod);
      if (key != cacheKey) {
        cacheSlot = texelFetch(u_shadow_pagetable, ivec2(key - face * 2048, lightIdx * 6 + face), 0);
        cacheKey = key;
      }
      vec4 slot = cacheSlot;
      if (slot.z < 0.5) return vec2(-1.0, tapDepth);
      vec2 frac = tileFloat - vec2(tile);
      uint v = texelFetch(u_shadow_atlas, ivec3(int(slot.y) * 256 + int(frac.x * 256.0),
                                                int(frac.y * 256.0), int(slot.x)), 0).r;
      return vec2(v == 0xFFFFFFFFu ? 1.0 : uintBitsToFloat(v), tapDepth);
    }

    float punctualShadow(int lightIdx, vec3 worldPos, vec3 N, vec3 lightPos, float lightRadius, float NoL,
                         float noise, float filmFootprint)
    {
      if (u_punctualShadowEnabled < 0.5) return 1.0;
      vec3 lL = worldPos - lightPos;
      float distanceToLight = max(max(abs(lL.x), abs(lL.y)), abs(lL.z));
      if (distanceToLight < 1e-6) return 1.0;
      int face = punctualFaceIndex(lL);
      vec3 fL = punctualFaceLocal(face, lL);
      int tilemapIndex = lightIdx * 6 + face;
      float receiverZ = max(abs(fL.z), 1e-6);
      vec2 uvBase = clamp(fL.xy / receiverZ * 0.5 + 0.5, 0.0, 0.999999);
      vec2 nearFar = texelFetch(u_shadow_data, ivec2(5, tilemapIndex), 0).xy;

      float ratio = clamp(2.0 * 1.4142135 / 8192.0 / max(filmFootprint / distanceToLight, 1e-8), 1e-8, 1.0);
      int start = int(clamp(-log2(ratio), 0.0, 5.0));
      int lod = -1;
      int tilesPerSide = 32;
      int cacheKey = -1;
      vec4 cacheSlot = vec4(0.0);
      for (int i = 0; i <= 5; ++i) {
        int l = i <= start ? start - i : i;
        tilesPerSide = 32 >> l;
        ivec2 tile = clamp(ivec2(uvBase * float(tilesPerSide)), ivec2(0), ivec2(tilesPerSide - 1));
        cacheKey = face * 2048 + punctualTileOffset(tile, l);
        cacheSlot = texelFetch(u_shadow_pagetable, ivec2(cacheKey - face * 2048, tilemapIndex), 0);
        if (cacheSlot.z > 0.5) { lod = l; break; }
      }
      if (lod < 0) return 1.0;

      float worldPerTile = 2.0 * receiverZ / float(tilesPerSide);
      float texelWorld = worldPerTile / 256.0;
      float tanTheta = sqrt(max(1.0 - NoL * NoL, 0.0)) / max(NoL, 0.05);
      float biasWorld = texelWorld * (1.0 + min(tanTheta, 4.0));

      vec3 tangent = normalize(cross(N, abs(N.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
      vec3 bitangent = cross(N, tangent);

      float blockerSum = 0.0;
      int blockers = 0;
      float searchRadius = clamp(lightRadius, texelWorld, worldPerTile);
      vec2 spiral = vec2(cos(noise * 6.2831853), sin(noise * 6.2831853));
      for (int i = 0; i < 8; ++i) {
        vec2 offset = spiral * sqrt((float(i) + 0.5) / 8.0) * searchRadius;
        spiral = vec2(spiral.x * -0.73736887 - spiral.y * 0.67549029, spiral.x * 0.67549029 + spiral.y * -0.73736887);
        vec2 t = punctualTap(lL + tangent * offset.x + bitangent * offset.y, lightIdx, lod, nearFar, biasWorld,
                             cacheKey, cacheSlot);
        if (t.x >= 0.0 && t.x < t.y) { blockerSum += punctualLinearDepth(t.x, nearFar); blockers++; }
      }
      if (blockers == 0) return 1.0;

      float blockerZ = blockerSum / float(blockers);
      float penumbra = lightRadius * max(receiverZ - blockerZ, 0.0) / max(blockerZ, 1e-4);
      float filterRadius = clamp(penumbra, texelWorld, worldPerTile);
      if (blockers == 8 && filterRadius <= searchRadius) return 0.0;

      float lit = 0.0;
      float taps = 0.0;
      spiral = vec2(cos(noise * 6.2831853), sin(noise * 6.2831853));
      for (int i = 0; i < 8; ++i) {
        vec2 offset = spiral * sqrt((float(i) + 0.5) / 8.0) * filterRadius;
        spiral = vec2(spiral.x * -0.73736887 - spiral.y * 0.67549029, spiral.x * 0.67549029 + spiral.y * -0.73736887);
        vec2 t = punctualTap(lL + tangent * offset.x + bitangent * offset.y, lightIdx, lod, nearFar, biasWorld,
                             cacheKey, cacheSlot);
        if (t.x < 0.0) continue;
        lit += t.y <= t.x ? 1.0 : 0.0;
        taps += 1.0;
      }
      return taps > 0.0 ? lit / taps : 1.0;
    }

    void main()
    {
      ivec2 fullSize = textureSize(u_position_texture, 0);
      ivec2 fp = min(ivec2(gl_FragCoord.xy) * 2, fullSize - 1);
      vec4 n = texelFetch(u_normal_texture, fp, 0);
      vec3 posEye = texelFetch(u_position_texture, fp, 0).xyz;
      o_pointShadowGuide_texture = vec4(normalize(n.xyz), posEye.z);
      o_pointShadow_texture = vec4(1.0);
      if (n.a < 0.5 || u_punctualShadowEnabled < 0.5) return;

      mat4 invView = inverse(u_view);
      vec3 worldPos = (invView * vec4(posEye, 1.0)).xyz;
      vec3 N = normalize(mat3(invView) * n.xyz);
      vec2 noisePixel = gl_FragCoord.xy + 5.588238 * float(frameIndex % 64);
      float noise = fract(52.9829189 * fract(dot(noisePixel, vec2(0.06711056, 0.00583715))));
      float filmFootprint = abs(posEye.z) * 2.0 * u_invProj[1][1] / float(fullSize.y);

      vec4 shadows = vec4(1.0);
      int count = int(min(u_pointLightCount, 4.0));
      for (int i = 0; i < count; ++i) {
        vec4 posIntensity = pointLightPosIntensity(i);
        vec4 colorRadius = pointLightColorRadius(i);
        vec3 toLight = posIntensity.xyz - worldPos;
        float d = length(toLight);
        float NoL = dot(N, toLight / max(d, 1e-6));
        if (NoL < -colorRadius.w / max(d, 1e-6)) continue;
        shadows[i] = punctualShadow(i, worldPos, N, posIntensity.xyz, colorRadius.w, max(NoL, 0.0),
                                    noise, filmFootprint);
      }
      o_pointShadow_texture = shadows;
    }
    ```

    source msl:
    ```msl
    float4 pointLightPosIntensity(int i, constant Uniforms& u)
    {
      float4 v = u.u_pointLightPosIntensity0;
      if (i == 1)      v = u.u_pointLightPosIntensity1;
      else if (i == 2) v = u.u_pointLightPosIntensity2;
      else if (i == 3) v = u.u_pointLightPosIntensity3;
      return v;
    }

    float4 pointLightColorRadius(int i, constant Uniforms& u)
    {
      float4 v = u.u_pointLightColorRadius0;
      if (i == 1)      v = u.u_pointLightColorRadius1;
      else if (i == 2) v = u.u_pointLightColorRadius2;
      else if (i == 3) v = u.u_pointLightColorRadius3;
      return v;
    }

    int punctualFaceIndex(float3 lL)
    {
      float3 aP = abs(lL);
      if (aP.x > aP.y && aP.x > aP.z) return lL.x > 0.0 ? 1 : 2;
      if (aP.y > aP.x && aP.y > aP.z) return lL.y > 0.0 ? 3 : 4;
      return lL.z > 0.0 ? 5 : 0;
    }

    float3 punctualFaceLocal(int face, float3 lL)
    {
      if (face == 1) return float3(-lL.y, lL.z, -lL.x);
      if (face == 2) return float3(lL.y, lL.z, lL.x);
      if (face == 3) return float3(lL.x, lL.z, -lL.y);
      if (face == 4) return float3(-lL.x, lL.z, lL.y);
      if (face == 5) return float3(lL.x, -lL.y, -lL.z);
      return lL;
    }

    int punctualTileOffset(int2 tile, int lod)
    {
      int base = 0, size = 32;
      for (int l = 0; l < lod; l++) { base += size * size; size >>= 1; }
      return base + tile.y * size + tile.x;
    }

    float punctualLinearDepth(float depth01, float2 nearFar)
    {
      return nearFar.x * nearFar.y / (nearFar.y - depth01 * (nearFar.y - nearFar.x));
    }

    float2 punctualTap(float3 lT, int lightIdx, int lod, float2 nearFar, float biasWorld,
                       thread int& cacheKey, thread float4& cacheSlot,
                       texture2d_array<uint> atlasTex, texture2d<float> pageTableTex)
    {
      int face = punctualFaceIndex(lT);
      float3 fT = punctualFaceLocal(face, lT);
      float z = max(abs(fT.z), 1e-6);
      float zb = max(z - biasWorld, nearFar.x);
      float tapDepth = nearFar.y * (zb - nearFar.x) / ((nearFar.y - nearFar.x) * zb);
      int tilesPerSide = 32 >> lod;
      float2 tileFloat = clamp(fT.xy / z * 0.5 + 0.5, 0.0, 0.999999) * float(tilesPerSide);
      int2 tile = int2(tileFloat);
      int key = face * 2048 + punctualTileOffset(tile, lod);
      if (key != cacheKey) {
        cacheSlot = pageTableTex.read(uint2(key - face * 2048, lightIdx * 6 + face));
        cacheKey = key;
      }
      float4 slot = cacheSlot;
      if (slot.z < 0.5) return float2(-1.0, tapDepth);
      float2 frac = tileFloat - float2(tile);
      uint v = atlasTex.read(uint2(uint(slot.y) * 256u + uint(frac.x * 256.0),
                                   uint(frac.y * 256.0)), uint(slot.x)).r;
      return float2(v == 0xFFFFFFFFu ? 1.0 : as_type<float>(v), tapDepth);
    }

    float punctualShadow(int lightIdx, float3 worldPos, float3 N, float3 lightPos, float lightRadius, float NoL,
                         float noise, float filmFootprint,
                         texture2d_array<uint> atlasTex, sampler atlasSmp,
                         texture2d<float> dataTex, texture2d<float> pageTableTex,
                         constant Uniforms& u)
    {
      if (u.u_punctualShadowEnabled < 0.5) return 1.0;
      float3 lL = worldPos - lightPos;
      float distanceToLight = max(max(abs(lL.x), abs(lL.y)), abs(lL.z));
      if (distanceToLight < 1e-6) return 1.0;
      int face = punctualFaceIndex(lL);
      float3 fL = punctualFaceLocal(face, lL);
      int tilemapIndex = lightIdx * 6 + face;
      float receiverZ = max(abs(fL.z), 1e-6);
      float2 uvBase = clamp(fL.xy / receiverZ * 0.5 + 0.5, 0.0, 0.999999);
      float2 nearFar = dataTex.read(uint2(5, tilemapIndex)).xy;

      float ratio = clamp(2.0 * 1.4142135 / 8192.0 / max(filmFootprint / distanceToLight, 1e-8), 1e-8, 1.0);
      int start = int(clamp(-log2(ratio), 0.0, 5.0));
      int lod = -1;
      int tilesPerSide = 32;
      int cacheKey = -1;
      float4 cacheSlot = float4(0.0);
      for (int i = 0; i <= 5; ++i) {
        int l = i <= start ? start - i : i;
        tilesPerSide = 32 >> l;
        int2 tile = clamp(int2(uvBase * float(tilesPerSide)), int2(0), int2(tilesPerSide - 1));
        cacheKey = face * 2048 + punctualTileOffset(tile, l);
        cacheSlot = pageTableTex.read(uint2(cacheKey - face * 2048, tilemapIndex));
        if (cacheSlot.z > 0.5) { lod = l; break; }
      }
      if (lod < 0) return 1.0;

      float worldPerTile = 2.0 * receiverZ / float(tilesPerSide);
      float texelWorld = worldPerTile / 256.0;
      float tanTheta = sqrt(max(1.0 - NoL * NoL, 0.0)) / max(NoL, 0.05);
      float biasWorld = texelWorld * (1.0 + min(tanTheta, 4.0));


      float3 tangent = normalize(cross(N, abs(N.y) < 0.99 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0)));
      float3 bitangent = cross(N, tangent);

      float blockerSum = 0.0;
      int blockers = 0;
      float searchRadius = clamp(lightRadius, texelWorld, worldPerTile);
      float2 spiral = float2(cos(noise * 6.2831853), sin(noise * 6.2831853));
      for (int i = 0; i < 8; ++i) {
        float2 offset = spiral * sqrt((float(i) + 0.5) / 8.0) * searchRadius;
        spiral = float2(spiral.x * -0.73736887 - spiral.y * 0.67549029, spiral.x * 0.67549029 + spiral.y * -0.73736887);
        float2 t = punctualTap(lL + tangent * offset.x + bitangent * offset.y, lightIdx, lod, nearFar, biasWorld,
                               cacheKey, cacheSlot, atlasTex, pageTableTex);
        if (t.x >= 0.0 && t.x < t.y) { blockerSum += punctualLinearDepth(t.x, nearFar); blockers++; }
      }
      if (blockers == 0) return 1.0;

      float blockerZ = blockerSum / float(blockers);
      float penumbra = lightRadius * max(receiverZ - blockerZ, 0.0) / max(blockerZ, 1e-4);
      float filterRadius = clamp(penumbra, texelWorld, worldPerTile);
      if (blockers == 8 && filterRadius <= searchRadius) return 0.0;

      float lit = 0.0;
      float taps = 0.0;
      spiral = float2(cos(noise * 6.2831853), sin(noise * 6.2831853));
      for (int i = 0; i < 8; ++i) {
        float2 offset = spiral * sqrt((float(i) + 0.5) / 8.0) * filterRadius;
        spiral = float2(spiral.x * -0.73736887 - spiral.y * 0.67549029, spiral.x * 0.67549029 + spiral.y * -0.73736887);
        float2 t = punctualTap(lL + tangent * offset.x + bitangent * offset.y, lightIdx, lod, nearFar, biasWorld,
                               cacheKey, cacheSlot, atlasTex, pageTableTex);
        if (t.x < 0.0) continue;
        lit += t.y <= t.x ? 1.0 : 0.0;
        taps += 1.0;
      }
      return taps > 0.0 ? lit / taps : 1.0;
    }

    //@main
    {
      int2 fullSize = int2(u_position_texture.get_width(), u_position_texture.get_height());
      uint2 fp = uint2(min(int2(gl_FragCoord.xy) * 2, fullSize - 1));
      float4 n = u_normal_texture.read(fp);
      float3 posEye = u_position_texture.read(fp).xyz;
      o_pointShadowGuide_texture = float4(normalize(n.xyz), posEye.z);
      o_pointShadow_texture = float4(1.0);
      if (n.a >= 0.5 && u_punctualShadowEnabled >= 0.5) {
        float3x3 invView = float3x3(
          float3(u_view[0][0], u_view[1][0], u_view[2][0]),
          float3(u_view[0][1], u_view[1][1], u_view[2][1]),
          float3(u_view[0][2], u_view[1][2], u_view[2][2])
        );
        float3 worldPos = invView * (posEye - float3(u_view[3][0], u_view[3][1], u_view[3][2]));
        float3 N = normalize(invView * n.xyz);
        float2 noisePixel = gl_FragCoord.xy + 5.588238 * float(frameIndex % 64);
        float noise = fract(52.9829189 * fract(dot(noisePixel, float2(0.06711056, 0.00583715))));
        float filmFootprint = abs(posEye.z) * 2.0 * u_invProj[1][1] / float(fullSize.y);

        float4 shadows = float4(1.0);
        int count = int(min(u_pointLightCount, 4.0));
        for (int i = 0; i < count; ++i) {
          float4 posIntensity = pointLightPosIntensity(i, _u);
          float4 colorRadius = pointLightColorRadius(i, _u);
          float3 toLight = posIntensity.xyz - worldPos;
          float d = length(toLight);
          float NoL = dot(N, toLight / max(d, 1e-6));
          if (NoL < -colorRadius.w / max(d, 1e-6)) continue;
          shadows[i] = punctualShadow(i, worldPos, N, posIntensity.xyz, colorRadius.w, max(NoL, 0.0),
                                      noise, filmFootprint, u_shadow_atlas, u_shadow_atlas_smp,
                                      u_shadow_data, u_shadow_pagetable, _u);
        }
        o_pointShadow_texture = shadows;
      }
    }
