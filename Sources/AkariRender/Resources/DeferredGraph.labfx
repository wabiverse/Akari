              u_froxelDepth: sampler2d,
              u_froxelHistory: sampler2d,
              u_view: mat4 <- auto-view-matrix,
              u_proj: mat4,
              u_invProj: mat4,
              sunHeight: float,
              u_zUp: float,
              u_sunDirection: vec4,
