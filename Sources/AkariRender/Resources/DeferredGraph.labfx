    source:
    ```glsl
    //@include Post.glsl
    void main()
    {
      o_lensStreakWide_texture = vec4(0.0);
    }
    ```

    source msl:
    ```msl
    //@include Post.msl
    //@main
    {
      float t = 3.0 / float(u_lensStreakA_texture.get_width());
      float3 sum = float3(0.0);
      float weight = 0.0;
      for (int i = -12; i <= 12; ++i) {
        float w = exp(-abs(float(i)) / 5.0);
        sum += u_lensStreakA_texture.sample(u_lensStreakA_texture_smp, var.texCoord + float2(t * float(i), 0.0), level(0.0)).rgb * w;
        weight += w;
      }
      o_lensStreakWide_texture = float4(sum / weight + u_lensStreakA_texture.sample(u_lensStreakA_texture_smp, var.texCoord, level(0.0)).rgb, 1.0);
    }
    ```

