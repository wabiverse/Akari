  fsh:
    source:
    ```glsl
    //@include Post.glsl
    void main()
    {
      o_final_texture = vec4(0.0);
    }
    ```

    source msl:
    ```msl
    //@include Post.msl
    //@main
    {
      float3 bloom = u_bloomUp0_texture.sample(u_bloomUp0_texture_smp, var.texCoord, level(0.0)).rgb / 5.0;
      bloom = mix(float3(dot(bloom, float3(0.2126, 0.7152, 0.0722))), bloom, u_bloomTint.w) * u_bloomTint.rgb;
      float3 streak = u_lensStreakB_texture.sample(u_lensStreakB_texture_smp, var.texCoord, level(0.0)).rgb;
      float3 ghosts = u_lensGhosts_texture.sample(u_lensGhosts_texture_smp, var.texCoord, level(0.0)).rgb;
      o_final_texture = float4(bloom * u_bloom.x + streak * float3(0.55, 0.75, 1.0) * u_bloom.y + ghosts * u_bloom.z, 1.0);
    }
    ```

shader: mesh-transparent
  uniforms: [ u_material_atlas: sampler2d, u_color_atlas: sampler2d,
              u_normal_atlas: sampler2d, u_emissive_atlas: sampler2d, u_materialConstants: sampler2d,
              u_primStyle: sampler2d,
              u_position_texture: sampler2d,
              u_normal_texture: sampler2d,
              u_prefiltered_texture: samplerCube,
              u_irradiance_texture: samplerCube,
              u_prevViewProj: mat4, u_currViewProj: mat4,
              u_view: mat4 <- auto-view-matrix,
              u_sunDirection: vec4,
              u_sunOverride: vec4,
              u_iblEnabled: float,
              u_zUp: float,
              u_transparency: vec4,
              frameIndex: int ]
  varying:  [ posEye: vec3, normalEye: vec3, uv: vec2, primId: float, currClip: vec4, prevClip: vec4,
              posWorld: vec3, bary: vec3, assembled: float, vcolor: vec4, tri: float ]

  vsh:
    attributes:
    [ a_position: vec4 <- position,
      a_color: vec4 <- color,
      a_normal: vec3 <- normal,
      a_uv: vec2 <- texcoord,
      a_pad: float <- pad ]

    source:
    ```glsl
    void main()
    {
      vec4 ep = u_modelview * vec4(a_position.xyz, 1.0);
      var.posEye = ep.xyz;
      var.normalEye = normalize(u_normalMatrix * a_normal);
      var.uv = a_uv;
      var.primId = a_color.r;
      var.currClip = u_currViewProj * vec4(a_position.xyz, 1.0);
      var.prevClip = u_prevViewProj * vec4(a_color.yzw, 1.0);
      var.posWorld = a_position.xyz;
      var.tri = a_pad;
      float hidden = floor(a_position.w / 8.0);
      float cornerCode = a_position.w - hidden * 8.0;
      float corner = floor(cornerCode * 0.5);
      var.assembled = clamp(cornerCode - corner * 2.0, 0.0, 1.0);
      var.bary = corner < 0.5 ? vec3(1.0, 0.0, 0.0) : corner < 1.5 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
      float packed = a_uv.x < 0.0 ? a_uv.y - 1.0 : -1.0;
      var.vcolor = packed >= 0.0 ? vec4(floor(packed / 65536.0), mod(floor(packed / 256.0), 256.0), mod(packed, 256.0), 255.0) / 255.0
                                 : vec4(0.0);
      gl_Position = u_modelviewProjection * vec4(a_position.xyz, 1.0);
    }
    ```

    source msl:
    ```msl
    float4 objPos = float4(a_position.xyz, 1.0);
    float4 worldPos = u_instance * objPos;
    float4 ep = u_modelview * objPos;
    var.posEye = ep.xyz;
    var.normalEye = normalize(u_normalMatrix * a_normal);
    var.uv = a_uv;
    var.primId = a_color.r;
    var.currClip = u_currViewProj * worldPos;
    var.prevClip = u_prevViewProj * (u_instance * float4(a_color.yzw, 1.0));
    var.posWorld = worldPos.xyz;
    var.tri = a_pad;
    float hidden = floor(a_position.w / 8.0);
    float cornerCode = a_position.w - hidden * 8.0;
    float corner = floor(cornerCode * 0.5);
    var.assembled = saturate(cornerCode - corner * 2.0);
    var.bary = corner < 0.5 ? float3(1.0, 0.0, 0.0) : corner < 1.5 ? float3(0.0, 1.0, 0.0) : float3(0.0, 0.0, 1.0);
    float packed = a_uv.x < 0.0 ? a_uv.y - 1.0 : -1.0;
    var.vcolor = packed >= 0.0 ? float4(floor(packed / 65536.0), fmod(floor(packed / 256.0), 256.0), fmod(packed, 256.0), 255.0) / 255.0
                               : float4(0.0);
    gl_Position = u_modelviewProjection * objPos;
    ```

  fsh:
    source:
    ```glsl
    void main()
    {
      discard;
    }
    ```

    source msl:
    ```msl
    //@include Style.msl
    //@main
    {
      if (styleTexel(u_primStyle, var.primId, 4).y < 0.5) discard_fragment();
      int row = int(-var.uv.x + 0.5) - 1;
      float4 mat = texture(u_material_atlas, var.uv);
      float3 albedo = texture(u_color_atlas, var.uv).rgb;
      float3 emission = float3(0.0);
      if (row >= 0) {
        float4 c0 = u_materialConstants.read(uint2(0, row));
        float4 c1 = u_materialConstants.read(uint2(1, row));
        emission = u_materialConstants.read(uint2(2, row)).rgb;
        mat = float4(c1.r, c1.g, c0.a, c1.b);
        albedo = c0.rgb;
      }
      if (var.vcolor.w > 0.5) albedo *= var.vcolor.rgb;
      if (mat.a > 0.0 || mat.b >= 0.98) discard_fragment();
      uint2 px = uint2(gl_FragCoord.xy);
      if (u_normal_texture.read(px).a >= 0.5 && var.posEye.z < u_position_texture.read(px).z - 1e-4 * abs(var.posEye.z)) discard_fragment();

      float3x3 invView = float3x3(
        float3(u_view[0][0], u_view[1][0], u_view[2][0]),
        float3(u_view[0][1], u_view[1][1], u_view[2][1]),
        float3(u_view[0][2], u_view[1][2], u_view[2][2])
      );
      float3 Ne = normalize(var.normalEye);
      float3 Ve = normalize(-var.posEye);
      bool back = dot(Ne, Ve) < 0.0;
      if (back) Ne = -Ne;
      float3 N = invView * Ne;
      float3 V = invView * Ve;
      float3 L = normalize(u_sunDirection.xyz);
      float NoV = saturate(dot(N, V));
      float alpha = saturate(mat.b);
      float roughness = max(mat.r * mat.r, 0.002);
      float f0 = pow((u_transparency.y - 1.0) / (u_transparency.y + 1.0), 2.0);
      float F = f0 + (1.0 - f0) * pow(1.0 - NoV, 5.0);

      float3 sun = u_sunOverride.w > 0.5 ? u_sunOverride.rgb : float3(3.0);
      float3 R = reflect(-V, N);
      float3 sky = mix(R, float3(R.x, R.z, -R.y), u_zUp);
      float3 reflection = u_prefiltered_texture.sample(u_prefiltered_texture_smp, sky, level(mat.r * 5.0)).rgb * u_iblEnabled * F;
      float3 H = normalize(V + L);
      float NoH = saturate(dot(N, H));
      float a2 = roughness * roughness;
      float d = NoH * NoH * (a2 - 1.0) + 1.0;
      float NoL = dot(N, L);
      reflection += sun * saturate(NoL) * F * a2 / (3.14159265 * d * d) * 0.25 / max(NoV * saturate(NoL), 0.05);

      float3 Ns = mix(N, float3(N.x, N.z, -N.y), u_zUp);
      float3 irradiance = u_irradiance_texture.sample(u_irradiance_texture_smp, Ns, level(0.0)).rgb * u_iblEnabled;
      float3 diffuse = albedo * (irradiance + sun / 3.14159265 * (saturate(NoL) + u_transparency.z * saturate(-NoL))) + emission;

      float depth = max(-var.posEye.z * u_transparency.x, 1e-3);
      float w = alpha * clamp(0.03 / (1e-5 + pow(depth / 200.0, 4.0)), 1e-2, 3e3);
      float3 transmit = (1.0 - alpha) * (1.0 - F) * mix(float3(1.0), albedo, saturate(1.0 - alpha));
      float3 refracted = refract(-Ve, Ne, 1.0 / u_transparency.y);
      float2 offset = (refracted.xy + Ve.xy) * (1.0 - alpha) * 2.0 * u_transparency.w / max(-var.posEye.z, 1e-4);
      float wo = (1.0 - alpha) * w + 1e-3;

      o_tColor_texture = float4(diffuse * alpha * w, alpha * w);
      o_tReflect_texture = float4(reflection * (1.0 - alpha * 0.5), 0.0);
      o_tTransmit_texture = float4(-log(max(transmit, float3(1e-4))), -log(max(1.0 - alpha, 1e-4)));
      o_tOffset_texture = float4(offset * wo, back ? -var.posEye.z : var.posEye.z, wo);
      o_tDepth_texture = float4(1.0 / max(-var.posEye.z, 1e-2), 1.0, 0.0, 0.0);
      float2 tMotion = (var.prevClip.xy / var.prevClip.w - var.currClip.xy / var.currClip.w) * 0.5;
      bool tUsable = var.prevClip.w > 1e-6 && all(isfinite(tMotion));
      float tCover = saturate(alpha + dot(emission, float3(0.1)));
      o_tVelocity_texture = float4((tUsable ? clamp(tMotion, float2(-1.0), float2(1.0)) : float2(0.0)) * tCover, 0.0, tCover);
    }
    ```

shader: transparent-composite
  uniforms: [ u_final_texture: sampler2d,
              u_tColor_texture: sampler2d,
              u_tReflect_texture: sampler2d,
              u_tTransmit_texture: sampler2d,
              u_tOffset_texture: sampler2d,
              u_tDepth_texture: sampler2d,
              u_position_texture: sampler2d,
              u_normal_texture: sampler2d,
              u_prefiltered_texture: samplerCube,
              u_proj: mat4,
              u_invProj: mat4,
              u_waterView: mat4,
              u_waterInvView: mat4,
              u_water: vec4,
              u_waterColor: vec4,
              u_waterBounds: vec4,
              u_waterWaves: vec4,
              u_sunDirection: vec4,
              u_sunOverride: vec4,
              u_iblEnabled: float,
              u_zUp: float ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    void main()
    {
      o_tResolved_texture = texelFetch(u_final_texture, ivec2(gl_FragCoord.xy), 0);
      o_tSurface_texture = vec4(0.0);
    }
    ```

    source msl:
    ```msl
    uint2 px = uint2(gl_FragCoord.xy);
    float2 size = float2(u_final_texture.get_width(), u_final_texture.get_height());
    float4 acc = u_tColor_texture.read(px);
    float4 refl = u_tReflect_texture.read(px);
    float4 tr = u_tTransmit_texture.read(px);
    float4 off = u_tOffset_texture.read(px);
    float4 tz = u_tDepth_texture.read(px);
    float3 color = u_final_texture.read(px).rgb;
    float4 surfaceOut = float4(0.0);
    if (!(acc.a <= 1e-6 && tr.a <= 1e-6 && dot(tr.rgb, float3(1.0)) <= 1e-6 && dot(refl.rgb, float3(1.0)) <= 1e-6)) {
      float2 uv = (gl_FragCoord.xy + float2(off.x, -off.y) / max(off.w, 1e-6) * max(off.z, 0.0) * size.y) / size;
      float3 background = u_final_texture.sample(u_final_texture_smp, clamp(uv, float2(0.0), float2(1.0)), level(0.0)).rgb;
      float coverage = 1.0 - exp(-tr.a);
      float3 surface = acc.rgb / max(acc.a, 1e-6) * coverage + refl.rgb;
      float3 through = background * exp(-tr.rgb);
      color = surface + through;
      float share = dot(surface, float3(0.2126, 0.7152, 0.0722)) / max(dot(color, float3(0.2126, 0.7152, 0.0722)), 1e-6);
      surfaceOut = float4(tz.x / max(tz.y, 1e-6), saturate(max(share, coverage)), 0.0, 1.0);
    }

    // The water plane: a ray against the sheet at u_water.x instead of a mesh
    // the near plane cuts, waves, reflection with a screen space march,
    // refraction with absorption over the depth below, and the view from under it.
    if (u_water.y > 0.5) {
      bool zUp = u_zUp > 0.5;
      float mpu = u_waterColor.w;
      float3 upW = zUp ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
      float2 baseUV = gl_FragCoord.xy / size;
      float4 gpos = u_position_texture.read(px);
      bool opaque = u_normal_texture.read(px).a >= 0.5;
      float4 e = u_invProj * float4(baseUV * 2.0 - 1.0, -1.0, 1.0);
      float3 dirEye = normalize(e.xyz / e.w);
      float3 camW = (u_waterInvView * float4(0.0, 0.0, 0.0, 1.0)).xyz;
      float3 dirW = normalize((u_waterInvView * float4(dirEye, 0.0)).xyz);
      float dOpaque = opaque ? length(gpos.xyz) : 1e30;
      float camH = dot(camW, upW), dirH = dot(dirW, upW);
      float t = abs(dirH) > 1e-6 ? (u_water.x - camH) / dirH : -1.0;
      bool under = camH < u_water.x;
      float3 hitW = camW + dirW * t;
      float2 hp = zUp ? hitW.xy : hitW.xz;
      bool inside = all(hp >= u_waterBounds.xy) && all(hp <= u_waterBounds.zw);
      // red goes within a few meters, blue green carries, by the water's own color.
      float3 absorb = (1.0 - u_waterColor.rgb) * 0.45 + float3(0.02, 0.01, 0.015);
      float3 skyAmbient = u_prefiltered_texture.sample(u_prefiltered_texture_smp, mix(upW, float3(upW.x, upW.z, -upW.y), u_zUp), level(6.0)).rgb * u_iblEnabled;
      float3 scatter = u_waterColor.rgb * skyAmbient * 0.06;
      float ior = u_water.z;
      float time = u_waterWaves.x;

      // summed waves, their slope in meters, fading to calm with distance so they don't alias.
      auto waveNormal = [&](float2 p, float distance) {
        const float4 waves[4] = { float4(1.0, 0.2, 7.0, 0.07), float4(0.6, 1.0, 3.1, 0.06),
                                  float4(-0.7, 0.5, 1.3, 0.05), float4(0.2, -1.0, 0.55, 0.035) };
        float2 g = float2(0.0);
        for (int i = 0; i < 4; ++i) {
          float2 d = normalize(waves[i].xy);
          float k = 6.2831853 / waves[i].z;
          float phase = k * dot(d, p) + time * sqrt(9.81 * k);
          g += d * waves[i].w * cos(phase);
        }
        g *= exp(-distance / 400.0);
        return zUp ? normalize(float3(-g.x, -g.y, 1.0)) : normalize(float3(-g.x, 1.0, -g.y));
      };
      auto environment = [&](float3 r, float rough) {
        return u_prefiltered_texture.sample(u_prefiltered_texture_smp, mix(r, float3(r.x, r.z, -r.y), u_zUp), level(rough * 5.0)).rgb * u_iblEnabled;
      };

      if (!under && inside && t > 0.0 && t < dOpaque) {
        float3 N = waveNormal(hp * mpu, t * mpu);
        float3 V = -dirW;
        float NoV = saturate(dot(N, V));
        float f0 = pow((ior - 1.0) / (ior + 1.0), 2.0);
        float F = f0 + (1.0 - f0) * pow(1.0 - NoV, 5.0);

        // what's under the surface, bent by its slope and dimmed by the depth it's seen through.
        float thickness = opaque ? (dOpaque - t) * mpu : 60.0;
        float2 tilt = (zUp ? N.xy : N.xz) * 0.04 * saturate(thickness * 0.5);
        float3 below = u_final_texture.sample(u_final_texture_smp, clamp(baseUV + tilt, float2(0.0), float2(1.0)), level(0.0)).rgb;
        float3 T = exp(-absorb * thickness);
        float3 refracted = below * T + scatter * (1.0 - T);

        // the reflection, marched against the scene in screen space before falling back to the sky.
        float3 R = reflect(dirW, N);
        R = normalize(R + upW * max(0.02 - dot(R, upW), 0.0));
        float rough = max(u_water.w, 0.02);
        float3 reflection = environment(R, rough);
        float s = 0.2 / mpu;
        for (int i = 0; i < 40; ++i) {
          float3 q = hitW + R * s;
          float4 qe = u_waterView * float4(q, 1.0);
          float4 qc = u_proj * qe;
          if (qc.w <= 1e-4) break;
          float2 quv = qc.xy / qc.w * 0.5 + 0.5;
          if (any(quv < float2(0.0)) || any(quv > float2(1.0))) break;
          uint2 qpx = uint2(quv * size);
          if (u_normal_texture.read(qpx).a >= 0.5) {
            float sceneZ = -u_position_texture.read(qpx).z, rayZ = -qe.z;
            if (rayZ > sceneZ && rayZ - sceneZ < s * 0.35 + 0.1 / mpu) {
              float2 edge = min(quv, 1.0 - quv);
              float fade = saturate(min(edge.x, edge.y) * 12.0);
              reflection = mix(reflection, u_final_texture.read(qpx).rgb, fade);
              break;
            }
          }
          s *= 1.18;
        }

        // the sun's glint off the waves.
        float3 L = normalize(u_sunDirection.xyz);
        float3 sun = u_sunOverride.w > 0.5 ? u_sunOverride.rgb : float3(3.0);
        float3 H = normalize(V + L);
        float a2 = pow(max(rough * rough, 0.002), 2.0);
        float NoH = saturate(dot(N, H)), NoL = saturate(dot(N, L));
        float D = a2 / (3.14159265 * pow(NoH * NoH * (a2 - 1.0) + 1.0, 2.0));
        float3 glint = sun * NoL * F * D * 0.25 / max(NoV * NoL, 0.05);

        color = mix(refracted, reflection, F) + glint;
        surfaceOut = float4(1.0 / max(t, 1e-2), 1.0, 0.0, 1.0);
      } else if (under) {
        // under water everything is seen through it, the surface from below through Snell's window.
        bool upward = t > 0.0 && t < dOpaque && inside;
        float path = upward ? t : min(dOpaque, 1e6);
        float3 seen = color;
        if (upward) {
          float3 N = waveNormal(hp * mpu, t * mpu);
          float3 out = refract(dirW, -N, ior);
          seen = dot(out, out) > 1e-6 ? environment(out, max(u_water.w, 0.02)) : scatter * 4.0;
        }
        float3 T = exp(-absorb * path * mpu);
        color = seen * T + scatter * (1.0 - T);
        surfaceOut = float4(1.0 / max(path, 1e-2), 1.0, 0.0, 1.0);
      }
    }
    o_tResolved_texture = float4(min(color, float3(60000.0)), 1.0);
    o_tSurface_texture = surfaceOut;
    ```

shader: taa-copy-transparent
