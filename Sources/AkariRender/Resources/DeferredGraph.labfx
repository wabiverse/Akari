  has depth: no
  textures:
    [ bloomUp3, f16x4, scale: 0.0625 ]

buffer: bloomUp4
  has depth: no
  textures:
    [ bloomUp4, f16x4, scale: 0.03125 ]

buffer: lensStreak
  has depth: no
  textures:
    [ lensStreakA, f16x4, scale: 0.25
