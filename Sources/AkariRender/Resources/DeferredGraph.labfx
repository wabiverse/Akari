shader: dof-tile-coc
  uniforms: [ u_dofDepth_texture: sampler2d,
              u_dof: vec4 ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
