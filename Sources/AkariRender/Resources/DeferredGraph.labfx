  fsh:
    source:
    ```glsl
    //@include Volume.glsl
    void main()
    {
      vec4 e = u_invProj * vec4(var.texCoord * 2.0 - 1.0, -1.0, 1.0);
      mat3 invView = transpose(mat3(u_view));
      vec3 eye = invView * -u_view[3].xyz;
      vec3 dir = normalize(invView * (e.xyz / e.w));
      ivec2 px = ivec2(gl_FragCoord.xy);
      float tMax = texelFetch(u_normal_texture, px, 0).a >= 0.5 ? length(texelFetch(u_position_texture, px, 0).xyz) : 1e30;
      float noise = fract(52.9829189 * fract(dot(gl_FragCoord.xy + 5.588238 * float(frameIndex % 64), vec2(0.06711056, 0.00583715))));
      vec3 sun = u_sunOverride.w > 0.5 ? u_sunOverride.rgb : vec3(3.0);
      vec3 up = mix(vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0), u_zUp);
      vec3 sky = texture(u_irradiance_texture, mix(up, vec3(up.x, up.z, -up.y), u_zUp)).rgb * u_iblEnabled;
      vec4 r = volumeMarch(u_volumeDensity, u_volumeShadow_texture, u_volumeTextureFromWorld, eye, dir, tMax, noise,
                           u_volumeParams, u_volumeAlbedo.rgb, normalize(u_volumeSun.xyz), sun, sky);
      if (r.w >= 0.9999) discard;
      o_final_texture = vec4(r.rgb / max(1.0 - r.w, 1e-4), 1.0 - r.w);
    }
    ```

    source msl:
    ```msl
    //@include Volume.msl
    //@include Atmosphere.msl
    //@main
    {
      float4 e = u_invProj * float4(var.texCoord * 2.0 - 1.0, -1.0, 1.0);
      float3x3 invView = float3x3(
        float3(u_view[0][0], u_view[1][0], u_view[2][0]),
        float3(u_view[0][1], u_view[1][1], u_view[2][1]),
        float3(u_view[0][2], u_view[1][2], u_view[2][2])
      );
      float3 eye = invView * -float3(u_view[3][0], u_view[3][1], u_view[3][2]);
      float3 dir = normalize(invView * (e.xyz / e.w));
      uint2 px = uint2(gl_FragCoord.xy);
      float tMax = u_normal_texture.read(px).a >= 0.5 ? length(u_position_texture.read(px).xyz) : 1e30;
      float noise = fract(volumeHash(int3(int2(gl_FragCoord.xy), 0)) + 0.6180339887 * float(frameIndex % 1024));
      float3 sun = u_sunOverride.w > 0.5 ? u_sunOverride.rgb : float3(3.0);
      float3 up = mix(float3(0.0, 1.0, 0.0), float3(0.0, 0.0, 1.0), u_zUp);
      float3 sky = texture(u_irradiance_texture, mix(up, float3(up.x, up.z, -up.y), u_zUp)).rgb * u_iblEnabled;
      float tFirst;
      float4 r = volumeMarch(u_volumeDensity, u_volumeDensity_smp, u_volumeShadow_texture, u_volumeShadow_texture_smp,
                             u_volumeTextureFromWorld, eye, dir, tMax, noise, u_volumeParams, u_volumeAlbedo.rgb,
                             normalize(u_volumeSun.xyz), sun, sky, u_pointLightData, int(u_pointLightCount), tFirst);
      if (r.w >= 0.9999) discard_fragment();
      float3 L = r.rgb;
      if (u_atmosphere.x > 0.5) {
        float2 screenUv = gl_FragCoord.xy / float2(u_normal_texture.get_width(), u_normal_texture.get_height());
        float4 aerial = atmosphereAerial(u_atmosAerial_texture, u_atmosAerial_texture_smp, screenUv,
                                         tFirst * u_atmosFrame.x, u_atmosphere.w);
        L = L * aerial.a + (1.0 - r.w) * aerial.rgb * u_atmosSun.rgb * u_atmosSun.w;
      }
      o_final_texture = float4(min(L / max(1.0 - r.w, 1e-4), float3(60000.0)), 1.0 - r.w);
    }
    ```

shader: motion-tile-8
  uniforms: [ u_tVelocity_texture: sampler2d,
              u_velocity_texture: sampler2d,
              u_normal_texture: sampler2d,
              u_view: mat4 <- auto-view-matrix,
              u_invProj: mat4,
              u_prevViewProj: mat4,
              u_currViewProj: mat4,
              u_motionBlur: vec4,
              u_motionSize: vec4 ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    //@include MotionBlur.glsl
    void main()
    {
      ivec2 gsize = textureSize(u_velocity_texture, 0);
      vec2 gscale = vec2(gsize) * u_motionSize.zw;
      ivec2 lo = ivec2(floor(floor(gl_FragCoord.xy) * 8.0 * gscale));
      ivec2 hi = min(ivec2(ceil((floor(gl_FragCoord.xy) + 1.0) * 8.0 * gscale)), gsize);
      vec2 best = vec2(0.0);
      for (int y = lo.y; y < hi.y; ++y)
        for (int x = lo.x; x < hi.x; ++x) {
          vec2 v = motionPixels(ivec2(x, y), u_velocity_texture, u_normal_texture, u_view, u_invProj,
                                u_prevViewProj, u_currViewProj, u_motionBlur, u_motionSize.xy);
          if (dot(v, v) > dot(best, best)) best = v;
        }
      o_motionTile8_texture = vec4(best, length(best), 0.0);
    }
    ```

    source msl:
    ```msl
    //@include MotionBlur.msl
    //@main
    {
      int2 gsize = int2(u_velocity_texture.get_width(), u_velocity_texture.get_height());
      float2 gscale = float2(gsize) * u_motionSize.zw;
      int2 lo = int2(floor(floor(gl_FragCoord.xy) * 8.0 * gscale));
      int2 hi = min(int2(ceil((floor(gl_FragCoord.xy) + 1.0) * 8.0 * gscale)), gsize);
      float2 best = float2(0.0);
      for (int y = lo.y; y < hi.y; ++y) {
        for (int x = lo.x; x < hi.x; ++x) {
          float2 v = motionPixels(int2(x, y), u_velocity_texture, u_normal_texture, u_tVelocity_texture, u_view, u_invProj,
                                  u_prevViewProj, u_currViewProj, u_motionBlur, u_motionSize.xy);
          if (dot(v, v) > dot(best, best)) best = v;
        }
      }
      o_motionTile8_texture = float4(best, length(best), 0.0);
    }
    ```

shader: motion-tile-max
  uniforms: [ u_motionTile8_texture: sampler2d,
              u_motionBlur: vec4,
              u_motionSize: vec4 ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
    ```msl
    var.texCoord = a_uv;
    gl_Position = float4(a_position, 1.0);
    ```

  fsh:
    source:
    ```glsl
    void main()
    {
      ivec2 size = textureSize(u_motionTile8_texture, 0);
      vec2 span = u_motionSize.xy / (8.0 * u_motionBlur.zw);
      ivec2 lo = ivec2(floor(floor(gl_FragCoord.xy) * span));
      ivec2 hi = min(ivec2(ceil((floor(gl_FragCoord.xy) + 1.0) * span)), size);
      vec2 best = vec2(0.0);
      for (int y = lo.y; y < hi.y; ++y)
        for (int x = lo.x; x < hi.x; ++x) {
          vec2 v = texelFetch(u_motionTile8_texture, ivec2(x, y), 0).xy;
          if (dot(v, v) > dot(best, best)) best = v;
        }
      o_motionTileMax_texture = vec4(best, length(best), 0.0);
    }
    ```

    source msl:
    ```msl
    int2 size = int2(u_motionTile8_texture.get_width(), u_motionTile8_texture.get_height());
    float2 span = u_motionSize.xy / (8.0 * u_motionBlur.zw);
    int2 lo = int2(floor(floor(gl_FragCoord.xy) * span));
    int2 hi = min(int2(ceil((floor(gl_FragCoord.xy) + 1.0) * span)), size);
    float2 best = float2(0.0);
    for (int y = lo.y; y < hi.y; ++y) {
      for (int x = lo.x; x < hi.x; ++x) {
        float2 v = u_motionTile8_texture.read(uint2(x, y)).xy;
        if (dot(v, v) > dot(best, best)) best = v;
      }
    }
    o_motionTileMax_texture = float4(best, length(best), 0.0);
    ```

shader: motion-neighbor-max
  uniforms: [ u_motionTileMax_texture: sampler2d ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
