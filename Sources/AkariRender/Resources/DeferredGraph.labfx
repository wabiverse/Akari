shader: ssgi-prep
  uniforms: [ u_position_texture: sampler2d,
              u_normal_texture: sampler2d,
              u_material_texture: sampler2d,
              u_history_texture: sampler2d,
              u_view: mat4 <- auto-view-matrix,
              u_prevViewProj: mat4,
              u_taa: vec4,
              u_ssgi: vec4 ]
  varying:  [ texCoord: vec2 ]

  vsh:
    attributes:
    [ a_position: vec3 <- position,
      a_uv: vec2 <- texcoord ]

    source:
    ```glsl
    void main()
    {
      var.texCoord = a_uv;
      gl_Position = vec4(a_position, 1.0);
    }
    ```

    source msl:
