#usda 1.0
(
    defaultPrim = "WoodenChair"
    doc = "A slat back chair with a linen seat cushion."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "WoodenChair" (
    assetInfo = {
        dictionary akari = {
            string catalog = "Furniture"
            string placement = "floor"
        }
        asset identifier = @./WoodenChair.usda@
        string name = "Wooden Chair"
        string version = "1"
    }
    kind = "component"
    variants = {
        string shadingVariant = "Walnut"
    }
    prepend variantSets = "shadingVariant"
)
{
    def Scope "Looks"
    {
        def Material "Walnut"
        {
            token outputs:surface.connect = </WoodenChair/Looks/Walnut/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </WoodenChair/Looks/Walnut/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/walnut.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </WoodenChair/Looks/Walnut/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Oak"
        {
            token outputs:surface.connect = </WoodenChair/Looks/Oak/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </WoodenChair/Looks/Oak/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/oak.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </WoodenChair/Looks/Oak/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Linen"
        {
            token outputs:surface.connect = </WoodenChair/Looks/Linen/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.74, 0.66)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

