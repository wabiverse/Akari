#usda 1.0
(
    defaultPrim = "Materials"
    doc = "The sample material library, one material per prim with its catalog in assetInfo."
    metersPerUnit = 1
    upAxis = "Y"
)

def Scope "Materials"
{
    def Material "Oak" (
        assetInfo = {
            dictionary akari = {
                string catalog = "Materials/Wood"
            }
            string name = "Oak"
        }
    )
    {
        token outputs:surface.connect = </Materials/Oak/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Materials/Oak/Texture.outputs:rgb>
            float inputs:metallic = 0
            float inputs:roughness = 0.55
            token outputs:surface
        }

        def Shader "Texture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/oak.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Materials/Oak/Reader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "Reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }

