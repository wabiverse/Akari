#usda 1.0
(
    defaultPrim = "PictureFrame"
    doc = "A wall hung picture frame, its back on the wall and its front along +Z."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "PictureFrame" (
    assetInfo = {
        dictionary akari = {
            string catalog = "Picture Frames"
            string placement = "wall"
        }
        asset identifier = @./PictureFrame.usda@
        string name = "Picture Frame"
        string version = "1"
    }
    kind = "component"
    variants = {
        string shadingVariant = "Walnut"
    }
    prepend variantSets = "shadingVariant"
)
{
    def Scope "Looks"
    {
        def Material "Walnut"
        {
            token outputs:surface.connect = </PictureFrame/Looks/Walnut/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </PictureFrame/Looks/Walnut/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/walnut.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </PictureFrame/Looks/Walnut/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Brass"
        {
            token outputs:surface.connect = </PictureFrame/Looks/Brass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.7, 0.36)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "PaintedTeal"
        {
            token outputs:surface.connect = </PictureFrame/Looks/PaintedTeal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.3, 0.3)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }

