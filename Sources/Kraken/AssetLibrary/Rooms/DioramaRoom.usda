#usda 1.0
(
    defaultPrim = "DioramaRoom"
    doc = "A two meter cube room on a dark plate, teal plaster and concrete walls under dark wood beams, a basketweave floor and a glazed window."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "DioramaRoom" (
    assetInfo = {
        dictionary akari = {
            string catalog = "Rooms"
            string placement = "floor"
        }
        asset identifier = @./DioramaRoom.usda@
        string name = "Diorama Room"
        string version = "1"
    }
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "GroundPlate"
        {
            token outputs:surface.connect = </DioramaRoom/Looks/GroundPlate/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.042, 0.042, 0.042)
                float inputs:metallic = 0
                float inputs:roughness = 0.81
                token outputs:surface
            }
        }

        def Material "Boards"
        {
            token outputs:surface.connect = </DioramaRoom/Looks/Boards/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DioramaRoom/Looks/Boards/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/boards_basketweave.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DioramaRoom/Looks/Boards/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "PlasterTeal"
        {
            token outputs:surface.connect = </DioramaRoom/Looks/PlasterTeal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DioramaRoom/Looks/PlasterTeal/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/plaster_teal.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DioramaRoom/Looks/PlasterTeal/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Concrete"
        {
            token outputs:surface.connect = </DioramaRoom/Looks/Concrete/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DioramaRoom/Looks/Concrete/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/concrete.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DioramaRoom/Looks/Concrete/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "DarkWood"
        {
            token outputs:surface.connect = </DioramaRoom/Looks/DarkWood/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DioramaRoom/Looks/DarkWood/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../Materials/textures/dark_wood.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DioramaRoom/Looks/DarkWood/Reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "WindowWhite"
        {
            token outputs:surface.connect = </DioramaRoom/Looks/WindowWhite/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.88, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </DioramaRoom/Looks/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:metallic = 0
                float inputs:roughness = 0.02
                float inputs:ior = 1.5
                    float inputs:opacity = 0.05
                token outputs:surface
            }
        }
    }

