#usda 1.0
(
    customLayerData = {
        dictionary colorManagement = {
            double exposure = 0
            string viewTransform = "sRGB"
        }
    }
    defaultPrim = "Studio"
    doc = "A middle gray cyclorama sweep with a soft key, a fill and a rim light, a neutral catalog look for any material."
    metersPerUnit = 1
    upAxis = "Z"
)

